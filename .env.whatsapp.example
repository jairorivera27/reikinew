# WhatsApp Cloud API + bot Reiki
WHATSAPP_VERIFY_TOKEN=reiki-wa-2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_PHONE=573245737413
# Número personal para alertas al escalar a humano (preferido)
PERSONAL_PHONE_NUMBER=573245737413
WHATSAPP_SITE_URL=https://reikisolar.com.co
CALLMEBOT_API_KEY=

# Atención personalizada (ingeniero / comprobantes). Distinto del bot 300…
ATTENTION_WHATSAPP=573245737413

# Claude (cerebro del bot) — ANTHROPIC_API_KEY la creas tú en Anthropic
ANTHROPIC_API_KEY=
# Default: claude-sonnet-5 · alternativa más barata: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI solo para transcribir audios (Whisper). Sin ella, el bot pide texto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pausar el bot tras derivar a humano (horas)
HUMAN_MODE_HOURS=12

# Horario hábil (America/Bogota). Días: 1=lun … 7=dom
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
BUSINESS_DAYS=1,2,3,4,5,6

# Upstash Redis / Vercel KV — token de ESCRITURA vía env de Vercel
# (no pegues tokens en el chat). Obligatorio en producción:
#   KV_REST_API_URL + KV_REST_API_TOKEN
# KV_REST_API_READ_ONLY_TOKEN no sirve (sesiones, locks, historial).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativa Upstash directa:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Leads → Google Sheets (Apps Script) u otro webhook. POST JSON.
LEADS_WEBHOOK_URL=
