{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/whatsapp-webhook.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "{data/whatsapp-product-index.json,config/empresa.json,data/reiki-knowledge.md}"
    },
    "api/cotizacion-pdf.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "config/empresa.json"
    },
    "api/cotizacion-web.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "config/empresa.json"
    },
    "api/cotizacion-download.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "config/empresa.json"
    }
  },
  "rewrites": [
    {
      "source": "/cotizacion/:id.pdf",
      "destination": "/api/cotizacion-download?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/servicios/energia-solar",
      "destination": "/servicios/energia-solar-residencial",
      "permanent": true
    },
    {
      "source": "/servicios/meditacion-guiada",
      "destination": "/servicios/energia-solar-empresas",
      "permanent": true
    },
    {
      "source": "/servicios/reiki-tradicional",
      "destination": "/servicios/bombeo-solar",
      "permanent": true
    },
    {
      "source": "/servicios/limpieza-energetica",
      "destination": "/servicios/energia-solar-movil",
      "permanent": true
    },
    {
      "source": "/tienda/categoria/monitoreo-medicion",
      "destination": "/tienda/categoria/accesorios",
      "permanent": true
    },
    {
      "source": "/tienda/categoria/monitoreo-medicion/(.*)",
      "destination": "/tienda/categoria/accesorios/$1",
      "permanent": true
    },
    {
      "source": "/tienda/categoria/cargadores-para-carro",
      "destination": "/tienda/categoria/accesorios",
      "permanent": true
    },
    {
      "source": "/tienda/categoria/cargadores-para-carro/(.*)",
      "destination": "/tienda/categoria/accesorios/$1",
      "permanent": true
    }
  ]
}
