---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ShoppingCartDrawer from '../components/ShoppingCartDrawer.astro';
import CartFloatButton from '../components/CartFloatButton.astro';
import SEO from '../components/SEO.astro';
import FontAwesome from '../components/FontAwesome.astro';
/** Vacío aquí ⇒ en el navegador no hay llave: en Vercel define PUBLIC_WOMPI_KEY antes del build y redeploy. */
const rawWompiKey = import.meta.env.PUBLIC_WOMPI_KEY;
let wompiPublicKey = '';
if (typeof rawWompiKey === 'string') {
  wompiPublicKey = rawWompiKey.replace(/^['"]|['"]$/g, '').trim();
}
if (!wompiPublicKey || wompiPublicKey === 'undefined') {
  wompiPublicKey = '';
}
/** Misma raíz que `site` en astro.config (evita www vs apex y pérdida de ?id= en redirects). */
const siteOrigin = String(import.meta.env.SITE || 'https://reikisolar.com.co').replace(/\/+$/, '');
const wompiRedirectUrl = `${siteOrigin}/respuesta-pago`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {wompiPublicKey ? <meta name="reiki-wompi-public-key" content={wompiPublicKey} /> : null}
    <title>Checkout | Carrito | Reiki Energía Solar</title>
    <FontAwesome />
    <SEO
      title="Checkout | Carrito de compras | Reiki Energía Solar"
      description="Finaliza tu compra de equipos solares. Pago con Wompi (tarjeta, PSE, Nequi…) o Addi (cuotas)."
      canonical="/carrito"
      keywords="checkout, carrito, pago Wompi, Addi, energía solar Colombia"
      schemaType="WebPage"
    />
    <!-- widget.js se carga al confirmar el pago (evita init temprano de Wompi v1 con config vacía y reduce choque con bloqueadores). -->
  </head>
  <body
    class="checkout-page-body"
    data-reiki-wompi-public-key={wompiPublicKey}
    data-wompi-key={wompiPublicKey}
  >
    <Header />

    <main class="checkout-main">
      <div class="checkout-container">
        <header class="checkout-page-header">
          <h1 class="checkout-title">Finalizar compra</h1>
          <p class="checkout-lead">
            Completa tus datos de envío y elige cómo quieres pagar. La pasarela (Wompi) y Addi se conectarán en el siguiente
            paso.
          </p>
          <div id="cotizacion-banner" class="checkout-cot-banner" hidden role="status"></div>
        </header>

        <div id="checkout-loading" class="checkout-loading" aria-live="polite">
          <span class="checkout-loading-dot" aria-hidden="true"></span>
          Cargando tu carrito…
        </div>

        <div id="checkout-empty" class="checkout-empty" hidden>
          <div class="checkout-empty-card">
            <i class="fas fa-shopping-bag" aria-hidden="true"></i>
            <h2>Tu carrito está vacío</h2>
            <p>Agrega productos desde la tienda para continuar con el pago.</p>
            <a href="/tienda" class="checkout-btn-primary">Ir a la tienda</a>
          </div>
        </div>

        <div id="checkout-active" class="checkout-active" hidden>
          <div class="checkout-columns">
            <div class="checkout-col checkout-col--form">
              <form
                id="checkout-form"
                class="checkout-form"
                novalidate
                data-wompi-key={wompiPublicKey}
                data-reiki-wompi-public-key={wompiPublicKey}
              >
                <section class="checkout-card" aria-labelledby="step-shipping-title">
                  <div class="checkout-step-badge">1</div>
                  <h2 id="step-shipping-title" class="checkout-card-title">Datos de envío</h2>
                  <p class="checkout-card-desc">Usaremos esta información para coordinar entrega y facturación.</p>

                  <div class="checkout-field-grid">
                    <label class="checkout-field checkout-field--full">
                      <span class="checkout-label">Nombre completo <abbr title="requerido">*</abbr></span>
                      <input
                        type="text"
                        name="fullName"
                        autocomplete="name"
                        required
                        placeholder="Nombre y apellidos"
                        class="checkout-input"
                      />
                    </label>
                    <label class="checkout-field">
                      <span class="checkout-label">Email <abbr title="requerido">*</abbr></span>
                      <input
                        type="email"
                        name="email"
                        autocomplete="email"
                        required
                        placeholder="tu@correo.com"
                        class="checkout-input"
                      />
                    </label>
                    <label class="checkout-field">
                      <span class="checkout-label">Teléfono <abbr title="requerido">*</abbr></span>
                      <input
                        type="tel"
                        name="phone"
                        autocomplete="tel"
                        required
                        placeholder="Ej: 300 123 4567"
                        class="checkout-input"
                      />
                    </label>
                    <label class="checkout-field">
                      <span class="checkout-label">Cédula (CC) <abbr title="requerido para Addi">*</abbr></span>
                      <input
                        type="text"
                        name="idNumber"
                        inputmode="numeric"
                        autocomplete="off"
                        required
                        placeholder="Número de cédula"
                        class="checkout-input"
                        pattern="[0-9]{5,20}"
                        title="Solo números, sin puntos ni espacios"
                      />
                    </label>
                    <label class="checkout-field checkout-field--full">
                      <span class="checkout-label">Dirección completa <abbr title="requerido">*</abbr></span>
                      <input
                        type="text"
                        name="addressLine"
                        autocomplete="street-address"
                        required
                        placeholder="Calle, número, barrio, referencias"
                        class="checkout-input"
                      />
                    </label>
                    <label class="checkout-field">
                      <span class="checkout-label">Ciudad <abbr title="requerido">*</abbr></span>
                      <input type="text" name="city" autocomplete="address-level2" required placeholder="Ciudad" class="checkout-input" />
                    </label>
                    <label class="checkout-field">
                      <span class="checkout-label">Departamento <abbr title="requerido">*</abbr></span>
                      <select name="department" required class="checkout-input checkout-select">
                        <option value="">Selecciona…</option>
                        <option value="Amazonas">Amazonas</option>
                        <option value="Antioquia">Antioquia</option>
                        <option value="Arauca">Arauca</option>
                        <option value="Atlántico">Atlántico</option>
                        <option value="Bolívar">Bolívar</option>
                        <option value="Boyacá">Boyacá</option>
                        <option value="Caldas">Caldas</option>
                        <option value="Caquetá">Caquetá</option>
                        <option value="Casanare">Casanare</option>
                        <option value="Cauca">Cauca</option>
                        <option value="Cesar">Cesar</option>
                        <option value="Chocó">Chocó</option>
                        <option value="Córdoba">Córdoba</option>
                        <option value="Cundinamarca">Cundinamarca</option>
                        <option value="Guainía">Guainía</option>
                        <option value="Guaviare">Guaviare</option>
                        <option value="Huila">Huila</option>
                        <option value="La Guajira">La Guajira</option>
                        <option value="Magdalena">Magdalena</option>
                        <option value="Meta">Meta</option>
                        <option value="Nariño">Nariño</option>
                        <option value="Norte de Santander">Norte de Santander</option>
                        <option value="Putumayo">Putumayo</option>
                        <option value="Quindío">Quindío</option>
                        <option value="Risaralda">Risaralda</option>
                        <option value="San Andrés y Providencia">San Andrés y Providencia</option>
                        <option value="Santander">Santander</option>
                        <option value="Sucre">Sucre</option>
                        <option value="Tolima">Tolima</option>
                        <option value="Valle del Cauca">Valle del Cauca</option>
                        <option value="Vaupés">Vaupés</option>
                        <option value="Vichada">Vichada</option>
                      </select>
                    </label>
                    <label class="checkout-field">
                      <span class="checkout-label">Código postal</span>
                      <input type="text" name="zip" autocomplete="postal-code" placeholder="Ej: 050001" class="checkout-input" inputmode="numeric" />
                    </label>
                  </div>
                </section>

                <section class="checkout-card checkout-card--payments" aria-labelledby="step-payment-title">
                  <div class="checkout-step-badge">2</div>
                  <h2 id="step-payment-title" class="checkout-card-title">Pago seguro</h2>
                  <p class="checkout-card-desc">
                    Elige cómo quieres pagar: Wompi (tarjeta, PSE, Nequi…) o Addi (compra ahora y paga a cuotas).
                  </p>

                  <fieldset class="checkout-pay-methods">
                    <legend class="sr-only">Método de pago</legend>
                    <label class="checkout-pay-option">
                      <input type="radio" name="paymentMethod" value="wompi" checked />
                      <span class="checkout-pay-option-body">
                        <img src="/images/Wompi_LogoPrincipal.jpg" alt="" class="checkout-pay-logo checkout-pay-logo--wompi" />
                        <span>
                          <strong>Wompi</strong>
                          <small>Tarjeta, PSE, Nequi, Bancolombia…</small>
                        </span>
                      </span>
                    </label>
                    <label class="checkout-pay-option">
                      <input type="radio" name="paymentMethod" value="addi" />
                      <span class="checkout-pay-option-body">
                        <img src="/images/Addi.png" alt="" class="checkout-pay-logo checkout-pay-logo--addi" />
                        <span>
                          <strong>Addi</strong>
                          <small>Paga a cuotas sin tarjeta de crédito</small>
                        </span>
                      </span>
                    </label>
                  </fieldset>

                  <img
                    src="/images/Pasarale de pago.png"
                    alt="Medios de pago disponibles"
                    class="checkout-payment-gateway-image"
                    loading="lazy"
                    decoding="async"
                    id="checkout-wompi-methods-img"
                  />

                  <p class="checkout-integration-note" role="note">
                    <i class="fas fa-plug" aria-hidden="true"></i>
                    Al finalizar te redirigimos a la pasarela elegida para completar el pago de forma segura.
                  </p>

                  <div class="checkout-legal-consent">
                    <input type="checkbox" id="aceptar-terminos" name="aceptarTerminos" required class="checkout-legal-checkbox" />
                    <label for="aceptar-terminos" class="checkout-legal-label">
                      He leído y acepto la
                      <a href="/politica-privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a>
                      y los
                      <a href="/terminos-condiciones" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>
                    </label>
                  </div>

                  <button type="submit" class="checkout-submit-btn" id="checkout-submit">
                    <i class="fas fa-lock" aria-hidden="true"></i>
                    Ir al Pago Seguro
                  </button>

                  <div class="checkout-trust-block">
                    <p class="checkout-trust-text">
                      <i class="fas fa-shield-halved" aria-hidden="true"></i>
                      Pago 100% seguro con Wompi o Addi
                    </p>
                  </div>
                </section>
              </form>
            </div>

            <aside class="checkout-col checkout-col--summary">
              <div class="checkout-summary-card">
                <h2 class="checkout-summary-title">Resumen del pedido</h2>
                <div id="checkout-lines" class="checkout-lines"></div>

                <div class="checkout-summary-breakdown">
                  <div class="checkout-breakdown-row">
                    <span>Subtotal excluido de IVA</span>
                    <span id="checkout-excluido">$0</span>
                  </div>
                  <div class="checkout-breakdown-row">
                    <span>Subtotal gravado (base)</span>
                    <span id="checkout-base">$0</span>
                  </div>
                  <div class="checkout-breakdown-row">
                    <span>IVA 19 %</span>
                    <span id="checkout-iva">$0</span>
                  </div>
                  <div class="checkout-breakdown-row checkout-breakdown-row--muted">
                    <span>Envío</span>
                    <span class="checkout-shipping-note">Se calculará en el pago o contra entrega</span>
                  </div>
                  <div class="checkout-breakdown-row checkout-breakdown-row--total">
                    <span>Total</span>
                    <span id="checkout-total">$0</span>
                  </div>
                  <p class="checkout-iva-note" style="font-size:0.75rem;color:#666;margin:0.5rem 0 0;line-height:1.35;">
                    Paneles e inversores excluidos de IVA (Ley 1715 de 2014). Los demás productos incluyen IVA del 19 %.
                  </p>
                </div>

                <a href="/tienda" class="checkout-back-link">
                  <i class="fas fa-arrow-left" aria-hidden="true"></i>
                  Seguir comprando
                </a>

                <button type="button" id="btn-descargar-cotizacion" class="checkout-pdf-btn">
                  <i class="fas fa-file-pdf" aria-hidden="true"></i>
                  Descargar cotización en PDF
                </button>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </main>

    <div id="cotizacion-pdf-modal" class="cot-pdf-modal" hidden>
      <div class="cot-pdf-modal-card" role="dialog" aria-labelledby="cot-pdf-title">
        <button type="button" class="cot-pdf-modal-close" id="cot-pdf-close" aria-label="Cerrar">&times;</button>
        <h2 id="cot-pdf-title">Descargar cotización PDF</h2>
        <p class="cot-pdf-lead">Completa tus datos para generar el PDF con precios de tu carrito.</p>
        <form id="cotizacion-pdf-form" class="cot-pdf-form">
          <label>Nombre completo <abbr title="requerido">*</abbr>
            <input name="nombre" required maxlength="80" autocomplete="name" />
          </label>
          <label>Ciudad <abbr title="requerido">*</abbr>
            <input name="ciudad" required maxlength="80" autocomplete="address-level2" />
          </label>
          <label>Celular <abbr title="requerido">*</abbr>
            <input name="celular" type="tel" required placeholder="300 123 4567" autocomplete="tel" />
          </label>
          <label>Correo (opcional)
            <input name="correo" type="email" autocomplete="email" />
          </label>
          <label class="cot-pdf-check">
            <input type="checkbox" name="autorizacion" required />
            <span>Autorizo el tratamiento de mis datos según la
              <a href="/politica-privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
          </label>
          <button type="submit" class="checkout-submit-btn" id="cot-pdf-submit">
            Generar y descargar PDF
          </button>
          <p id="cot-pdf-status" class="cot-pdf-status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <Footer />
    <ShoppingCartDrawer />
    <WhatsAppFloat />
    <CartFloatButton />

    <div id="checkout-pay-toast" class="checkout-pay-toast" role="status" aria-live="polite" aria-atomic="true" hidden></div>

<script define:vars={{ wompiPublicKey, wompiRedirectUrl }}>
  (function () {
    var CART_KEY = 'reiki_cart';
    var COT_META_KEY = 'reiki_cotizacion_meta';
    var wompiKeyFromBuild =
      typeof wompiPublicKey === 'string' && wompiPublicKey.trim() ? wompiPublicKey.trim() : '';
    var wompiKeyLooksValid = /^pub_(prod|test)_[A-Za-z0-9_-]+$/.test(wompiKeyFromBuild);
    if (!wompiKeyLooksValid) {
      console.error('FALTA LLAVE WOMPI');
    }

    function extractPrice(priceString) {
      var cleaned = String(priceString || '').replace(/[^0-9]/g, '');
      return parseInt(cleaned, 10) || 0;
    }

    function formatPrice(n) {
      return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        minimumFractionDigits: 0,
      }).format(n);
    }

    function escHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    }

    function dispatchCartBadge() {
      try {
        var raw = localStorage.getItem(CART_KEY);
        var cart = raw ? JSON.parse(raw) : [];
        var total = Array.isArray(cart) ? cart.reduce(function (sum, item) {
          return sum + (parseInt(item.quantity, 10) || 0);
        }, 0) : 0;
        window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { totalItems: total } }));
      } catch (_e) {}
    }

    function loadCart() {
      try {
        var raw = localStorage.getItem(CART_KEY);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch (_e) {
        return [];
      }
    }

    function saveCart(cart) {
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
      dispatchCartBadge();
      window.dispatchEvent(new CustomEvent('reiki-cart-storage-changed'));
    }

    function computeCartTotalCop(cart) {
      var n = cart.reduce(function (sum, item) {
        return sum + extractPrice(item.price) * (parseInt(item.quantity, 10) || 1);
      }, 0);
      return Math.max(0, Math.round(n));
    }

    /** Referencia única para la pasarela (UUID cuando el navegador lo soporta). */
    function generatePaymentReference() {
      var meta = null;
      try {
        meta = JSON.parse(sessionStorage.getItem(COT_META_KEY) || 'null');
      } catch (_e) {
        meta = null;
      }
      var suffix =
        typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
          ? crypto.randomUUID().replace(/-/g, '').slice(0, 12)
          : Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
      if (meta && meta.id) {
        var ref = 'cot-' + meta.id + '-' + suffix;
        try {
          fetch('/api/cotizacion-web?action=link_ref', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: meta.id, reference: ref }),
          }).catch(function () {});
        } catch (_e2) {}
        return ref;
      }
      if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
        return crypto.randomUUID();
      }
      return 'reiki-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
    }

    /** Carga /carrito?cot=&t= (precios congelados o aviso si venció) */
    async function loadCotizacionFromQuery() {
      var params = new URLSearchParams(window.location.search);
      var cotId = params.get('cot');
      var token = params.get('t');
      if (!cotId || !token) return;

      try {
        var res = await fetch(
          '/api/cotizacion-web?id=' + encodeURIComponent(cotId) + '&t=' + encodeURIComponent(token)
        );
        var data = await res.json();
        if (!data || !data.ok || data.invalid) {
          // Token inválido → carrito normal sin error visible
          return;
        }
        sessionStorage.setItem(
          COT_META_KEY,
          JSON.stringify({ id: data.id, numero: data.numero, token: data.token, vencida: data.vencida })
        );
        if (Array.isArray(data.items) && data.items.length) {
          localStorage.setItem(CART_KEY, JSON.stringify(data.items));
          try {
            window.dispatchEvent(new CustomEvent('reiki-cart-storage-changed'));
          } catch (_e) {}
        }
        var banner = document.getElementById('cotizacion-banner');
        if (banner) {
          banner.hidden = false;
          if (data.vencida) {
            banner.className = 'checkout-cot-banner checkout-cot-banner--warn';
            banner.textContent =
              'Esta cotización venció; los precios pueden haber cambiado. Se cargaron precios actuales del catálogo.';
          } else {
            banner.className = 'checkout-cot-banner';
            banner.textContent =
              'Cotización ' + data.numero + ' cargada con precios congelados. Puedes pagar con Wompi o Addi.';
          }
        }
        // Prefill cliente si viene en la cotización
        if (data.cliente) {
          var form = document.getElementById('checkout-form');
          if (form) {
            if (data.cliente.nombre && form.fullName) form.fullName.value = data.cliente.nombre;
            if (data.cliente.correo && form.email) form.email.value = data.cliente.correo;
            if (data.cliente.celular && form.phone) form.phone.value = data.cliente.celular;
            if (data.cliente.ciudad && form.city) form.city.value = data.cliente.ciudad;
          }
        }
      } catch (err) {
        console.warn('[carrito] cot load', err);
      }
    }

    function showCheckoutToast(message) {
      var toast = document.getElementById('checkout-pay-toast');
      if (!(toast instanceof HTMLElement)) {
        window.alert(message);
        return;
      }
      toast.textContent = message;
      toast.removeAttribute('hidden');
      toast.classList.add('checkout-pay-toast--visible');
      toast.setAttribute('aria-hidden', 'false');
      window.clearTimeout(showCheckoutToast._t);
      showCheckoutToast._t = window.setTimeout(function () {
        toast.classList.remove('checkout-pay-toast--visible');
        toast.setAttribute('aria-hidden', 'true');
        toast.setAttribute('hidden', '');
      }, 4200);
    }

    /**
     * Espera a que checkout.wompi.co deje disponible window.WidgetCheckout (orden de scripts, red lenta, extensión).
     * @returns {Promise<void>}
     */
    function ensureWompiReady() {
      if (!wompiKeyLooksValid) {
        return Promise.reject(new Error('WOMPI_KEY_MISSING'));
      }
      if (typeof window.WidgetCheckout === 'function') {
        return Promise.resolve();
      }
      var src = 'https://checkout.wompi.co/widget.js';
      return new Promise(function (resolve, reject) {
        var settled = false;
        var pollId = 0;
        var deadlineId = 0;
        function cleanup() {
          if (pollId) window.clearInterval(pollId);
          if (deadlineId) window.clearTimeout(deadlineId);
        }
        function succeed() {
          if (settled) return;
          if (typeof window.WidgetCheckout !== 'function') return;
          settled = true;
          cleanup();
          resolve();
        }
        function fail(code) {
          if (settled) return;
          settled = true;
          cleanup();
          reject(new Error(code));
        }
        if (typeof window.WidgetCheckout === 'function') {
          succeed();
          return;
        }
        var existing = null;
        var list = document.getElementsByTagName('script');
        for (var i = 0; i < list.length; i++) {
          var u = list[i].src || '';
          if (u.indexOf('checkout.wompi.co/widget.js') !== -1) {
            existing = list[i];
            break;
          }
        }
        deadlineId = window.setTimeout(function () {
          if (typeof window.WidgetCheckout === 'function') succeed();
          else fail('WOMPI_TIMEOUT');
        }, 20000);
        if (existing) {
          pollId = window.setInterval(function () {
            if (typeof window.WidgetCheckout === 'function') succeed();
          }, 40);
          existing.addEventListener(
            'load',
            function () {
              if (typeof window.WidgetCheckout === 'function') succeed();
            },
            { once: true }
          );
          existing.addEventListener(
            'error',
            function () {
              fail('WOMPI_SCRIPT_ERROR');
            },
            { once: true }
          );
          return;
        }
        var s = document.createElement('script');
        s.src = src;
        s.async = false;
        s.onload = function () {
          if (typeof window.WidgetCheckout === 'function') succeed();
          else fail('WOMPI_NO_GLOBAL');
        };
        s.onerror = function () {
          fail('WOMPI_SCRIPT_ERROR');
        };
        document.head.appendChild(s);
      });
    }

    /**
     * Crea solicitud Addi y redirige al checkout BNPL.
     */
    async function openAddiCheckout(form) {
      var fd = new FormData(form);
      var cart = loadCart();
      if (!cart.length) {
        showCheckoutToast('Tu carrito está vacío.');
        return {};
      }

      var totalCop = computeCartTotalCop(cart);
      if (totalCop < 1000) {
        showCheckoutToast('El total a pagar no es válido.');
        return {};
      }

      var idNumber = String(fd.get('idNumber') || '').replace(/\D/g, '');
      if (idNumber.length < 5) {
        showCheckoutToast('Ingresa tu cédula para pagar con Addi.');
        return {};
      }

      var orderId = generatePaymentReference();
      var email = String(fd.get('email') || '').trim();
      var fullName = String(fd.get('fullName') || '').trim();
      var phone = String(fd.get('phone') || '').trim();
      var addressLine = String(fd.get('addressLine') || '').trim();
      var city = String(fd.get('city') || '').trim();

      try {
        localStorage.setItem(
          'reiki_checkout_customer',
          JSON.stringify({
            fullName: fullName,
            email: email,
            phone: phone,
            idNumber: idNumber,
            addressLine: addressLine,
            city: city,
            department: String(fd.get('department') || ''),
            zip: String(fd.get('zip') || ''),
            gateway: 'addi',
            orderId: orderId,
          })
        );
        localStorage.setItem('reiki_checkout_reference', orderId);
      } catch (_e) {}

      showCheckoutToast('Abriendo Addi (pago a cuotas)…');

      var items = cart.map(function (item) {
        var unitCop = extractPrice(item.price);
        var qty = parseInt(item.quantity, 10) || 1;
        return {
          sku: item.id || item.slug || item.title,
          name: item.title,
          quantity: qty,
          unitPrice: unitCop,
          pictureUrl: item.image
            ? item.image.indexOf('http') === 0
              ? item.image
              : 'https://reikisolar.com.co' + (item.image.charAt(0) === '/' ? item.image : '/' + item.image)
            : 'https://reikisolar.com.co/images/Addi.png',
          category: item.category || 'energia-solar',
          brand: item.brand || 'Reiki Solar',
        };
      });

      try {
        var res = await fetch('/api/addi-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: orderId,
            totalAmount: totalCop,
            shippingAmount: 0,
            items: items,
            client: {
              fullName: fullName,
              email: email,
              phone: phone,
              idNumber: idNumber,
              idType: 'CC',
            },
            shippingAddress: {
              lineOne: addressLine,
              city: city,
            },
          }),
        });
        var json = await res.json().catch(function () {
          return {};
        });
        if (!res.ok || !json.redirectUrl) {
          console.error('[checkout] Addi', res.status, json);
          showCheckoutToast(
            json.error ||
              'No se pudo abrir Addi. Verifica ADDI_CLIENT_ID / ADDI_CLIENT_SECRET o intenta con Wompi.'
          );
          return {};
        }
        window.location.href = String(json.redirectUrl);
        return json;
      } catch (err) {
        console.error('[checkout] Addi fetch', err);
        showCheckoutToast('No se pudo contactar Addi. Intenta de nuevo o paga con Wompi.');
        return {};
      }
    }

    /**
     * Construye los datos del checkout y abre el widget de Wompi.
     * @returns {Promise<object>}
     */
    async function openWompiCheckout(form, wompiKey) {
      var fd = new FormData(form);
      /** @type {ReturnType<loadCart>} */
      var cart = loadCart();
      if (!cart.length) {
        showCheckoutToast('Tu carrito está vacío.');
        return {};
      }

      var totalCop = computeCartTotalCop(cart);
      var totalEnCentavos = totalCop * 100;
      var aceptarTerminos = Boolean(fd.get('aceptarTerminos'));
      var emailDelFormulario = String(fd.get('email') || '').trim();
      var nombreDelFormulario = String(fd.get('fullName') || '').trim();
      var telefonoDelFormulario = String(fd.get('phone') || '').trim().replace(/\s+/g, '');
      var referenciaUnica = generatePaymentReference();

      if (totalEnCentavos < 1) {
        showCheckoutToast('El total a pagar no es válido. Revisa los productos en tu carrito.');
        return {};
      }

      try {
        await ensureWompiReady();
      } catch (wompiErr) {
        console.error('[checkout] Wompi', wompiErr);
        showCheckoutToast(
          'No se pudo cargar Wompi. Revisa tu conexión, prueba otro navegador o desactiva bloqueadores (p. ej. de anuncios) e intenta de nuevo.'
        );
        return {};
      }
      if (typeof window.WidgetCheckout !== 'function') {
        showCheckoutToast('No se pudo cargar Wompi. Verifica tu conexión e intenta de nuevo.');
        return {};
      }
      if (!wompiKey || String(wompiKey).trim() === '' || String(wompiKey).trim() === 'undefined') {
        showCheckoutToast(
          'Falta la llave pública de Wompi. En el hosting (ej. Vercel) define PUBLIC_WOMPI_KEY con tu pub_prod_… antes del build y haz un nuevo despliegue.'
        );
        return {};
      }
      wompiKey = String(wompiKey).trim();
      if (!isPlausibleWompiPublicKey(wompiKey)) {
        console.error('[checkout] Llave Wompi con formato inválido (esperado pub_prod_… o pub_test_…).');
        showCheckoutToast(
          'La llave pública de Wompi no es válida. Revisa PUBLIC_WOMPI_KEY en Vercel (sin espacios ni comillas) y vuelve a desplegar.'
        );
        return {};
      }

      var integrityHex = '';
      try {
        var sigRes = await fetch('/api/wompi-integrity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            reference: referenciaUnica,
            amountInCents: totalEnCentavos,
            currency: 'COP',
          }),
        });
        var sigJson = await sigRes.json().catch(function () {
          return {};
        });
        if (!sigRes.ok || !sigJson.integrity) {
          console.error('[checkout] Firma Wompi', sigRes.status, sigJson);
          showCheckoutToast(
            sigJson.error ||
              'No se pudo preparar el pago seguro (firma Wompi). Configura WOMPI_INTEGRITY_SECRET en el servidor o en .env para desarrollo.'
          );
          return {};
        }
        integrityHex = String(sigJson.integrity);
      } catch (sigErr) {
        console.error('[checkout] Firma Wompi fetch', sigErr);
        showCheckoutToast('No se pudo contactar el servidor de firma de pagos. Intenta de nuevo.');
        return {};
      }

      var items = cart.map(function (item) {
        var unitCop = extractPrice(item.price);
        var qty = parseInt(item.quantity, 10) || 1;
        return {
          id: item.id,
          title: item.title,
          description: item.description || '',
          quantity: qty,
          unitPriceDisplayed: item.price,
          unitAmountMinorUnitsCop: unitCop,
          lineAmountMinorUnitsCop: unitCop * qty,
          brand: item.brand || undefined,
          model: item.model || undefined,
          image: item.image || '',
        };
      });

      var payload = {
        referencePayment: referenciaUnica,
        createdAt: new Date().toISOString(),
        currency: 'COP',
        totals: {
          amountInCents: totalEnCentavos,
          amountDisplayedCopFormatted: formatPrice(totalCop),
        },
        customer: {
          fullName: nombreDelFormulario,
          email: emailDelFormulario,
          phone: telefonoDelFormulario,
        },
        shipping: {
          addressLine: String(fd.get('addressLine') || '').trim(),
          city: String(fd.get('city') || '').trim(),
          department: String(fd.get('department') || '').trim(),
          zip: String(fd.get('zip') || '').trim() || undefined,
        },
        legal: {
          acceptedTerms: aceptarTerminos,
          acceptedAt: aceptarTerminos ? new Date().toISOString() : null,
        },
        cart: {
          storageKey: CART_KEY,
          items: items,
        },
      };

      console.log('[checkout] processCheckout payload', payload);
      console.log('[checkout] payload JSON:', JSON.stringify(payload, null, 2));

      var checkoutConfig = {
        currency: 'COP',
        amountInCents: totalEnCentavos,
        reference: referenciaUnica,
        publicKey: wompiKey,
        redirectUrl: typeof wompiRedirectUrl === 'string' && wompiRedirectUrl.trim() ? wompiRedirectUrl.trim() : '/respuesta-pago',
        customerData: {
          email: emailDelFormulario,
          fullName: nombreDelFormulario,
          phoneNumber: telefonoDelFormulario,
          phoneNumberPrefix: '+57',
        },
      };
      checkoutConfig['signature:integrity'] = integrityHex;

      var checkout = new window.WidgetCheckout(checkoutConfig);

      try {
        try {
          localStorage.setItem(
            'reiki_checkout_customer',
            JSON.stringify({
              fullName: nombreDelFormulario,
              email: emailDelFormulario,
              phone: telefonoDelFormulario,
              addressLine: String(fd.get('addressLine') || '').trim(),
              city: String(fd.get('city') || '').trim(),
              department: String(fd.get('department') || '').trim(),
              zip: String(fd.get('zip') || '').trim(),
            })
          );
          localStorage.setItem('reiki_checkout_reference', referenciaUnica);
        } catch (_lsErr) {
          /* opcional para EmailJS tras redirect */
        }

        checkout.open(function (result) {
          var transaction = result && result.transaction ? result.transaction : null;
          if (!transaction) {
            console.warn(
              '[checkout] Wompi: sin objeto transaction (cierre sin pago, error de red o bloqueador). ERR_BLOCKED_BY_CLIENT en la consola suele indicar extensión bloqueando api.wompi.co.',
              result
            );
            return;
          }
          console.log('Transacción terminada', transaction.status, transaction);
          var txStatus = String(transaction.status || '').toUpperCase();
          var txId = String(transaction.id || '').trim();
          if (txStatus === 'APPROVED' && txId) {
            var targetBase =
              typeof wompiRedirectUrl === 'string' && wompiRedirectUrl.trim()
                ? wompiRedirectUrl.trim()
                : '/respuesta-pago';
            var glue = targetBase.indexOf('?') === -1 ? '?' : '&';
            var finalUrl = targetBase + glue + 'id=' + encodeURIComponent(txId);
            console.info('[checkout] Redirección post-pago (fallback local):', finalUrl);
            window.location.assign(finalUrl);
          }
        });
      } catch (openErr) {
        console.error('[checkout] WidgetCheckout.open', openErr);
        showCheckoutToast('No se pudo abrir la pasarela de pago. Revisa la consola o intenta de nuevo.');
        return {};
      }

      showCheckoutToast('Abriendo pasarela de pago segura de Wompi…');
      return payload;
    }

    /** @type {HTMLElement | null} */
    var loadingEl = document.getElementById('checkout-loading');
    var emptyEl = document.getElementById('checkout-empty');
    var activeEl = document.getElementById('checkout-active');
    var linesEl = document.getElementById('checkout-lines');
    var excluidoEl = document.getElementById('checkout-excluido');
    var baseEl = document.getElementById('checkout-base');
    var ivaEl = document.getElementById('checkout-iva');
    var totalEl = document.getElementById('checkout-total');

    function renderLines() {
      if (!linesEl) return;
      var cart = loadCart();
      if (cart.length === 0) {
        linesEl.innerHTML = '';
        return;
      }

      linesEl.innerHTML = cart
        .map(function (item, index) {
          var unit = extractPrice(item.price);
          var lineTotal = unit * item.quantity;
          var imgSrc = String(item.image || '').replace(/"/g, '&quot;');
          return (
            '<article class="checkout-line" data-index="' +
            index +
            '">' +
            '<div class="checkout-line-media">' +
            '<img src="' +
            imgSrc +
            '" alt="' +
            escHtml(item.title || '') +
            '" class="checkout-line-img" loading="lazy" width="72" height="72" />' +
            '</div>' +
            '<div class="checkout-line-info">' +
            '<h3 class="checkout-line-name">' +
            escHtml(item.title || 'Producto') +
            '</h3>' +
            (item.brand ? '<p class="checkout-line-brand">' + escHtml(item.brand) + '</p>' : '') +
            '<p class="checkout-line-unit">' +
            escHtml(item.price) +
            '</p>' +
            '<div class="checkout-line-controls">' +
            '<button type="button" class="checkout-qty-btn" data-checkout-qty="' +
            index +
            '" data-dir="-1" aria-label="Disminuir cantidad">−</button>' +
            '<span class="checkout-qty-val" aria-live="polite">' +
            item.quantity +
            '</span>' +
            '<button type="button" class="checkout-qty-btn" data-checkout-qty="' +
            index +
            '" data-dir="1" aria-label="Aumentar cantidad">+</button>' +
            '</div>' +
            '</div>' +
            '<div class="checkout-line-sub">' +
            '<span class="checkout-line-sub-label">Subtotal</span>' +
            '<span class="checkout-line-sub-amt">' +
            formatPrice(lineTotal) +
            '</span>' +
            '<button type="button" class="checkout-line-remove" data-checkout-remove="' +
            index +
            '" aria-label="Quitar del carrito"><i class="fas fa-trash" aria-hidden="true"></i></button>' +
            '</div>' +
            '</article>'
          );
        })
        .join('');

      /** @type {NodeListOf<HTMLButtonElement>} */
      var qtyBtns = linesEl.querySelectorAll('[data-checkout-qty]');
      qtyBtns.forEach(function (btn) {
        btn.onclick = function () {
          var idx = parseInt(btn.getAttribute('data-checkout-qty') || '0', 10);
          var dir = parseInt(btn.getAttribute('data-dir') || '0', 10);
          updateQty(idx, dir);
        };
      });
      linesEl.querySelectorAll('[data-checkout-remove]').forEach(function (btn) {
        btn.onclick = function () {
          var idx = parseInt(btn.getAttribute('data-checkout-remove') || '0', 10);
          removeLine(idx);
        };
      });
    }

    function updateTotals(cart) {
      var IVA_RATE = 0.19;
      var IVA_EXCLUIDAS = ['paneles', 'inversores'];
      function normIva(s) {
        return String(s || '')
          .normalize('NFD')
          .replace(/\p{M}/gu, '')
          .toLowerCase()
          .trim();
      }
      function isExcluidoIva(item) {
        if (item && item.excluidoIva === true) return true;
        if (item && item.excluidoIva === false) return false;
        var cat = normIva(item && (item.categoria || item.category));
        var name = normIva(item && (item.nombre || item.title));
        for (var i = 0; i < IVA_EXCLUIDAS.length; i++) {
          var ex = IVA_EXCLUIDAS[i];
          if (cat === ex || cat.indexOf(ex) !== -1 || (cat && ex.indexOf(cat) !== -1)) return true;
        }
        if (/\bmicroinversor|microinverter|micro-inversor\b/.test(name)) return true;
        if (/\binversor(es)?\b/.test(name)) return true;
        if (/\bpanel(es)?\b/.test(name) && !/\b(protector|proteccion|estructura|cable|conector|cargador)\b/.test(name)) {
          return true;
        }
        return false;
      }
      var excluido = 0;
      var baseGravada = 0;
      var iva = 0;
      var gravadoConIva = 0;
      for (var j = 0; j < cart.length; j++) {
        var item = cart[j];
        var unit = Math.round(extractPrice(item.price) || 0);
        var line = unit * (item.quantity || 1);
        if (isExcluidoIva(item)) {
          excluido += line;
        } else {
          gravadoConIva += line;
          var baseLine = Math.round(line / (1 + IVA_RATE));
          baseGravada += baseLine;
          iva += line - baseLine;
        }
      }
      var total = Math.round(excluido + gravadoConIva);
      if (excluidoEl) excluidoEl.textContent = formatPrice(excluido);
      if (baseEl) baseEl.textContent = formatPrice(baseGravada);
      if (ivaEl) ivaEl.textContent = formatPrice(iva);
      if (totalEl) totalEl.textContent = formatPrice(total);
    }

    function updateQty(index, delta) {
      var cart = loadCart();
      if (!cart[index]) return;
      cart[index].quantity += delta;
      if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
      }
      saveCart(cart);
      afterCartChange();
    }

    function removeLine(index) {
      var cart = loadCart();
      cart.splice(index, 1);
      saveCart(cart);
      afterCartChange();
    }

    function afterCartChange() {
      var cart = loadCart();
      if (cart.length === 0) {
        showEmpty();
        return;
      }
      renderLines();
      updateTotals(cart);
    }

    function showEmpty() {
      if (loadingEl) loadingEl.hidden = true;
      if (activeEl) activeEl.hidden = true;
      if (emptyEl) emptyEl.hidden = false;
    }

    function showCheckout() {
      if (loadingEl) loadingEl.hidden = true;
      if (emptyEl) emptyEl.hidden = true;
      if (activeEl) activeEl.hidden = false;
      var cart = loadCart();
      renderLines();
      updateTotals(cart);
    }

    function initView() {
      var cart = loadCart();
      if (loadingEl) loadingEl.hidden = true;
      if (cart.length === 0) {
        showEmpty();
      } else {
        showCheckout();
      }
    }

    /** Re-sincronizar si el carrito cambia en otra pestaña */
    window.addEventListener('storage', function (e) {
      if (e.key !== CART_KEY) return;
      if (loadCart().length === 0) showEmpty();
      else showCheckout();
    });

    function isPlausibleWompiPublicKey(k) {
      return /^pub_(prod|test)_[A-Za-z0-9_-]+$/.test(String(k || '').trim());
    }

    function resolveStoredWompiKey() {
      var b = document.body;
      if (b instanceof HTMLElement) {
        var fromBody = (
          b.getAttribute('data-reiki-wompi-public-key') ||
          b.getAttribute('data-wompi-key') ||
          ''
        ).trim();
        if (fromBody && fromBody !== 'undefined') return fromBody;
      }
      var fromDom = '';
      var formEl = document.getElementById('checkout-form');
      if (formEl instanceof HTMLFormElement) {
        fromDom = (
          formEl.getAttribute('data-reiki-wompi-public-key') ||
          formEl.getAttribute('data-wompi-key') ||
          ''
        ).trim();
      }
      if (fromDom && fromDom !== 'undefined') return fromDom;
      if (typeof wompiPublicKey === 'string' && wompiPublicKey.trim() && wompiPublicKey !== 'undefined') {
        return wompiPublicKey.trim();
      }
      var metaPk = document.querySelector('meta[name="reiki-wompi-public-key"]');
      if (metaPk instanceof HTMLMetaElement) {
        var c = (metaPk.getAttribute('content') || '').trim();
        if (c && c !== 'undefined') return c;
      }
      return '';
    }

    var checkoutForm = document.getElementById('checkout-form');
    var submitBtn = document.getElementById('checkout-submit');
    var aceptarTerminosEl = document.getElementById('aceptar-terminos');

    if (checkoutForm instanceof HTMLFormElement) {
      checkoutForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var methodEl = checkoutForm.querySelector('input[name="paymentMethod"]:checked');
        var paymentMethod = methodEl ? String(methodEl.value) : 'wompi';

        if (aceptarTerminosEl instanceof HTMLInputElement && !aceptarTerminosEl.checked) {
          showCheckoutToast('Debes aceptar los Términos y Condiciones para continuar con tu compra');
          aceptarTerminosEl.focus();
          return;
        }
        if (!checkoutForm.checkValidity()) {
          checkoutForm.reportValidity();
          return;
        }
        if (loadCart().length === 0) {
          showCheckoutToast('Tu carrito está vacío.');
          return;
        }

        var btn = submitBtn instanceof HTMLButtonElement ? submitBtn : null;
        if (btn) btn.disabled = true;
        try {
          if (paymentMethod === 'addi') {
            await openAddiCheckout(checkoutForm);
            return;
          }

          var activeWompiKey = resolveStoredWompiKey();
          if (!activeWompiKey) {
            console.error('Error: PUBLIC_WOMPI_KEY no está en el build (p. ej. falta en Vercel al compilar).');
            showCheckoutToast(
              'Falta la llave pública de Wompi en el sitio. En Vercel: Settings → Environment Variables → agrega PUBLIC_WOMPI_KEY (tu pub_prod_…) para Production y vuelve a desplegar el proyecto.'
            );
            return;
          }
          if (!isPlausibleWompiPublicKey(activeWompiKey)) {
            console.error('[checkout] PUBLIC_WOMPI_KEY no tiene formato pub_prod_… / pub_test_…');
            showCheckoutToast(
              'La llave Wompi del sitio no es válida. Corrige PUBLIC_WOMPI_KEY en Vercel y redespliega.'
            );
            return;
          }
          await openWompiCheckout(checkoutForm, activeWompiKey);
        } catch (err) {
          console.error('[checkout]', err);
          showCheckoutToast('No se pudo preparar el pago. Intenta de nuevo.');
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    }

    function openCotPdfModal() {
      var modal = document.getElementById('cotizacion-pdf-modal');
      if (modal) modal.hidden = false;
    }
    function closeCotPdfModal() {
      var modal = document.getElementById('cotizacion-pdf-modal');
      if (modal) modal.hidden = true;
    }

    async function submitCotPdfForm(ev) {
      ev.preventDefault();
      var form = ev.target;
      var status = document.getElementById('cot-pdf-status');
      var btn = document.getElementById('cot-pdf-submit');
      var cart = loadCart();
      if (!cart.length) {
        if (status) status.textContent = 'Tu carrito está vacío.';
        return;
      }
      var fd = new FormData(form);
      if (!fd.get('autorizacion')) {
        if (status) status.textContent = 'Debes autorizar el tratamiento de datos.';
        return;
      }
      if (btn) btn.disabled = true;
      if (status) status.textContent = 'Generando PDF…';
      try {
        var res = await fetch('/api/cotizacion-web', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre: fd.get('nombre'),
            ciudad: fd.get('ciudad'),
            celular: fd.get('celular'),
            correo: fd.get('correo'),
            autorizacion: true,
            items: cart,
          }),
        });
        var data = await res.json();
        if (!data.ok) {
          if (status) status.textContent = 'No se pudo generar. Revisa los datos e intenta de nuevo.';
          return;
        }
        sessionStorage.setItem(
          COT_META_KEY,
          JSON.stringify({ id: data.id, numero: data.numero, token: data.token })
        );
        if (status) status.textContent = 'Listo: ' + data.numero + '. Descargando…';
        window.location.href = data.pdfUrl;
      } catch (err) {
        console.error(err);
        if (status) status.textContent = 'Error de red al generar el PDF.';
      } finally {
        if (btn) btn.disabled = false;
      }
    }

    function wireCotPdfUi() {
      var openBtn = document.getElementById('btn-descargar-cotizacion');
      var closeBtn = document.getElementById('cot-pdf-close');
      var modal = document.getElementById('cotizacion-pdf-modal');
      var form = document.getElementById('cotizacion-pdf-form');
      if (openBtn) openBtn.addEventListener('click', openCotPdfModal);
      if (closeBtn) closeBtn.addEventListener('click', closeCotPdfModal);
      if (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal) closeCotPdfModal();
        });
      }
      if (form) form.addEventListener('submit', submitCotPdfForm);
      if (window.location.hash === '#pdf') openCotPdfModal();
    }

    async function bootCheckoutUi() {
      await loadCotizacionFromQuery();
      initView();
      wireCotPdfUi();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootCheckoutUi);
    } else {
      bootCheckoutUi();
    }

    window.checkoutReloadFromCart = function () {
      if (loadCart().length === 0) showEmpty();
      else showCheckout();
    };
  })();
</script>

<style is:global>
  html {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  body.checkout-page-body {
    margin: 0;
    background: #f4f6f9;
    color: #1f2937;
  }

  body.checkout-page-body .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
