        function htmlAlegra(e) {
          var f = e.factura || {};
          var cuerpo;
          if (f.numero) {
            cuerpo =
              '<p class="al-ok"><i class="fas fa-check-circle" aria-hidden="true"></i> Factura <b>' +
              esc(f.numero) +
              '</b> emitida' +
              (f.alegraPagoId ? ' y pago registrado en Alegra' : '') +
              '.</p>' +
              (f.alegraUrl ? '<a class="btn btn-ghost seg-mini" href="' + esc(f.alegraUrl) + '" target="_blank" rel="noopener">Ver en Alegra</a>' : '');
          } else if (!st.meta.alegraConfigurado) {
            cuerpo =
              '<p class="seg-warn">Alegra aún no está conectado al panel. Agrega <b>ALEGRA_EMAIL</b> y <b>ALEGRA_TOKEN</b> en Vercel (Alegra → Configuración → API) y haz Redeploy.</p>';
          } else if (f.alegraId) {
            cuerpo =
              '<p>Prefactura en <b>borrador</b> en Alegra (sin emitir' +
              (f.alegraTotal ? ', ' + cop(f.alegraTotal) : '') +
              '). Revísala y dale <b>Emitir</b> en Alegra; luego vuelve aquí.</p><div class="modal-actions">' +
              '<a class="btn btn-primary seg-mini" href="' +
              esc(f.alegraUrl) +
              '" target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> Abrir prefactura en Alegra</a>' +
              '<button type="button" class="btn btn-secondary seg-mini" data-alegra-sync>Ya la emití: actualizar</button></div>';
          } else {
            var faltan = [];
            if (!(e.cliente && e.cliente.documento)) faltan.push('cédula o NIT');
            if (!(e.cliente && e.cliente.direccion)) faltan.push('dirección');
            if (!(e.cliente && /,/.test(e.cliente.ciudad || ''))) faltan.push('ciudad con departamento (ej. "La Macarena, Meta")');
            if (!(e.items || []).length) faltan.push('ítems');
            cuerpo =
              '<p>Crea la factura en Alegra como <b>borrador</b> con el cliente, los ítems, el IVA de cada línea y el total de la venta. No se emite a la DIAN hasta que tú le des Emitir en Alegra.</p>' +
              (faltan.length
                ? '<p class="seg-warn">Para crear la factura falta: <b>' +
                  esc(faltan.join(', ')) +
                  '</b>. Complétalo abajo en "Cliente, envío y factura" y guarda.</p>'
                : '') +
              '<div class="modal-actions"><button type="button" class="btn btn-primary seg-mini" data-alegra-borrador' +
              (faltan.length ? ' disabled' : '') +
              '><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i> Preparar factura en Alegra</button></div>';
          }
          return '<section class="modal-block al-block"><h3>Factura en Alegra</h3>' + cuerpo + '<p class="seg-warn" id="al-err" hidden></p></section>';
        }

        function msg(t) {
          var m = $('seg-modal-msg');
          if (m) m.textContent = t || '';
        }

        async function run(op, body) {
          msg('Guardando…');
          try {
            var j = await api(op, body);
            upsert(j.expediente);
            render();
            openDetail(j.expediente.id);
          } catch (err) {
            msg('No se pudo guardar: ' + err.message);
          }
        }

        function bindDetail(e) {
          el.body.querySelectorAll('[data-etapa]').forEach(function (s) {
            s.addEventListener('change', function () {
              var key = s.getAttribute('data-etapa');
              var note = el.body.querySelector('[data-note="' + key + '"]');
              run('etapa', { id: e.id, key: key, estado: s.value, nota: note ? note.value : undefined });
            });
          });
          el.body.querySelectorAll('[data-note]').forEach(function (inp) {
            inp.addEventListener('change', function () {
              run('etapa', { id: e.id, key: inp.getAttribute('data-note'), nota: inp.value });
            });
          });
          el.body.querySelectorAll('[data-fecha]').forEach(function (inp) {
            inp.addEventListener('change', function () {
              run('etapa', { id: e.id, key: inp.getAttribute('data-fecha'), fechaCliente: inp.value });
            });
          });
          el.body.querySelectorAll('[data-reenviar]').forEach(function (b) {
            b.addEventListener('click', function () {
              run('correo', { id: e.id, key: b.getAttribute('data-reenviar') });
            });
          });
          var ca = $('seg-correos-activos');
          if (ca)
            ca.addEventListener('change', function () {
              run('save', { id: e.id, correosActivos: ca.checked });
            });
          var ab = el.body.querySelector('[data-alegra-borrador]');
          if (ab)
            ab.addEventListener('click', async function () {
              var w = window.open('', '_blank');
              msg('Creando la prefactura en Alegra…');
              ab.disabled = true;
              try {
                var j = await api('alegra-borrador', { id: e.id });
                upsert(j.expediente);
                render();
                openDetail(e.id);
                var b = j.borrador;
                msg(
                  'Prefactura creada en borrador' +
                    (b && Math.abs(b.diferencia) > 2 ? '. OJO: el total en Alegra difiere ' + cop(b.diferencia) + ' del de la venta; revísalo.' : '.')
                );
                if (w) w.location.href = j.url;
                else window.open(j.url, '_blank');
              } catch (err) {
                if (w) w.close();
                ab.disabled = false;
                msg('');
                var ae = $('al-err');
                if (ae) {
                  ae.hidden = false;
                  ae.textContent = 'No se pudo crear en Alegra: ' + err.message;
                  ae.scrollIntoView({ block: 'nearest' });
                }
              }
            });
          var as = el.body.querySelector('[data-alegra-sync]');
          if (as)
            as.addEventListener('click', async function () {
              msg('Consultando Alegra…');
              try {
                var j = await api('alegra-sync', { id: e.id });
                upsert(j.expediente);
                render();
                openDetail(e.id);
                msg(
                  j.factura && j.factura.emitida
                    ? 'Factura ' + j.factura.numero + ' registrada. Se cerró la etapa y se avisó al cliente.' + (j.pago ? ' Pago registrado en Alegra.' : '')
                    : 'En Alegra la factura sigue en borrador. Emítela allá y vuelve a intentar.'
                );
              } catch (err) {
                msg('No se pudo consultar Alegra: ' + err.message);
              }
            });
          el.body.querySelectorAll('[data-verificar]').forEach(function (b) {
            b.addEventListener('click', function () {
              var p = (e.pagos || []).find(function (x) {
                return x.id === b.getAttribute('data-verificar');
              });
              if (p) run('pago', { id: e.id, pago: Object.assign({}, p, { estado: 'verificado' }) });
            });
          });
          var pf = $('seg-pago-form');
          pf.addEventListener('submit', function (ev) {
            ev.preventDefault();
            var f = new FormData(pf);
            run('pago', {
              id: e.id,
              pago: {
                monto: f.get('monto'),
                fecha: f.get('fecha'),
                medio: f.get('medio'),
                referencia: f.get('referencia'),
                estado: f.get('verificado') ? 'verificado' : 'por_verificar',
              },
            });
          });
          el.body.querySelectorAll('[data-item-prov],[data-item-costo]').forEach(function (inp) {
            inp.addEventListener('change', function () {
              var items = (e.items || []).map(function (it, i) {
                var n = el.body.querySelector('[data-item-prov="' + i + '"]');
                var c = el.body.querySelector('[data-item-costo="' + i + '"]');
                return Object.assign({}, it, {
                  proveedor: n ? n.value : it.proveedor,
                  costoUnit: c ? Number(c.value) || 0 : it.costoUnit,
                });
              });
              run('save', { id: e.id, items: items });
            });
          });
          var df = $('seg-datos-form');
          df.addEventListener('submit', function (ev) {
            ev.preventDefault();
            var f = new FormData(df);
            run('save', {
              id: e.id,
              total: f.get('total'),
              costosAdicionales: f.get('costosAdicionales'),
              notas: f.get('notas'),
              cliente: {
                nombre: f.get('c_nombre'),
                documento: f.get('c_documento'),
                correo: f.get('c_correo'),
                celular: f.get('c_celular'),
                ciudad: f.get('c_ciudad'),
                direccion: f.get('c_direccion'),
              },
              envio: { transportadora: f.get('e_transportadora'), guia: f.get('e_guia') },
              factura: { numero: f.get('f_numero') },
            });
          });
          el.body.querySelectorAll('[data-estado]').forEach(function (b) {
            b.addEventListener('click', function () {
              run('save', { id: e.id, estado: b.getAttribute('data-estado') });
            });
          });
        }

        function parseItems(txt) {
          return String(txt || '')
            .split('\n')
            .map(function (line) {
              var p = line.split('|').map(function (x) {
                return x.trim();
              });
              if (!p[0]) return null;
              if (p.length === 1) return { cantidad: 1, nombre: p[0] };
              return {
                cantidad: Number(p[0]) || 1,
                nombre: p[1] || '',
                precioUnit: Number(String(p[2] || '').replace(/[^\d]/g, '')) || 0,
                proveedor: p[3] || '',
              };
            })
            .filter(Boolean);
        }

        function openNuevo() {
          st.openId = null;
          el.body.innerHTML =
            '<p class="modal-kicker">Nueva venta aprobada</p><h2 id="seg-modal-title">' +
            (st.cat === 'proyecto' ? 'Nuevo proyecto' : 'Nueva compra en tienda') +
            '</h2>' +
            '<form id="seg-nuevo-form" class="modal-block"><div class="seg-form-grid">' +
            '<label class="seg-field"><span>Tipo</span><select name="tipo"><option value="tienda"' +
            (st.cat !== 'proyecto' ? ' selected' : '') +
            '>Compra en tienda</option><option value="proyecto"' +
            (st.cat === 'proyecto' ? ' selected' : '') +
            '>Proyecto (instalación)</option></select></label>' +
            field('titulo', 'Nombre del expediente', '') +
            field('cot', 'N.º de cotización', '') +
            field('total', 'Valor total', '', 'number') +
            field('condiciones', 'Condiciones de pago (ej. 60/30/10)', '') +
            field('c_nombre', 'Cliente', '') +
            field('c_documento', 'Cédula / NIT', '') +
            field('c_correo', 'Correo', '', 'email') +
            field('c_celular', 'Celular', '') +
            field('c_ciudad', 'Ciudad', '') +
            '</div><label class="seg-field seg-field--full"><span>Equipos — uno por línea: cantidad | equipo | precio unitario | proveedor (opcional)</span><textarea name="items" rows="4" placeholder="2 | Panel JA Solar 625 W | 450355"></textarea></label>' +
            '<div class="modal-actions"><button class="btn btn-primary" type="submit">Crear expediente</button></div></form><p id="seg-modal-msg" class="dash-status"></p>';
          el.modal.hidden = false;
          var nf = $('seg-nuevo-form');
          nf.addEventListener('submit', async function (ev) {
            ev.preventDefault();
            var f = new FormData(nf);
            msg('Creando…');
            try {
              var j = await api('save', {
                tipo: f.get('tipo'),
                titulo: f.get('titulo') || f.get('c_nombre'),
                cotizacion: { numero: f.get('cot') },
                total: f.get('total'),
                condicionesPago: f.get('condiciones'),
                cliente: {
                  nombre: f.get('c_nombre'),
                  documento: f.get('c_documento'),
                  correo: f.get('c_correo'),
                  celular: f.get('c_celular'),
                  ciudad: f.get('c_ciudad'),
                },
                items: parseItems(f.get('items')),
              });
              upsert(j.expediente);
              setCat(j.expediente.tipo);
              openDetail(j.expediente.id);
            } catch (err) {
              msg('No se pudo crear: ' + err.message);
            }
          });
        }

        function closeModal() {
          el.modal.hidden = true;
          st.openId = null;
        }

        function setCat(cat) {
          st.cat = cat;
          document.querySelectorAll('.cat-tab').forEach(function (b) {
            b.classList.toggle('is-active', b.getAttribute('data-cat') === cat);
            b.setAttribute('aria-selected', b.getAttribute('data-cat') === cat ? 'true' : 'false');
          });
          el.paneWeb.hidden = cat !== 'web';
          el.paneSeg.hidden = cat !== 'tienda' && cat !== 'proyecto';
          $('pane-inicio').hidden = cat !== 'inicio';
          $('pane-compras').hidden = cat !== 'compras';
          $('pane-cotizaciones').hidden = cat !== 'cotizaciones';
          $('pane-desempeno').hidden = cat !== 'desempeno';
          if (cat === 'tienda' || cat === 'proyecto') render();
          if (window.reikiPanes && window.reikiPanes[cat]) window.reikiPanes[cat]();
          if (cat === 'desempeno') loadDesempeno();
          try {
            window.scrollTo({ top: 0, behavior: 'instant' });
          } catch (_e) {
            /* nada */
          }
        }

        document.querySelectorAll('.cat-tab').forEach(function (b) {
          b.addEventListener('click', function () {
            setCat(b.getAttribute('data-cat'));
          });
        });
        el.q.addEventListener('input', function () {
          st.q = el.q.value || '';
          render();
        });
        el.fEstado.addEventListener('change', function () {
          st.estado = el.fEstado.value;
          render();
        });
        $('seg-nuevo').addEventListener('click', openNuevo);
        el.modal.addEventListener('click', function (ev) {
          if (ev.target && ev.target.getAttribute('data-seg-close')) closeModal();
        });
        document.addEventListener('keydown', function (ev) {
          if (ev.key === 'Escape' && !el.modal.hidden) closeModal();
        });
        var btnRefresh = $('btn-refresh');
        if (btnRefresh)
          btnRefresh.addEventListener('click', function () {
            load();
            if (window.reikiPanes && window.reikiPanes[st.cat]) window.reikiPanes[st.cat]();
            if (st.cat === 'desempeno') loadDesempeno();
          });

        var EQ_TXT = {};
        function chip(estado, txt) {
          var cls = { por_pedir: 'bad', pedido: 'amber', comprado: 'amber', en_camino: 'amber', en_obra: 'ok', entregado: 'ok', instalado: 'ok' }[estado] || '';
          return '<span class="oc-badge oc-badge--' + cls + '">' + esc(txt || estado) + '</span>';
        }
        function mesTxt(m) {
          var p = String(m).split('-');
          var n = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'][Number(p[1]) - 1] || '';
          return n + ' ' + String(p[0]).slice(2);
        }
        function barras(filas, series) {
          var max = 1;
          filas.forEach(function (f) {
            series.forEach(function (s) {
              max = Math.max(max, Number(f[s.k]) || 0);
            });
          });
          if (max === 1 && !filas.some(function (f) { return series.some(function (s) { return Number(f[s.k]) > 0; }); }))
            return '<p class="notes-empty">Aún no hay movimientos en estos meses. Se irá llenando a medida que se registren ventas aprobadas en el panel y pedidos web pagados.</p>';
          return (
            '<div class="de-bars">' +
            filas
              .map(function (f) {
                var vacio = !series.some(function (s) {
                  return Number(f[s.k]) > 0;
                });
                if (vacio) return '<div class="de-row"><span class="de-lbl">' + esc(f.label) + '</span><span class="de-zero">Sin movimientos</span></div>';
                return (
                  '<div class="de-row"><span class="de-lbl">' +
                  esc(f.label) +
                  '</span><div class="de-tracks">' +
                  series
                    .map(function (s) {
                      var v = Number(f[s.k]) || 0;
                      return (
                        '<div class="de-track"><span class="de-fill de-fill--' +
                        s.c +
                        '" style="width:' +
                        Math.max(v ? 2 : 0, Math.round((v / max) * 100)) +
                        '%"></span><em>' +
                        cop(v) +
                        '</em></div>'
                      );
                    })
                    .join('') +
                  '</div></div>'
                );
              })
              .join('') +
            '</div><div class="de-legend">' +
            series
              .map(function (s) {
                return '<span><i class="de-dot de-fill--' + s.c + '"></i>' + esc(s.t) + '</span>';
              })
              .join('') +
            '</div>'
          );
        }
        async function loadDesempeno() {
          var st2 = $('de-status');
          var body = $('de-body');
          if (isDemo()) {
            st2.textContent = 'Disponible solo con sesión real.';
            return;
          }
          st2.textContent = 'Calculando…';
          try {
            var j = await api('desempeno');
            st2.textContent = '';
            var k = j.kpis;
            var vari =
              k.ventasMesAnterior > 0 ? Math.round(((k.ventasMes - k.ventasMesAnterior) / k.ventasMesAnterior) * 100) : null;
            var a = j.alegra;
            var html =
              '<section class="seg-metrics">' +
              metric('Ventas aprobadas este mes', cop(k.ventasMes)) +
              metric('vs. mes anterior', vari == null ? '—' : (vari >= 0 ? '+' : '') + vari + ' %') +
              metric('Cobrado este mes', cop(k.cobradoMes)) +
              metric('Saldo por cobrar (panel)', cop(k.saldoPorCobrar)) +
              metric('Pagos por verificar', cop(k.pagosPorVerificar)) +
              metric('Compras en curso', k.activosTienda) +
              metric('Proyectos en curso', k.activosProyectos) +
              metric('Margen promedio', k.margenPct == null ? 'Falta costo' : k.margenPct + ' %') +
              '</section>';
            html +=
              '<section class="de-card"><h2 class="de-h">Ventas por mes (panel y tienda web)</h2>' +
              barras(
                j.meses.map(function (m) {
                  return { label: mesTxt(m.mes), t: m.tienda, p: m.proyecto, w: m.web, c: m.cobrado };
                }),
                [
                  { k: 't', t: 'Compras en tienda', c: 'a' },
                  { k: 'p', t: 'Proyectos', c: 'b' },
                  { k: 'w', t: 'Tienda web (Wompi/Addi)', c: 'c' },
                  { k: 'c', t: 'Cobrado', c: 'd' },
                ]
              ) +
              '</section>';
            if (a) {
              var fm = (a.facturacionMensual || []).slice(-6);
              html +=
                '<section class="de-card"><h2 class="de-h">Facturación en Alegra</h2><p class="seg-sub">Actualizado ' +
                esc(fecha(a.guardado)) +
                ' por Claude</p>' +
                '<div class="seg-metrics">' +
                metric('Cartera por cobrar', cop(a.cartera && a.cartera.total)) +
                metric('Facturas abiertas', (a.cartera && a.cartera.facturas ? a.cartera.facturas.length : 0)) +
                metric('Facturado último mes', cop(fm.length ? fm[fm.length - 1].total : 0)) +
                metric('Recaudado último mes', cop((a.recaudoMensual || []).length ? a.recaudoMensual[a.recaudoMensual.length - 1].total : 0)) +
                '</div>' +
                (fm.length
                  ? barras(
                      fm.map(function (m) {
                        var rec = (a.recaudoMensual || []).find(function (x) {
                          return x.mes === m.mes;
                        });
                        return { label: mesTxt(m.mes), f: m.total, r: rec ? rec.total : 0 };
                      }),
                      [
                        { k: 'f', t: 'Facturado', c: 'a' },
                        { k: 'r', t: 'Recaudado', c: 'd' },
                      ]
                    )
                  : '') +
                (a.cartera && a.cartera.facturas && a.cartera.facturas.length
                  ? '<h3 class="de-h3">Facturas por cobrar</h3><div class="table-wrap"><table><thead><tr><th>Factura</th><th>Cliente</th><th>Fecha</th><th>Saldo</th><th>Días</th></tr></thead><tbody>' +
                    a.cartera.facturas
                      .map(function (f) {
                        return (
                          '<tr><td>' +
                          esc(f.numero) +
                          '</td><td>' +
                          esc(f.cliente) +
                          '</td><td>' +
                          esc(f.fecha) +
                          '</td><td>' +
                          cop(f.saldo) +
                          '</td><td>' +
                          esc(f.dias) +
                          '</td></tr>'
                        );
                      })
                      .join('') +
                    '</tbody></table></div>'
                  : '') +
                (a.topClientes && a.topClientes.length
                  ? '<h3 class="de-h3">Mejores clientes del año</h3><ol class="de-top">' +
                    a.topClientes
                      .slice(0, 5)
                      .map(function (c) {
                        return '<li>' + esc(c.cliente) + ' — ' + cop(c.total) + '</li>';
                      })
                      .join('') +
                    '</ol>'
                  : '') +
                '</section>';
            } else {
              html += '<section class="de-card"><p>Aún no hay datos de Alegra. Claude los carga en la revisión de la mañana.</p></section>';
            }
            html +=
              '<section class="de-card de-split"><div><h2 class="de-h">Ventas por proveedor</h2>' +
              (j.proveedores.length
                ? '<ul class="de-list">' +
                  j.proveedores
                    .map(function (p) {
                      return '<li><span>' + esc(p.proveedor) + '</span><strong>' + cop(p.total) + '</strong></li>';
                    })
                    .join('') +
                  '</ul>'
                : '<p class="notes-empty">Sin datos.</p>') +
              '</div><div><h2 class="de-h">¿Dónde está detenido el trabajo?</h2>' +
              (j.cuellos.length
                ? '<ul class="de-list">' +
                  j.cuellos
                    .map(function (c) {
                      return '<li><span>' + esc(c.etapa) + '</span><strong>' + c.n + '</strong></li>';
                    })
                    .join('') +
                  '</ul>'
                : '<p class="notes-empty">Nada pendiente.</p>') +
              '</div></section>';
            body.innerHTML = html;
          } catch (err) {
            st2.textContent = 'No se pudo cargar: ' + err.message;
          }
        }

        window.reikiSeg = {
          show: function () {
            setCat(st.cat);
            load();
          },
          api: api,
          esc: esc,
          cop: cop,
          fecha: fecha,
          isDemo: isDemo,
          setCat: setCat,
          upsert: function (e) {
            upsert(e);
            render();
          },
          abrir: async function (id) {
            if (!st.items.some(function (x) {
              return x.id === id;
            }))
              await load();
            openDetail(id);
          },
        };
      })();
    </script>

    <script is:inline src="/admin/panel-inicio.js?v=20261030a"></script>
    <script is:inline src="/admin/panel-cotizaciones.js?v=20261030c"></script>

    <script is:inline define:vars={{ MOCKS: pedidosMocks }}>
      (function () {
        var MOCKS_DATA = Array.isArray(MOCKS) ? MOCKS : [];

        var LS_SECRET = 'reiki_admin_orders_secret';
        var LS_USER = 'reiki_admin_orders_user';
        var LS_DEMO = 'reiki_admin_orders_demo';

        var state = {
          orders: [],
          view: 'kanban',
          query: '',
          gateway: '',
          selectedId: null,
          demo: false,
        };

        var el = {
          login: document.getElementById('view-login'),
          dash: document.getElementById('view-dash'),
          loginForm: document.getElementById('login-form'),
          loginErr: document.getElementById('login-error'),
          metrics: document.getElementById('metrics'),
          status: document.getElementById('dash-status'),
          kanban: document.getElementById('board-kanban'),
          lista: document.getElementById('board-lista'),
          modal: document.getElementById('modal'),
          modalBody: document.getElementById('modal-body'),
          q: document.getElementById('q-live'),
          gateway: document.getElementById('f-gateway'),
          dias: document.getElementById('f-dias'),
        };

        function getSecret() {
          try {
            return String(sessionStorage.getItem(LS_SECRET) || '').trim();
          } catch (_e) {
            return '';
          }
        }
        function getUser() {
          try {
            return String(sessionStorage.getItem(LS_USER) || 'admin').trim() || 'admin';
          } catch (_e) {
            return 'admin';
          }
        }
        function isDemo() {
          try {
            return sessionStorage.getItem(LS_DEMO) === '1';
          } catch (_e) {
            return false;
          }
        }
        function setSession(user, secret, demo) {
          try {
            if (demo) {
              sessionStorage.setItem(LS_DEMO, '1');
              sessionStorage.removeItem(LS_SECRET);
              sessionStorage.setItem(LS_USER, 'demo');
            } else {
              sessionStorage.removeItem(LS_DEMO);
              sessionStorage.setItem(LS_SECRET, secret);
              sessionStorage.setItem(LS_USER, user || 'admin');
            }
          } catch (_e) {}
        }
        function clearSession() {
          try {
            sessionStorage.removeItem(LS_SECRET);
            sessionStorage.removeItem(LS_USER);
            sessionStorage.removeItem(LS_DEMO);
          } catch (_e) {}
        }

        function authHeaders() {
          return {
            Authorization: 'Bearer ' + getSecret(),
            'X-Admin-User': getUser(),
            'Content-Type': 'application/json',
          };
        }

        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }
        function formatCop(n) {
          var v = Math.round(Number(n) || 0);
          return v ? '$ ' + v.toLocaleString('es-CO') : '—';
        }
        function formatWhen(iso) {
          if (!iso) return '—';
          try {
            return new Date(iso).toLocaleString('es-CO', {
              timeZone: 'America/Bogota',
              day: '2-digit',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
            });
          } catch (_e) {
            return String(iso);
          }
        }
        function todayBogota() {
          return new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
        }
        function isToday(iso) {
          if (!iso) return false;
          try {
            return (
              new Date(iso).toLocaleDateString('en-CA', { timeZone: 'America/Bogota' }) === todayBogota()
            );
          } catch (_e) {
            return false;
          }
        }
        function workflowOf(o) {
          return String(o.workflowStatus || 'nuevo').toLowerCase();
        }
        function waLink(phone, text) {
          var dig = String(phone || '').replace(/\D/g, '');
          if (dig.length === 10 && dig.charAt(0) === '3') dig = '57' + dig;
          if (!dig) return '';
          var url = 'https://wa.me/' + dig;
          var msg = String(text || '').trim();
          if (msg) url += '?text=' + encodeURIComponent(msg);
          return url;
        }

        function firstProductName(o) {
          var items = Array.isArray(o && o.items) ? o.items : [];
          if (!items.length) return 'producto solar';
          var it = items[0] || {};
          return String(it.name || it.title || it.sku || 'producto solar').trim() || 'producto solar';
        }

        function waPrefillMessage(o) {
          var name = ((o && o.client && o.client.fullName) || 'Cliente').trim() || 'Cliente';
          var product = firstProductName(o);
          return (
            'Hola ' +
            name +
            ', recibimos tu solicitud en Reiki Energia Solar por el ' +
            product +
            '. Tienes unos minutos para asesorarte?'
          );
        }

        function notesStorageKey(orderId) {
          return 'reiki_admin_order_notes_' + String(orderId || '');
        }

        function loadNotes(orderId) {
          try {
            var o = typeof findOrder === 'function' ? findOrder(orderId) : null;
            if (o && Array.isArray(o.notes) && o.notes.length) return o.notes.slice();
          } catch (_e) {
            /* ignore */
          }
          try {
            var raw = localStorage.getItem(notesStorageKey(orderId));
            var parsed = raw ? JSON.parse(raw) : [];
            return Array.isArray(parsed) ? parsed : [];
          } catch (_e2) {
            return [];
          }
        }

        function persistNotesLocal(orderId, notes) {
          try {
            var o = typeof findOrder === 'function' ? findOrder(orderId) : null;
            if (o) o.notes = notes;
          } catch (_e) {
            /* ignore */
          }
          try {
            localStorage.setItem(notesStorageKey(orderId), JSON.stringify(notes));
          } catch (_e2) {
            /* ignore quota */
          }
        }

        function formatNoteWhen(iso) {
          if (!iso) return '';
          try {
            return new Date(iso).toLocaleString('es-CO', {
              timeZone: 'America/Bogota',
              day: '2-digit',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
            });
          } catch (_e) {
            return String(iso);
          }
        }

        function renderNotesList(notes) {
          if (!notes.length) {
            return '<p class="notes-empty">Sin notas todavia. Agrega la primera bitacora del contacto.</p>';
          }
          return (
            '<ul class="notes-list">' +
            notes
              .map(function (n) {
                return (
                  '<li class="notes-item">' +
                  '<time>' +
                  esc(formatNoteWhen(n.at)) +
                  '</time>' +
                  '<p>' +
                  esc(n.text) +
                  '</p>' +
                  '</li>'
                );
              })
              .join('') +
            '</ul>'
          );
        }

        function handleSaveNote(orderId) {
          var ta = el.modalBody.querySelector('#note-input');
          var listEl = el.modalBody.querySelector('#notes-list-wrap');
          if (!ta || !listEl) return;
          var text = String(ta.value || '').trim();
          if (!text) {
            ta.focus();
            return;
          }
          var notes = loadNotes(orderId);
          notes.unshift({ text: text, at: new Date().toISOString() });
          // Optimistic UI: se refleja al instante en la lista
          persistNotesLocal(orderId, notes);
          listEl.innerHTML = renderNotesList(notes);
          ta.value = '';
          ta.focus();
          // TODO: Implementar guardado en Redis KV
        }

        function itemsSubtotal(items) {
          return (items || []).reduce(function (acc, it) {
            return acc + Math.round(Number(it.unitPrice || 0) * (Number(it.quantity) || 1));
          }, 0);
        }

        function filteredOrders() {
          var q = state.query.trim().toLowerCase();
          return state.orders.filter(function (o) {
            if (state.gateway && String(o.gateway || '').toLowerCase() !== state.gateway) return false;
            if (!q) return true;
            var hay = [
              o.orderId,
              o.client && o.client.fullName,
              o.client && o.client.phone,
              o.client && o.client.email,
              o.client && o.client.idNumber,
              o.shippingAddress && o.shippingAddress.city,
              (o.items || []).map(function (i) {
                return i.name || i.title;
              }).join(' '),
            ]
              .join(' ')
              .toLowerCase();
            return hay.indexOf(q) !== -1;
          });
        }

        function computeMetrics(orders) {
          var nuevos = 0;
          var revision = 0;
          var cerradoHoy = 0;
          var valorHoy = 0;
          orders.forEach(function (o) {
            var w = workflowOf(o);
            if (w === 'nuevo') nuevos += 1;
            if (w === 'en_revision') revision += 1;
            var when = o.paidAt || o.createdAt;
            if (isToday(when) && (String(o.status).toLowerCase() === 'approved' || w === 'cerrado')) {
              cerradoHoy += 1;
              valorHoy += Math.round(Number(o.totalAmount) || 0);
            } else if (isToday(when) && String(o.status).toLowerCase() === 'approved') {
              valorHoy += Math.round(Number(o.totalAmount) || 0);
            }
          });
          // Valor cerrado hoy: pedidos con paidAt hoy o workflow cerrado hoy
          valorHoy = 0;
          cerradoHoy = 0;
          orders.forEach(function (o) {
            var when = o.paidAt || o.updatedAt || o.createdAt;
            if (!isToday(when)) return;
            if (workflowOf(o) === 'cerrado' || String(o.status || '').toLowerCase() === 'approved') {
              valorHoy += Math.round(Number(o.totalAmount) || 0);
              if (workflowOf(o) === 'cerrado' || String(o.status || '').toLowerCase() === 'approved') {
                cerradoHoy += 1;
              }
            }
          });
          return { nuevos: nuevos, revision: revision, cerradoHoy: cerradoHoy, valorHoy: valorHoy, total: orders.length };
        }

        function renderMetrics() {
          var m = computeMetrics(filteredOrders());
          var card =
            'bg-white p-5 rounded-xl shadow-sm border border-gray-200 flex flex-col text-left';
          el.metrics.className = 'grid grid-cols-1 md:grid-cols-4 gap-4 mb-8';
          el.metrics.innerHTML =
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Nuevos</p><strong class="mt-1 block text-2xl font-extrabold text-gray-900">' +
            m.nuevos +
            '</strong></div>' +
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">En revisión</p><strong class="mt-1 block text-2xl font-extrabold text-gray-900">' +
            m.revision +
            '</strong></div>' +
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Cerrados / pagos hoy</p><strong class="mt-1 block text-2xl font-extrabold text-gray-900">' +
            m.cerradoHoy +
            '</strong></div>' +
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Valor hoy</p><strong class="mt-1 block text-xl font-extrabold metric-money">' +
            (m.valorHoy ? formatCop(m.valorHoy) : '—') +
            '</strong></div>';
        }

        function formatCardDate(iso) {
          if (!iso) return '—';
          try {
            return new Date(iso).toLocaleDateString('es-CO', {
              timeZone: 'America/Bogota',
              day: 'numeric',
              month: 'short',
            });
          } catch (_e) {
            return String(iso);
          }
        }

        function statusBadge(o) {
          var s = String(o.status || '').toLowerCase();
          var gw = String(o.gateway || '').toUpperCase() || '—';
          var label = payLabel(o.status);
          var tone = 'oc-badge--amber';
          if (s === 'approved' || s === 'completed') tone = 'oc-badge--ok';
          else if (s.indexOf('reject') !== -1 || s.indexOf('declin') !== -1 || s === 'abandoned')
            tone = 'oc-badge--bad';
          return (
            '<span class="oc-badge ' +
            tone +
            '">' +
            esc(gw + ' · ' + label) +
            '</span>'
          );
        }

        function payLabel(st) {
          var s = String(st || '').toLowerCase();
          if (s === 'approved' || s === 'completed') return 'Aprobado';
          if (s === 'pending_verify') return 'Por verificar';
          if (s === 'pending') return 'Pendiente';
          if (s.indexOf('reject') !== -1 || s.indexOf('declin') !== -1) return 'Rechazado';
          if (s === 'abandoned') return 'Abandonado';
          return st || '—';
        }

        function isApprovedOrder(o) {
          var st = String((o && o.status) || '').toLowerCase();
          return st === 'approved' || st === 'completed';
        }

        function cardHtml(o) {
          o = o || {};
          var phone = (o.client && o.client.phone) || '';
          var doc =
            (o.client &&
              (o.client.document || o.client.docNumber || o.client.cedula || o.client.idNumber)) ||
            '';
          var name = (o.client && o.client.fullName) || 'Cliente';
          var items = Array.isArray(o.items) ? o.items : [];
          var preview = items
            .slice(0, 2)
            .map(function (it) {
              it = it || {};
              return (it.quantity || 1) + 'x ' + (it.name || it.title || 'Producto');
            })
            .join(' · ');
          var meta = [phone, doc].filter(Boolean).join(' · ') || 'Sin celular / cedula';
          var wa = '';
          try {
            wa = waLink(phone, waPrefillMessage(o));
          } catch (_waErr) {
            wa = waLink(phone);
          }
          return (
            '<div class="order-card oc-card" data-id="' +
            esc(o.orderId) +
            '" role="button" tabindex="0">' +
            '<div class="oc-head">' +
            statusBadge(o) +
            '<span class="oc-date">' +
            esc(formatCardDate(o.paidAt || o.createdAt)) +
            '</span></div>' +
            '<div class="oc-body">' +
            '<h3 class="oc-name">' +
            esc(name) +
            '</h3>' +
            '<p class="oc-meta">' +
            esc(meta) +
            '</p>' +
            '<div class="oc-product">' +
            esc(preview || 'Sin equipos') +
            '</div>' +
            (isApprovedOrder(o) && items.length
              ? '<div class="oc-prov"><i class="fas fa-truck" aria-hidden="true"></i> ' +
                esc(proveedoresDe(items).join(' · ')) +
                '</div>'
              : '') +
            '</div>' +
            '<div class="oc-price">' +
            esc(formatCop(o.totalAmount)) +
            '</div>' +
            '<div class="oc-actions">' +
            (wa
              ? '<a href="' +
                wa +
                '" target="_blank" rel="noopener" data-stop="1" class="oc-btn oc-btn-wa"><i class="fab fa-whatsapp"></i> WhatsApp</a>'
              : '<span class="oc-btn oc-btn-disabled">Sin WhatsApp</span>') +
            '<button type="button" data-pdf="' +
            esc(o.orderId) +
            '" data-stop="1" class="oc-btn oc-btn-sec">PDF</button>' +
            '<button type="button" data-open="' +
            esc(o.orderId) +
            '" class="oc-btn oc-btn-sec">Detalle</button>' +
            '</div></div>'
          );
        }

        function renderKanban() {
          var cols = [
            { key: 'nuevo', title: 'Nuevo', hint: 'Por contactar' },
            { key: 'en_revision', title: 'En revision', hint: 'En gestion' },
            { key: 'cerrado', title: 'Cerrado', hint: 'Listo / despachado' },
          ];
          var list = [];
          try {
            list = filteredOrders();
          } catch (_e) {
            list = state.orders || [];
          }
          el.kanban.className = 'kanban-board';
          try {
            el.kanban.innerHTML = cols
              .map(function (col) {
                var items = list.filter(function (o) {
                  return workflowOf(o) === col.key;
                });
                var cardsHtml = '';
                if (items.length) {
                  cardsHtml = items
                    .map(function (ord) {
                      try {
                        return cardHtml(ord);
                      } catch (_cardErr) {
                        return (
                          '<div class="order-card oc-card" data-id="' +
                          esc(ord && ord.orderId) +
                          '"><h3 class="oc-name">' +
                          esc((ord && ord.client && ord.client.fullName) || 'Pedido') +
                          '</h3><p class="oc-meta">Error al pintar tarjeta</p></div>'
                        );
                      }
                    })
                    .join('');
                } else {
                  cardsHtml = '<p class="kb-empty">Sin pedidos</p>';
                }
                return (
                  '<div class="kb-col" data-col="' +
                  col.key +
                  '">' +
                  '<header class="kb-col-head">' +
                  '<h2 class="kb-col-title">' +
                  esc(col.title) +
                  ' <em class="kb-col-count">' +
                  items.length +
                  '</em></h2>' +
                  '<span class="kb-col-hint">' +
                  esc(col.hint) +
                  '</span></header>' +
                  '<div class="kb-cards">' +
                  cardsHtml +
                  '</div></div>'
                );
              })
              .join('');
            bindCards(el.kanban);
          } catch (err) {
            console.error('[pedidos] renderKanban', err);
            el.kanban.innerHTML =
              '<p class="kb-empty">No se pudo cargar el tablero. Revisa la consola.</p>';
          }
        }

        function renderLista() {
          var list = [];
          try {
            list = filteredOrders();
          } catch (_e) {
            list = state.orders || [];
          }
          el.lista.className = '';
          if (!list.length) {
            el.lista.innerHTML = '<p class="kb-empty">Sin pedidos</p>';
            return;
          }
          try {
            el.lista.innerHTML =
              '<div class="lista-grid">' +
              list
                .map(function (ord) {
                  try {
                    return cardHtml(ord);
                  } catch (_e) {
                    return '';
                  }
                })
                .join('') +
              '</div>';
            bindCards(el.lista);
          } catch (err) {
            console.error('[pedidos] renderLista', err);
            el.lista.innerHTML = '<p class="kb-empty">No se pudo cargar la lista.</p>';
          }
        }

        function bindCards(root) {
          root.querySelectorAll('.order-card').forEach(function (card) {
            card.addEventListener('click', function (e) {
              var t = e.target;
              if (t && t.closest && t.closest('[data-stop]')) return;
              openModal(card.getAttribute('data-id'));
            });
            card.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                openModal(card.getAttribute('data-id'));
              }
            });
          });
          root.querySelectorAll('[data-pdf]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              openPdf(btn.getAttribute('data-pdf'), btn);
            });
          });
          root.querySelectorAll('[data-open]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              openModal(btn.getAttribute('data-open'));
            });
          });
          root.querySelectorAll('a[data-stop]').forEach(function (a) {
            a.addEventListener('click', function (e) {
              e.stopPropagation();
            });
          });
        }

        function renderAll() {
          try {
            renderMetrics();
          } catch (err) {
            console.error('[pedidos] renderMetrics', err);
          }
          try {
            if (state.view === 'kanban') {
              el.kanban.hidden = false;
              el.lista.hidden = true;
              renderKanban();
            } else {
              el.kanban.hidden = true;
              el.lista.hidden = false;
              renderLista();
            }
          } catch (err) {
            console.error('[pedidos] render board', err);
          }
          try {
            el.status.textContent =
              filteredOrders().length +
              ' de ' +
              state.orders.length +
              ' pedidos' +
              (state.demo ? ' · modo demo' : '');
          } catch (_e) {
            el.status.textContent = (state.orders || []).length + ' pedidos';
          }
        }

        function proveedorDe(it) {
          var p = String((it && it.proveedor) || '').trim();
          return p || 'Por confirmar';
        }

        function proveedorChip(it) {
          var p = proveedorDe(it);
          var pend = p.indexOf('Por confirmar') === 0;
          var code = String((it && it.codigoProveedor) || '').trim();
          return (
            '<span class="prov-chip' +
            (pend ? ' prov-chip--pend' : '') +
            '">' +
            esc(p) +
            '</span>' +
            (code && !pend ? '<span class="prov-code">' + esc(code) + '</span>' : '')
          );
        }

        function proveedoresDe(items) {
          var seen = {};
          var out = [];
          (items || []).forEach(function (it) {
            var p = proveedorDe(it);
            if (!seen[p]) {
              seen[p] = true;
              out.push(p);
            }
          });
          return out;
        }

        /** Agrupa los equipos por proveedor (para armar las órdenes de compra). */
        function resumenProveedores(items) {
          if (!items || !items.length) return '';
          var grupos = {};
          var orden = [];
          items.forEach(function (it) {
            var p = proveedorDe(it);
            if (!grupos[p]) {
              grupos[p] = [];
              orden.push(p);
            }
            grupos[p].push(it);
          });
          return (
            '<div class="prov-resumen"><h4>Pedir a cada proveedor</h4>' +
            orden
              .map(function (p) {
                return (
                  '<div class="prov-grupo"><span class="prov-chip' +
                  (p.indexOf('Por confirmar') === 0 ? ' prov-chip--pend' : '') +
                  '">' +
                  esc(p) +
                  '</span><ul>' +
                  grupos[p]
                    .map(function (it) {
                      return (
                        '<li>' +
                        esc(it.quantity || 1) +
                        ' × ' +
                        esc(it.name || it.title || it.sku) +
                        '</li>'
                      );
                    })
                    .join('') +
                  '</ul></div>'
                );
              })
              .join('') +
            '</div>'
          );
        }

        function findOrder(id) {
          return state.orders.find(function (o) {
            return o.orderId === id;
          });
        }

        function openModal(id) {
          var o = findOrder(id);
          if (!o) return;
          state.selectedId = id;
          var c = o.client || {};
          var ship = o.shippingAddress || {};
          var items = o.items || [];
          var sub = itemsSubtotal(items) || Number(o.totalAmount) || 0;
          var wa = waLink(c.phone, waPrefillMessage(o));
          var wf = workflowOf(o);
          var notes = loadNotes(o.orderId);

          var itemsRows = items.length
            ? items
                .map(function (it) {
                  var line = Math.round(Number(it.unitPrice || 0) * (Number(it.quantity) || 1));
                  return (
                    '<tr><td>' +
                    esc(it.name || it.title || it.sku) +
                    '</td><td>' +
                    proveedorChip(it) +
                    '</td><td>' +
                    esc(it.quantity || 1) +
                    '</td><td>' +
                    esc(formatCop(it.unitPrice)) +
                    '</td><td>' +
                    esc(formatCop(line)) +
                    '</td></tr>'
                  );
                })
                .join('')
            : '<tr><td colspan="5">Sin detalle de equipos</td></tr>';

          el.modalBody.innerHTML =
            '<p class="modal-kicker">' +
            esc(String(o.gateway || '').toUpperCase()) +
            ' · ' +
            esc(o.status || '—') +
            '</p>' +
            '<h2 id="modal-title">' +
            esc(c.fullName || 'Pedido') +
            '</h2>' +
            '<p class="modal-when">' +
            esc(formatWhen(o.paidAt || o.createdAt)) +
            ' · ID <code>' +
            esc(o.orderId) +
            '</code></p>' +
            '<div class="modal-grid">' +
            '<section class="modal-block">' +
            '<h3>Datos del cliente</h3>' +
            '<dl>' +
            '<div><dt>Nombre</dt><dd>' +
            esc(c.fullName || '—') +
            '</dd></div>' +
            '<div><dt>Celular</dt><dd>' +
            esc(c.phone || '—') +
            '</dd></div>' +
            '<div><dt>Correo</dt><dd>' +
            esc(c.email || '—') +
            '</dd></div>' +
            '<div><dt>Documento</dt><dd>CC ' +
            esc(c.idNumber || '—') +
            '</dd></div>' +
            '<div><dt>Dirección</dt><dd>' +
            esc([ship.lineOne, ship.city, ship.department].filter(Boolean).join(', ') || '—') +
            '</dd></div>' +
            '</dl>' +
            '</section>' +
            '<section class="modal-block">' +
            '<h3>Cotización de la compra</h3>' +
            '<div class="table-wrap"><table><thead><tr><th>Equipo</th><th>Proveedor</th><th>Cant.</th><th>Unit.</th><th>Total</th></tr></thead><tbody>' +
            itemsRows +
            '</tbody></table></div>' +
            resumenProveedores(items) +
            '<div class="totals">' +
            '<div><span>Subtotal equipos</span><strong>' +
            esc(formatCop(sub)) +
            '</strong></div>' +
            '<div><span>Total pedido</span><strong class="total-big">' +
            esc(formatCop(o.totalAmount || sub)) +
            '</strong></div>' +
            '</div>' +
            '</section>' +
            '</div>' +
            '<section class="modal-block notes-block">' +
            '<h3>Bitácora / Notas internas</h3>' +
            '<div id="notes-list-wrap">' +
            renderNotesList(notes) +
            '</div>' +
            '<label class="notes-label" for="note-input">Nueva nota</label>' +
            '<textarea id="note-input" class="notes-textarea" rows="3" placeholder="Ej: Cliente pidió llamada mañana a las 10 a.m."></textarea>' +
            '<div class="notes-save-row">' +
            '<button type="button" class="btn btn-primary" id="btn-save-note">Guardar nota</button>' +
            '</div>' +
            '</section>' +
            '<div class="modal-actions">' +
            (wa
              ? '<a class="btn btn-wa" href="' +
                wa +
                '" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> Contactar cliente</a>'
              : '') +
            '<button type="button" class="btn btn-ghost" data-pdf="' +
            esc(o.orderId) +
            '"><i class="fas fa-file-pdf"></i> Ver PDF</button>' +
            (wf !== 'en_revision'
              ? '<button type="button" class="btn btn-secondary" data-wf="en_revision">En revisión</button>'
              : '') +
            (wf !== 'cerrado'
              ? '<button type="button" class="btn btn-primary" data-wf="cerrado">Marcar cerrado</button>'
              : '') +
            (wf !== 'nuevo'
              ? '<button type="button" class="btn btn-ghost" data-wf="nuevo">Volver a nuevo</button>'
              : '') +
            '</div>';

          el.modal.hidden = false;
          document.body.style.overflow = 'hidden';

          el.modalBody.querySelectorAll('[data-wf]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              setWorkflow(o.orderId, btn.getAttribute('data-wf'));
            });
          });
          var pdfBtn = el.modalBody.querySelector('[data-pdf]');
          if (pdfBtn) {
            pdfBtn.addEventListener('click', function () {
              openPdf(o.orderId, pdfBtn);
            });
          }
          var saveNoteBtn = el.modalBody.querySelector('#btn-save-note');
          if (saveNoteBtn) {
            saveNoteBtn.addEventListener('click', function () {
              handleSaveNote(o.orderId);
            });
          }
          var noteInput = el.modalBody.querySelector('#note-input');
          if (noteInput) {
            noteInput.addEventListener('keydown', function (e) {
              if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                handleSaveNote(o.orderId);
              }
            });
          }
        }

        function closeModal() {
          el.modal.hidden = true;
          document.body.style.overflow = '';
          state.selectedId = null;
        }

        async function setWorkflow(orderId, workflowStatus) {
          if (state.demo) {
            var o = findOrder(orderId);
            if (o) {
              o.workflowStatus = workflowStatus;
              o.workflowUpdatedAt = new Date().toISOString();
            }
            renderAll();
            openModal(orderId);
            return;
          }
          try {
            var res = await fetch('/api/order-status', {
              method: 'POST',
              headers: authHeaders(),
              body: JSON.stringify({ orderId: orderId, workflowStatus: workflowStatus }),
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (!res.ok || !json.ok) {
              alert(json.error || 'No se pudo actualizar el estado.');
              return;
            }
            var idx = state.orders.findIndex(function (x) {
              return x.orderId === orderId;
            });
            if (idx >= 0 && json.order) state.orders[idx] = json.order;
            else if (idx >= 0) state.orders[idx].workflowStatus = workflowStatus;
            renderAll();
            openModal(orderId);
          } catch (_e) {
            alert('Error de red al actualizar.');
          }
        }

        async function openPdf(orderId, btn) {
          if (state.demo) {
            alert('En modo demo el PDF real se genera solo con pedidos de producción.');
            return;
          }
          var prev = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando…';
          try {
            var res = await fetch('/api/order-pdf?orderId=' + encodeURIComponent(orderId), {
              headers: authHeaders(),
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (!res.ok || !json.pdfUrl) {
              alert(json.error || 'No se pudo generar el PDF.');
              return;
            }
            window.open(json.pdfUrl, '_blank', 'noopener');
          } catch (_e) {
            alert('Error de red al generar PDF.');
          } finally {
            btn.disabled = false;
            btn.innerHTML = prev;
          }
        }

        async function loadOrders() {
          state.demo = isDemo();
          if (state.demo) {
            state.orders = MOCKS_DATA.slice();
            renderAll();
            el.status.textContent = state.orders.length + ' pedidos · modo demo';
            return;
          }
          el.status.textContent = 'Cargando pedidos…';
          try {
            var dias = el.dias && el.dias.value ? el.dias.value : '30';
            var res = await fetch('/api/orders-search?dias=' + encodeURIComponent(dias), {
              headers: authHeaders(),
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (res.status === 401) {
              clearSession();
              showLogin(json.error || 'Sesión inválida. Vuelve a entrar.');
              return;
            }
            if (!res.ok || !json.ok) {
              el.status.textContent = json.error || 'Error al cargar.';
              state.orders = [];
              renderAll();
              return;
            }
            state.orders = (json.orders || []).map(function (o) {
              return Object.assign({}, o, {
                workflowStatus: o.workflowStatus || 'nuevo',
              });
            });
            // Si el rango corto viene vacío, reintentar 30 días
            if (!state.orders.length && String(dias) !== '30') {
              var res2 = await fetch('/api/orders-search?dias=30', { headers: authHeaders() });
              var json2 = await res2.json().catch(function () {
                return {};
              });
              if (res2.ok && json2.ok && Array.isArray(json2.orders) && json2.orders.length) {
                state.orders = json2.orders.map(function (o) {
                  return Object.assign({}, o, { workflowStatus: o.workflowStatus || 'nuevo' });
                });
                if (el.dias) el.dias.value = '30';
              }
            }
            renderAll();
            if (!state.orders.length) {
              el.status.textContent =
                '0 pedidos en Redis (últimos ' +
                (el.dias && el.dias.value ? el.dias.value : dias) +
                ' días). Usa «Ver demo» o revisa KV.';
            }
          } catch (_e) {
            el.status.textContent = 'No se pudo contactar el servidor.';
            state.orders = [];
            renderAll();
          }
        }

        function setView(mode) {
          var isDash = mode === 'dash';
          document.body.classList.toggle('is-dashboard', isDash);
          document.body.classList.toggle('is-login', !isDash);
          el.login.hidden = isDash;
          el.dash.hidden = !isDash;
          el.login.setAttribute('aria-hidden', isDash ? 'true' : 'false');
          el.dash.setAttribute('aria-hidden', isDash ? 'false' : 'true');
          window.scrollTo(0, 0);
          // Sin animación de opacity: en algunos navegadores dejaba el dashboard invisible
          el.dash.classList.remove('view-enter');
          el.login.classList.remove('view-enter');
        }

        function showLogin(msg) {
          setView('login');
          closeModal();
          el.loginErr.hidden = !msg;
          el.loginErr.textContent = msg || '';
        }
        function showDash() {
          setView('dash');
          loadOrders();
          if (window.reikiSeg) window.reikiSeg.show();
        }

        el.loginForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var user = String(document.getElementById('login-user').value || '').trim() || 'admin';
          var pass = String(document.getElementById('login-pass').value || '').trim();
          if (!pass) return;
          var submitBtn = el.loginForm.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Entrando…';
          }
          setSession(user, pass, false);
          // Probar auth con una búsqueda corta
          fetch('/api/orders-search?dias=30', {
            headers: {
              Authorization: 'Bearer ' + pass,
              'X-Admin-User': user,
            },
          })
            .then(function (r) {
              return r.json().then(function (j) {
                return { r: r, j: j };
              });
            })
            .then(function (x) {
              if (x.r.status === 401) {
                clearSession();
                showLogin(x.j.error || 'Usuario o contraseña incorrectos.');
                return;
              }
              showDash();
            })
            .catch(function () {
              clearSession();
              showLogin('No se pudo validar el acceso.');
            })
            .finally(function () {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Entrar al dashboard';
              }
            });
        });

        document.getElementById('btn-demo').addEventListener('click', function () {
          setSession('demo', '', true);
          showDash();
        });
        document.getElementById('btn-logout').addEventListener('click', function () {
          clearSession();
          showLogin();
        });
        document.getElementById('btn-refresh').addEventListener('click', loadOrders);

        el.q.addEventListener('input', function () {
          state.query = el.q.value || '';
          renderAll();
        });
        el.gateway.addEventListener('change', function () {
          state.gateway = el.gateway.value || '';
          renderAll();
        });
        el.dias.addEventListener('change', function () {
          if (!state.demo) loadOrders();
        });

        document.querySelectorAll('.view-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            document.querySelectorAll('.view-btn').forEach(function (b) {
              b.classList.remove('is-active');
            });
            btn.classList.add('is-active');
            state.view = btn.getAttribute('data-view') || 'kanban';
            renderAll();
          });
        });

        el.modal.addEventListener('click', function (e) {
          if (e.target && e.target.getAttribute('data-close')) closeModal();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !el.modal.hidden) closeModal();
        });

        if (isDemo() || getSecret()) showDash();
        else showLogin();
      })();
    </script>

    <style is:global>
      :root {
        --ink: #1f1230;
        --brand: #6b2181;
        --brand-2: #8b2a9b;
        --brand-dark: #4a1a5c;
        --mint: #f5eef8;
        --sand: #faf7fc;
        --line: #e8dced;
        --muted: #6b5f75;
        --card: rgba(255, 255, 255, 0.96);
        --shadow: 0 16px 40px rgba(107, 33, 129, 0.12);
        --accent: #f97316;
        --sun: #facc15;
        --ok: #16a34a;
        --ok-2: #22c55e;
        --wa: #25d366;
        /* aliases usados por botones/vistas existentes */
        --green: var(--brand);
        --green-2: var(--brand-2);
      }
      * {
        box-sizing: border-box;
      }
      /* Evita que display:grid/flex pisen el atributo HTML hidden */
      [hidden] {
        display: none !important;
      }
      .dash-body {
        margin: 0;
        min-height: 100vh;
        font-family: Montserrat, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: linear-gradient(135deg, #6b2181 0%, #8b2a9b 50%, #6b2181 100%);
        background-attachment: fixed;
      }
      .dash-body.is-login {
        overflow: hidden;
      }
      .dash-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.14), transparent 42%),
          radial-gradient(circle at 88% 8%, rgba(250, 204, 21, 0.12), transparent 36%),
          url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
        background-size: auto, auto, 100px 100px;
      }
      .login-wrap,
      .dash-wrap {
        position: relative;
        z-index: 1;
      }
      .login-wrap {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
      }
      .view-enter {
        /* animación desactivada: opacity:0 dejaba el panel en blanco */
      }
      @keyframes viewEnter {
        from {
          opacity: 1;
          transform: none;
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .dash-wrap:not([hidden]) {
        opacity: 1 !important;
        visibility: visible !important;
      }
      #board-kanban:not([hidden]),
      .kanban-board {
        opacity: 1 !important;
        visibility: visible !important;
        min-height: 200px;
      }
      .login-card {
        width: min(420px, 100%);
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 20px;
        box-shadow: var(--shadow);
        padding: 1.75rem 1.4rem 1.5rem;
        text-align: center;
      }
      .login-logo {
        height: 44px;
        width: auto;
        margin-bottom: 0.75rem;
      }
      .login-card h1 {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 800;
      }
      .login-sub {
        margin: 0.35rem 0 1.1rem;
        color: var(--muted);
        font-size: 0.92rem;
      }
      .login-form {
        display: grid;
        gap: 0.75rem;
        text-align: left;
        margin-bottom: 0.65rem;
      }
      label {
        display: grid;
        gap: 0.3rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--muted);
      }
      input,
      select {
        font: inherit;
        padding: 0.7rem 0.8rem;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
      }
      .login-error {
        color: #a32020;
        margin: 0.75rem 0 0;
        font-size: 0.88rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 700;
        padding: 0.7rem 1.1rem;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
      }
      .btn-primary {
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #fff;
        box-shadow: 0 10px 22px rgba(107, 33, 129, 0.28);
      }
      .btn-primary:disabled {
        opacity: 0.7;
        cursor: wait;
      }
      .btn-secondary {
        background: var(--brand-dark);
        color: #fff;
      }
      .btn-ghost {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--brand);
      }
      .btn-wa {
        background: var(--wa);
        color: #fff;
      }
      .btn-block {
        width: 100%;
      }
      .dash-wrap {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.2rem 1rem 3rem;
        min-height: 100vh;
      }
      /* Layout de respaldo (por si Tailwind CDN no carga) */
      #metrics {
        display: grid !important;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
      }
      #metrics > div {
        background: #fff;
        padding: 1.25rem;
        border-radius: 0.75rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
        border: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        text-align: left;
      }
      #board-kanban {
        display: grid !important;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        align-items: start;
      }
      #board-kanban > [data-col] {
        background: rgba(243, 244, 246, 0.5);
        padding: 1rem;
        border-radius: 0.75rem;
        min-height: 500px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .order-card,
      .oc-card {
        font: inherit;
        color: inherit;
