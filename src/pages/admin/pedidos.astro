---
import SEO from '../../components/SEO.astro';
import FontAwesome from '../../components/FontAwesome.astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Pedidos tienda | Admin Reiki</title>
    <FontAwesome />
    <SEO
      title="Pedidos tienda | Admin Reiki"
      description="Panel interno de pedidos."
      canonical="/admin/pedidos"
      noindex={true}
      schemaType="WebPage"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <div class="admin-bg" aria-hidden="true"></div>

    <main class="admin-main">
      <header class="admin-top">
        <div class="admin-brand">
          <img src="/images/logo.png" alt="Reiki Energía Solar" class="admin-logo" width="160" height="48" />
          <div>
            <p class="admin-eyebrow">Panel interno</p>
            <h1>Pedidos de la tienda</h1>
          </div>
        </div>
        <button type="button" id="admin-logout" class="admin-btn admin-btn--ghost" hidden>Salir</button>
      </header>

      <section id="admin-login" class="admin-login-card" hidden>
        <div class="admin-login-mark">
          <img src="/images/logo.png" alt="" width="120" height="36" />
        </div>
        <h2>Acceso asesor</h2>
        <p class="admin-help">Ingresa la contraseña de administración de pedidos.</p>
        <form id="admin-login-form" class="admin-login-form">
          <label>
            Contraseña
            <input type="password" name="secret" id="admin-secret" autocomplete="current-password" required />
          </label>
          <button type="submit" class="admin-btn admin-btn--block">Entrar</button>
        </form>
        <p id="admin-login-error" class="admin-error" hidden></p>
      </section>

      <section id="admin-panel" hidden>
        <form id="admin-filters" class="admin-filters">
          <label>
            Días
            <input type="number" name="dias" id="f-dias" min="1" max="90" value="7" />
          </label>
          <label>
            Fecha
            <input type="date" name="fecha" id="f-fecha" />
          </label>
          <label>
            Documento
            <input type="text" name="documento" id="f-documento" inputmode="numeric" placeholder="Cédula" />
          </label>
          <label>
            Nombre
            <input type="text" name="nombre" id="f-nombre" placeholder="Cliente" />
          </label>
          <div class="admin-filter-actions">
            <button type="submit" class="admin-btn">Buscar</button>
            <button type="button" id="admin-hoy" class="admin-btn admin-btn--ghost">Hoy</button>
          </div>
        </form>

        <p id="admin-status" class="admin-status" aria-live="polite">Cargando…</p>
        <div id="admin-list" class="admin-list"></div>
      </section>
    </main>

    <script is:inline>
      (function () {
        var LS_KEY = 'reiki_admin_orders_secret';
        var loginEl = document.getElementById('admin-login');
        var panelEl = document.getElementById('admin-panel');
        var logoutBtn = document.getElementById('admin-logout');
        var loginForm = document.getElementById('admin-login-form');
        var loginErr = document.getElementById('admin-login-error');
        var statusEl = document.getElementById('admin-status');
        var listEl = document.getElementById('admin-list');
        var filters = document.getElementById('admin-filters');

        function getSecret() {
          try {
            return String(sessionStorage.getItem(LS_KEY) || '').trim();
          } catch (_e) {
            return '';
          }
        }
        function setSecret(v) {
          try {
            if (v) sessionStorage.setItem(LS_KEY, v);
            else sessionStorage.removeItem(LS_KEY);
          } catch (_e) {}
        }
        function showLogin(msg) {
          loginEl.hidden = false;
          panelEl.hidden = true;
          logoutBtn.hidden = true;
          loginErr.hidden = !msg;
          loginErr.textContent = msg || '';
        }
        function showPanel() {
          loginEl.hidden = true;
          panelEl.hidden = false;
          logoutBtn.hidden = false;
        }
        function formatCop(n) {
          var v = Math.round(Number(n) || 0);
          return v ? '$ ' + v.toLocaleString('es-CO') : '—';
        }
        function formatWhen(iso) {
          if (!iso) return '—';
          try {
            return new Date(iso).toLocaleString('es-CO', {
              timeZone: 'America/Bogota',
              day: '2-digit',
              month: 'short',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            });
          } catch (_e) {
            return String(iso);
          }
        }
        function statusClass(st) {
          var s = String(st || '').toLowerCase();
          if (s === 'approved' || s === 'completed' || s === 'pagada') return 'is-ok';
          if (s.indexOf('pending') !== -1 || s === 'pending_verify') return 'is-wait';
          if (s.indexOf('reject') !== -1 || s.indexOf('declin') !== -1 || s === 'abandoned') return 'is-bad';
          return 'is-neutral';
        }
        function waLink(phone) {
          var dig = String(phone || '').replace(/\D/g, '');
          if (dig.length === 10 && dig.charAt(0) === '3') dig = '57' + dig;
          return dig ? 'https://wa.me/' + dig : '';
        }
        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        function renderOrders(orders) {
          listEl.innerHTML = '';
          if (!orders.length) {
            statusEl.textContent = 'Sin pedidos para estos filtros.';
            return;
          }
          statusEl.textContent = orders.length + ' pedido(s)';
          orders.forEach(function (o) {
            var phone = (o.client && o.client.phone) || '';
            var wa = waLink(phone);
            var items = Array.isArray(o.items) ? o.items : [];
            var itemsHtml = items.length
              ? '<ul class="admin-items">' +
                items
                  .slice(0, 8)
                  .map(function (it) {
                    return (
                      '<li><span>' +
                      esc(it.quantity || 1) +
                      '×</span> ' +
                      esc(it.name || it.title || it.sku || 'Producto') +
                      '</li>'
                    );
                  })
                  .join('') +
                '</ul>'
              : '<p class="admin-muted">Sin detalle de productos</p>';

            var ship = o.shippingAddress || {};
            var shipLine = [ship.lineOne || ship.address, ship.city].filter(Boolean).join(', ');
            var pdfBtn =
              '<button type="button" class="admin-btn admin-btn--pdf" data-order-id="' +
              esc(o.orderId) +
              '"><i class="fas fa-file-pdf" aria-hidden="true"></i> Cotización PDF</button>';

            var card = document.createElement('article');
            card.className = 'admin-order';
            card.innerHTML =
              '<div class="admin-order-head">' +
              '<div class="admin-order-meta">' +
              '<span class="admin-pill admin-pill--gw">' +
              esc(String(o.gateway || '—').toUpperCase()) +
              '</span>' +
              '<span class="admin-pill ' +
              statusClass(o.status) +
              '">' +
              esc(o.status || '—') +
              '</span>' +
              '<time>' +
              esc(formatWhen(o.paidAt || o.createdAt)) +
              '</time>' +
              '</div>' +
              '<div class="admin-order-total">' +
              esc(formatCop(o.totalAmount)) +
              '</div>' +
              '</div>' +
              '<div class="admin-order-body">' +
              '<div class="admin-client">' +
              '<h2>' +
              esc((o.client && o.client.fullName) || 'Cliente') +
              '</h2>' +
              '<p class="admin-phone-row">' +
              (phone
                ? wa
                  ? '<a class="admin-phone" href="' +
                    wa +
                    '" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> ' +
                    esc(phone) +
                    '</a>'
                  : esc(phone)
                : '<span class="admin-muted">Sin celular</span>') +
              '</p>' +
              '<p class="admin-muted">CC ' +
              esc((o.client && o.client.idNumber) || '—') +
              (o.client && o.client.email ? ' · ' + esc(o.client.email) : '') +
              '</p>' +
              (shipLine ? '<p class="admin-ship"><i class="fas fa-map-marker-alt"></i> ' + esc(shipLine) + '</p>' : '') +
              '</div>' +
              '<div class="admin-order-products">' +
              '<h3>Equipos</h3>' +
              itemsHtml +
              '</div>' +
              '</div>' +
              '<div class="admin-order-foot">' +
              '<code title="ID pedido">' +
              esc(o.orderId || '—') +
              '</code>' +
              '<div class="admin-order-actions">' +
              pdfBtn +
              '</div>' +
              '</div>';
            listEl.appendChild(card);
          });

          listEl.querySelectorAll('[data-order-id]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              openPdf(btn.getAttribute('data-order-id'), btn);
            });
          });
        }

        async function openPdf(orderId, btn) {
          var secret = getSecret();
          if (!secret || !orderId) return;
          var prev = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando…';
          try {
            var res = await fetch('/api/order-pdf?orderId=' + encodeURIComponent(orderId), {
              headers: { Authorization: 'Bearer ' + secret },
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (!res.ok || !json.pdfUrl) {
              alert(json.error || 'No se pudo generar el PDF.');
              return;
            }
            window.open(json.pdfUrl, '_blank', 'noopener');
          } catch (_e) {
            alert('Error de red al generar el PDF.');
          } finally {
            btn.disabled = false;
            btn.innerHTML = prev;
          }
        }

        async function loadOrders() {
          var secret = getSecret();
          if (!secret) {
            showLogin();
            return;
          }
          showPanel();
          statusEl.textContent = 'Cargando…';
          listEl.innerHTML = '';
          var params = new URLSearchParams();
          params.set('dias', document.getElementById('f-dias').value || '7');
          var fecha = document.getElementById('f-fecha').value || '';
          var documento = document.getElementById('f-documento').value || '';
          var nombre = document.getElementById('f-nombre').value || '';
          if (fecha) params.set('fecha', fecha);
          if (documento) params.set('documento', documento.replace(/\D/g, ''));
          if (nombre) params.set('nombre', nombre.trim());
          try {
            var res = await fetch('/api/orders-search?' + params.toString(), {
              headers: { Authorization: 'Bearer ' + secret },
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (res.status === 401) {
              setSecret('');
              showLogin(json.error || 'Contraseña incorrecta o secret no configurado.');
              return;
            }
            if (!res.ok || !json.ok) {
              statusEl.textContent = json.error || 'Error al cargar pedidos.';
              return;
            }
            renderOrders(Array.isArray(json.orders) ? json.orders : []);
          } catch (_e) {
            statusEl.textContent = 'No se pudo contactar el servidor.';
          }
        }

        loginForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var v = String(document.getElementById('admin-secret').value || '').trim();
          if (!v) return;
          setSecret(v);
          loadOrders();
        });
        logoutBtn.addEventListener('click', function () {
          setSecret('');
          document.getElementById('admin-secret').value = '';
          showLogin();
        });
        filters.addEventListener('submit', function (e) {
          e.preventDefault();
          loadOrders();
        });
        document.getElementById('admin-hoy').addEventListener('click', function () {
          document.getElementById('f-fecha').value = new Date().toLocaleDateString('en-CA', {
            timeZone: 'America/Bogota',
          });
          document.getElementById('f-dias').value = '1';
          loadOrders();
        });

        if (getSecret()) loadOrders();
        else showLogin();
      })();
    </script>

    <style>
      :root {
        --reiki-ink: #12352c;
        --reiki-green: #0f6b4c;
        --reiki-green-2: #159a6a;
        --reiki-mint: #e8f6ef;
        --reiki-sand: #f7f3eb;
        --reiki-line: #d5e5dc;
        --reiki-muted: #5f766c;
        --reiki-card: rgba(255, 255, 255, 0.92);
        --reiki-shadow: 0 18px 40px rgba(18, 53, 44, 0.1);
      }
      * {
        box-sizing: border-box;
      }
      .admin-body {
        margin: 0;
        min-height: 100vh;
        font-family: Montserrat, 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: var(--reiki-ink);
        background: var(--reiki-sand);
      }
      .admin-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background:
          radial-gradient(900px 420px at 10% -10%, rgba(21, 154, 106, 0.18), transparent 60%),
          radial-gradient(700px 380px at 100% 0%, rgba(15, 107, 76, 0.14), transparent 55%),
          linear-gradient(180deg, #f3faf6 0%, #f7f3eb 45%, #eef5f1 100%);
        pointer-events: none;
      }
      .admin-main {
        position: relative;
        z-index: 1;
        max-width: 980px;
        margin: 0 auto;
        padding: 1.35rem 1rem 3.5rem;
      }
      .admin-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.35rem;
      }
      .admin-brand {
        display: flex;
        align-items: center;
        gap: 0.95rem;
      }
      .admin-logo {
        display: block;
        height: 46px;
        width: auto;
        object-fit: contain;
      }
      .admin-eyebrow {
        margin: 0 0 0.15rem;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--reiki-muted);
        font-weight: 700;
      }
      .admin-top h1 {
        margin: 0;
        font-size: clamp(1.25rem, 3vw, 1.7rem);
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .admin-login-card,
      .admin-filters,
      .admin-order {
        background: var(--reiki-card);
        border: 1px solid var(--reiki-line);
        border-radius: 18px;
        box-shadow: var(--reiki-shadow);
        backdrop-filter: blur(8px);
      }
      .admin-login-card {
        max-width: 420px;
        margin: 2.5rem auto 0;
        padding: 1.6rem 1.4rem 1.5rem;
        text-align: center;
      }
      .admin-login-mark {
        margin-bottom: 0.75rem;
      }
      .admin-login-card h2 {
        margin: 0 0 0.35rem;
        font-size: 1.25rem;
      }
      .admin-help {
        color: var(--reiki-muted);
        font-size: 0.92rem;
        margin: 0 0 1rem;
      }
      .admin-login-form {
        display: grid;
        gap: 0.8rem;
        text-align: left;
      }
      label {
        display: grid;
        gap: 0.35rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--reiki-muted);
      }
      input {
        font: inherit;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--reiki-line);
        border-radius: 12px;
        background: #fff;
        color: var(--reiki-ink);
      }
      input:focus {
        outline: 2px solid rgba(21, 154, 106, 0.35);
        border-color: var(--reiki-green-2);
      }
      .admin-btn {
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--reiki-green), var(--reiki-green-2));
        color: #fff;
        font: inherit;
        font-weight: 700;
        padding: 0.7rem 1.15rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-shadow: 0 10px 22px rgba(15, 107, 76, 0.22);
      }
      .admin-btn:disabled {
        opacity: 0.7;
        cursor: wait;
      }
      .admin-btn--block {
        width: 100%;
      }
      .admin-btn--ghost {
        background: transparent;
        color: var(--reiki-green);
        border: 1px solid var(--reiki-line);
        box-shadow: none;
      }
      .admin-btn--pdf {
        background: #fff;
        color: var(--reiki-green);
        border: 1px solid #b7d8c8;
        box-shadow: none;
      }
      .admin-btn--pdf:hover {
        background: var(--reiki-mint);
      }
      .admin-error {
        color: #a32020;
        margin-top: 0.85rem;
        font-size: 0.9rem;
      }
      .admin-filters {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.75rem 1rem;
        align-items: end;
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
      }
      .admin-filter-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .admin-status {
        margin: 0 0 0.85rem;
        color: var(--reiki-muted);
        font-weight: 600;
        font-size: 0.92rem;
      }
      .admin-list {
        display: grid;
        gap: 1rem;
      }
      .admin-order {
        padding: 1.1rem 1.15rem 1rem;
        overflow: hidden;
      }
      .admin-order-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        margin-bottom: 0.95rem;
      }
      .admin-order-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
      }
      .admin-order-meta time {
        font-size: 0.82rem;
        color: var(--reiki-muted);
        font-weight: 600;
        margin-left: 0.15rem;
      }
      .admin-pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.28rem 0.65rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
      }
      .admin-pill--gw {
        background: #12352c;
        color: #fff;
      }
      .admin-pill.is-ok {
        background: #d8f5e5;
        color: #0b6a45;
      }
      .admin-pill.is-wait {
        background: #fff3d6;
        color: #8a5b00;
      }
      .admin-pill.is-bad {
        background: #ffe1e1;
        color: #9b1c1c;
      }
      .admin-pill.is-neutral {
        background: #e8eee9;
        color: #456257;
      }
      .admin-order-total {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--reiki-green);
        white-space: nowrap;
      }
      .admin-order-body {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 1rem 1.25rem;
      }
      .admin-client h2 {
        margin: 0 0 0.35rem;
        font-size: 1.12rem;
        font-weight: 800;
      }
      .admin-phone-row {
        margin: 0 0 0.35rem;
      }
      .admin-phone {
        color: #128c7e;
        font-weight: 800;
        text-decoration: none;
        font-size: 1.05rem;
      }
      .admin-phone:hover {
        text-decoration: underline;
      }
      .admin-muted {
        margin: 0;
        color: var(--reiki-muted);
        font-size: 0.86rem;
        font-weight: 500;
      }
      .admin-ship {
        margin: 0.55rem 0 0;
        font-size: 0.88rem;
        color: var(--reiki-ink);
      }
      .admin-order-products h3 {
        margin: 0 0 0.45rem;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--reiki-muted);
      }
      .admin-items {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.35rem;
      }
      .admin-items li {
        background: var(--reiki-mint);
        border-radius: 10px;
        padding: 0.45rem 0.65rem;
        font-size: 0.9rem;
        font-weight: 600;
      }
      .admin-items li span {
        color: var(--reiki-green);
        font-weight: 800;
      }
      .admin-order-foot {
        margin-top: 1rem;
        padding-top: 0.85rem;
        border-top: 1px solid var(--reiki-line);
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
      }
      .admin-order-foot code {
        font-size: 0.72rem;
        color: var(--reiki-muted);
        word-break: break-all;
        max-width: 100%;
      }
      .admin-order-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      @media (max-width: 720px) {
        .admin-brand {
          align-items: flex-start;
        }
        .admin-logo {
          height: 38px;
        }
        .admin-order-body {
          grid-template-columns: 1fr;
        }
        .admin-order-head {
          flex-direction: column;
        }
      }
    </style>
  </body>
</html>
