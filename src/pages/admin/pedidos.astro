---
import SEO from '../../components/SEO.astro';
import FontAwesome from '../../components/FontAwesome.astro';
import pedidosMocks from '../../../data/admin-pedidos-mocks.json';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard pedidos | Reiki Admin</title>
    <FontAwesome />
    <SEO
      title="Dashboard pedidos | Reiki Admin"
      description="Gestión interna de pedidos web."
      canonical="/admin/pedidos"
      noindex={true}
      schemaType="WebPage"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['Montserrat', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
            colors: {
              reiki: {
                DEFAULT: '#6b2181',
                dark: '#4a1a5c',
                light: '#8b2a9b',
                mint: '#f5eef8',
                accent: '#f97316',
                sun: '#facc15',
              },
            },
          },
        },
      };
    </script>
  </head>
  <body class="dash-body is-login">
    <div class="dash-bg" aria-hidden="true"></div>

    <!-- LOGIN -->
    <section id="view-login" class="login-wrap">
      <div class="login-card">
        <img src="/images/logo.png" alt="Reiki Energía Solar" class="login-logo" width="150" height="45" />
        <h1>Panel de pedidos</h1>
        <p class="login-sub">Acceso exclusivo para el equipo Reiki</p>
        <form id="login-form" class="login-form">
          <label>
            Usuario
            <input type="text" id="login-user" name="user" autocomplete="username" value="admin" required />
          </label>
          <label>
            Contraseña
            <input
              type="password"
              id="login-pass"
              name="password"
              autocomplete="current-password"
              required
            />
          </label>
          <button type="submit" class="btn btn-primary btn-block">Entrar al dashboard</button>
        </form>
        <button type="button" id="btn-demo" class="btn btn-ghost btn-block">Ver demo con datos de prueba</button>
        <p id="login-error" class="login-error" hidden></p>
      </div>
    </section>

    <!-- DASHBOARD -->
    <div id="view-dash" class="dash-wrap" hidden>
      <header class="dash-top">
        <div class="dash-brand">
          <img src="/images/logo.png" alt="Reiki" class="dash-logo" />
          <div>
            <p class="dash-eyebrow">Reiki Energía Solar · interno</p>
            <h1>Compras y proyectos</h1>
          </div>
        </div>
        <div class="dash-top-actions">
          <button type="button" id="btn-refresh" class="btn btn-ghost"><i class="fas fa-sync-alt"></i> Actualizar</button>
          <button type="button" id="btn-logout" class="btn btn-ghost">Salir</button>
        </div>
      </header>

      <nav class="cat-tabs" role="tablist" aria-label="Categorías">
        <button type="button" class="cat-tab is-active" role="tab" data-cat="inicio">
          <i class="fas fa-home" aria-hidden="true"></i> Inicio
        </button>
        <button type="button" class="cat-tab" role="tab" data-cat="cotizaciones">
          <i class="fas fa-file-signature" aria-hidden="true"></i> Cotizaciones <span class="cat-count" data-count="cotizaciones"></span>
        </button>
        <button type="button" class="cat-tab" role="tab" data-cat="tienda">
          <i class="fas fa-store" aria-hidden="true"></i> Compras en tienda <span class="cat-count" data-count="tienda"></span>
        </button>
        <button type="button" class="cat-tab" role="tab" data-cat="proyecto">
          <i class="fas fa-solar-panel" aria-hidden="true"></i> Proyectos <span class="cat-count" data-count="proyecto"></span>
        </button>
        <button type="button" class="cat-tab" role="tab" data-cat="compras">
          <i class="fas fa-boxes" aria-hidden="true"></i> Por comprar <span class="cat-count" data-count="compras"></span>
        </button>
        <button type="button" class="cat-tab" role="tab" data-cat="desempeno">
          <i class="fas fa-chart-line" aria-hidden="true"></i> Desempeño
        </button>
        <button type="button" class="cat-tab" role="tab" data-cat="web">
          <i class="fas fa-shopping-cart" aria-hidden="true"></i> Pedidos web (carrito)
        </button>
      </nav>

      <div id="pane-inicio">
        <p id="in-status" class="dash-status" aria-live="polite"></p>
        <div id="in-body"></div>
      </div>

      <div id="pane-cotizaciones" hidden>
        <header class="pc-head">
          <h2>Cotizaciones</h2>
          <p>Todas las cotizaciones: las que hace Claude en cualquier chat y las que generan los clientes en la página o por WhatsApp. Envíalas, haz seguimiento y márcalas como aceptadas (se crea la venta) o rechazadas.</p>
        </header>
        <section class="toolbar">
          <div class="search-wrap">
            <i class="fas fa-search" aria-hidden="true"></i>
            <input type="search" id="ct-q" placeholder="Buscar cliente, número, ciudad o equipo…" autocomplete="off" />
          </div>
          <div class="toolbar-filters">
            <select id="ct-origen" aria-label="Origen">
              <option value="">Todos los orígenes</option>
              <option value="chat">Hechas por Claude</option>
              <option value="web">Página web</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="panel">Panel</option>
            </select>
          </div>
        </section>
        <p id="ct-status" class="dash-status" aria-live="polite"></p>
        <div id="ct-body"></div>
      </div>

      <div id="pane-seg" hidden>
        <section class="seg-metrics" id="seg-metrics" aria-label="Resumen"></section>
        <section class="toolbar">
          <div class="search-wrap">
            <i class="fas fa-search" aria-hidden="true"></i>
            <input type="search" id="seg-q" placeholder="Buscar cliente, cotización, equipo o proveedor…" autocomplete="off" />
          </div>
          <div class="toolbar-filters">
            <select id="seg-f-estado" aria-label="Estado">
              <option value="activo" selected>En curso</option>
              <option value="cerrado">Cerrados</option>
              <option value="cancelado">Cancelados</option>
              <option value="">Todos</option>
            </select>
            <button type="button" id="seg-nuevo" class="btn btn-primary"><i class="fas fa-plus"></i> Nueva venta aprobada</button>
          </div>
        </section>
        <p id="seg-status" class="dash-status" aria-live="polite"></p>
        <section id="seg-grid" class="seg-grid"></section>
      </div>

      <div id="pane-compras" hidden>
        <header class="pc-head">
          <h2>Equipos por comprar</h2>
          <p>Lo que hay que pedir a cada proveedor para cada proyecto o pedido. Marca cada equipo como pedido o recibido; el panel actualiza solo las etapas de la venta.</p>
        </header>
        <p id="pc-status" class="dash-status" aria-live="polite"></p>
        <div id="pc-body"></div>
      </div>

      <div id="pane-desempeno" hidden>
        <p id="de-status" class="dash-status" aria-live="polite"></p>
        <div id="de-body"></div>
      </div>

      <div id="pane-web" hidden>
      <section class="metrics" id="metrics" aria-label="Métricas"></section>

      <section class="toolbar">
        <div class="search-wrap">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input
            type="search"
            id="q-live"
            placeholder="Buscar por nombre, celular, cédula, pedido…"
            autocomplete="off"
          />
        </div>
        <div class="toolbar-filters">
          <select id="f-gateway" aria-label="Pasarela">
            <option value="">Todas las pasarelas</option>
            <option value="addi">Addi</option>
            <option value="wompi">Wompi</option>
          </select>
          <select id="f-dias" aria-label="Días">
            <option value="3">Últimos 3 días</option>
            <option value="7">Últimos 7 días</option>
            <option value="15">Últimos 15 días</option>
            <option value="30" selected>Últimos 30 días</option>
          </select>
          <div class="view-toggle" role="group" aria-label="Vista">
            <button type="button" class="view-btn is-active" data-view="kanban">Kanban</button>
            <button type="button" class="view-btn" data-view="lista">Lista</button>
          </div>
        </div>
      </section>

      <p id="dash-status" class="dash-status" aria-live="polite"></p>

      <section id="board-kanban" class="kanban"></section>
      <section id="board-lista" class="lista" hidden></section>
      </div>
    </div>

    <!-- MODAL DETALLE -->
    <div id="modal" class="modal" hidden>
      <div class="modal-backdrop" data-close="1"></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button type="button" class="modal-x" data-close="1" aria-label="Cerrar">&times;</button>
        <div id="modal-body"></div>
      </div>
    </div>

    <!-- MODAL SEGUIMIENTO -->
    <div id="seg-modal" class="modal" hidden>
      <div class="modal-backdrop" data-seg-close="1"></div>
      <div class="modal-card seg-modal-card" role="dialog" aria-modal="true" aria-labelledby="seg-modal-title">
        <button type="button" class="modal-x" data-seg-close="1" aria-label="Cerrar">&times;</button>
        <div id="seg-modal-body"></div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var LS_SECRET = 'reiki_admin_orders_secret';
        var LS_USER = 'reiki_admin_orders_user';
        var LS_DEMO = 'reiki_admin_orders_demo';
        var ESTADOS = [
          ['pendiente', 'Pendiente'],
          ['en_curso', 'En curso'],
          ['hecho', 'Hecho'],
          ['no_aplica', 'No aplica'],
        ];
        var PAGO_TXT = {
          completo: ['Pagado', 'ok'],
          parcial: ['Pago parcial', 'amber'],
          por_verificar: ['Pago por verificar', 'amber'],
          parcial_por_verificar: ['Parcial · por verificar', 'amber'],
          sin_pago: ['Sin pago', 'bad'],
        };

        var st = { cat: 'inicio', items: [], q: '', estado: 'activo', openId: null, loaded: false, meta: { correos: {}, conFecha: {}, correoConfigurado: true } };
        var $ = function (id) {
          return document.getElementById(id);
        };
        var el = {
          paneSeg: $('pane-seg'),
          paneWeb: $('pane-web'),
          grid: $('seg-grid'),
          metrics: $('seg-metrics'),
          status: $('seg-status'),
          q: $('seg-q'),
          fEstado: $('seg-f-estado'),
          modal: $('seg-modal'),
          body: $('seg-modal-body'),
        };

        function ls(k) {
          try {
            return sessionStorage.getItem(k) || '';
          } catch (_e) {
            return '';
          }
        }
        function isDemo() {
          return ls(LS_DEMO) === '1';
        }
        function headers(json) {
          var h = { Authorization: 'Bearer ' + ls(LS_SECRET), 'X-Admin-User': ls(LS_USER) || 'admin' };
          if (json) h['Content-Type'] = 'application/json';
          return h;
        }
        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }
        function cop(n) {
          return '$' + Math.round(Number(n) || 0).toLocaleString('es-CO');
        }
        function fecha(iso) {
          if (!iso) return '';
          var d = new Date(iso);
          if (isNaN(d.getTime())) return String(iso);
          return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short', timeZone: 'America/Bogota' });
        }

        async function api(op, body) {
          var res = await fetch('/api/seguimiento?op=' + op, {
            method: body ? 'POST' : 'GET',
            headers: headers(!!body),
            body: body ? JSON.stringify(body) : undefined,
          });
          var j = await res.json().catch(function () {
            return {};
          });
          if (!res.ok || !j.ok) throw new Error(j.error || 'Error ' + res.status);
          return j;
        }

        async function load() {
          if (isDemo()) {
            st.items = [];
            el.status.textContent = 'Modo demo: el seguimiento solo funciona con sesión real.';
            render();
            return;
          }
          el.status.textContent = 'Cargando…';
          try {
            var j = await api('list');
            st.items = j.expedientes || [];
            st.meta = { correos: j.correos || {}, conFecha: j.conFecha || {}, correoConfigurado: !!j.correoConfigurado, alegraConfigurado: !!j.alegraConfigurado };
            st.loaded = true;
            el.status.textContent = '';
          } catch (e) {
            el.status.textContent = 'No se pudo cargar el seguimiento: ' + e.message;
          }
          render();
          if (st.openId) openDetail(st.openId);
        }

        function upsert(exp) {
          var i = st.items.findIndex(function (x) {
            return x.id === exp.id;
          });
          if (i >= 0) st.items[i] = exp;
          else st.items.unshift(exp);
        }

        function visibles() {
          var q = st.q.toLowerCase();
          return st.items.filter(function (e) {
            if (e.tipo !== st.cat) return false;
            if (st.estado && e.estado !== st.estado) return false;
            if (!q) return true;
            var hay = [
              e.titulo,
              e.id,
              e.cliente && e.cliente.nombre,
              e.cliente && e.cliente.documento,
              e.cliente && e.cliente.ciudad,
              e.cotizacion && e.cotizacion.numero,
            ]
              .concat(
                (e.items || []).map(function (i) {
                  return i.nombre + ' ' + i.proveedor;
                })
              )
              .join(' ')
              .toLowerCase();
            return hay.indexOf(q) >= 0;
          });
        }

        function render() {
          ['tienda', 'proyecto'].forEach(function (t) {
            var n = st.items.filter(function (e) {
              return e.tipo === t && e.estado === 'activo';
            }).length;
            var c = document.querySelector('[data-count="' + t + '"]');
            if (c) c.textContent = n ? String(n) : '';
          });
          var activos = st.items.filter(function (e) {
            return e.tipo === st.cat && e.estado === 'activo';
          });
          var porVerificar = 0;
          var saldo = 0;
          var sinProv = 0;
          activos.forEach(function (e) {
            porVerificar += e.resumen.porVerificar || 0;
            saldo += e.resumen.saldo || 0;
            (e.items || []).forEach(function (i) {
              if (!i.proveedor || i.proveedor === 'Por confirmar') sinProv++;
            });
          });
          el.metrics.innerHTML =
            metric('En curso', activos.length) +
            metric('Saldo por cobrar', cop(saldo)) +
            metric('Pagos por verificar', cop(porVerificar)) +
            metric('Equipos sin proveedor', sinProv);

          var list = visibles();
          if (!list.length) {
            el.grid.innerHTML =
              '<div class="seg-empty"><p>' +
              (st.cat === 'proyecto' ? 'No hay proyectos en esta vista.' : 'No hay compras en esta vista.') +
              '</p><p class="seg-hint">Cuando se apruebe una cotización, créala con “Nueva venta aprobada” o pídeselo a Claude. Los pedidos web pagados entran solos.</p></div>';
            return;
          }
          el.grid.innerHTML = list.map(card).join('');
          el.grid.querySelectorAll('[data-exp]').forEach(function (n) {
            n.addEventListener('click', function () {
              openDetail(n.getAttribute('data-exp'));
            });
            n.addEventListener('keydown', function (ev) {
              if (ev.key === 'Enter') openDetail(n.getAttribute('data-exp'));
            });
          });
        }

        function metric(label, v) {
          return '<div class="seg-metric"><span>' + esc(label) + '</span><strong>' + esc(v) + '</strong></div>';
        }

        function provChips(e) {
          return Object.keys(e.resumen.proveedores || {})
            .map(function (p) {
              return '<span class="prov-chip' + (p === 'Por confirmar' ? ' prov-chip--pend' : '') + '">' + esc(p) + '</span>';
            })
            .join(' ');
        }

        function card(e) {
          var r = e.resumen;
          var pago = PAGO_TXT[r.estadoPago] || ['', ''];
          return (
            '<article class="seg-card" tabindex="0" data-exp="' +
            esc(e.id) +
            '">' +
            '<div class="seg-card-head"><span class="oc-badge oc-badge--' +
            pago[1] +
            '">' +
            esc(pago[0]) +
            '</span><span class="seg-id">' +
            esc(e.cotizacion && e.cotizacion.numero ? e.cotizacion.numero : e.id) +
            '</span></div>' +
            '<h3>' +
            esc(e.titulo) +
            '</h3>' +
            '<p class="seg-sub">' +
            esc([e.cliente && e.cliente.ciudad, e.origen === 'web' ? 'Pedido web' : ''].filter(Boolean).join(' · ')) +
            '</p>' +
            '<div class="seg-bar" aria-label="Avance ' +
            r.avance +
            '%"><span style="width:' +
            r.avance +
            '%"></span></div>' +
            '<p class="seg-progress">' +
            r.hechas +
            ' de ' +
            r.totalEtapas +
            ' etapas · ' +
            r.avance +
            '%</p>' +
            (r.siguiente
              ? '<p class="seg-next"><i class="fas fa-arrow-right" aria-hidden="true"></i> ' + esc(r.siguiente.label) + '</p>'
              : '<p class="seg-next seg-next--done"><i class="fas fa-check" aria-hidden="true"></i> Todas las etapas cerradas</p>') +
            '<div class="seg-card-foot"><div class="seg-provs">' +
            provChips(e) +
            '</div><strong>' +
            cop(r.total) +
            '</strong></div>' +
            '</article>'
          );
        }

        function field(name, label, value, type) {
          return (
            '<label class="seg-field"><span>' +
            esc(label) +
            '</span><input name="' +
            name +
            '" type="' +
            (type || 'text') +
            '" value="' +
            esc(value || '') +
            '" /></label>'
          );
        }

        function openDetail(id) {
          var e = st.items.find(function (x) {
            return x.id === id;
          });
          if (!e) return;
          st.openId = id;
          var r = e.resumen;
          var c = e.cliente || {};
          var pago = PAGO_TXT[r.estadoPago] || ['', ''];

          var conCorreo = st.meta.correos[e.tipo] || [];
          var conFecha = st.meta.conFecha[e.tipo] || [];
          var etapas = (e.etapas || [])
            .map(function (et, i) {
              var mails = conCorreo
                .filter(function (k) {
                  return k.split(':')[0] === et.key;
                })
                .map(function (k) {
                  return k.split(':')[1] === 'hecho' ? 'Hecho' : 'En curso';
                });
              var mailTag = mails.length
                ? '<span class="seg-mail-tag" title="Al marcarla así se envía un correo al cliente"><i class="fas fa-envelope" aria-hidden="true"></i> Correo al cliente: ' + mails.join(' / ') + '</span>'
                : '';
              var fechaInp =
                conFecha.indexOf(et.key) >= 0
                  ? '<label class="seg-fecha-cli">Fecha para el cliente <input type="date" data-fecha="' + esc(et.key) + '" value="' + esc(et.fechaCliente || '') + '" /></label>'
                  : '';
              return (
                '<li class="seg-step seg-step--' +
                et.estado +
                '"><div class="seg-step-n">' +
                (i + 1) +
                '</div><div class="seg-step-main"><strong>' +
                esc(et.label) +
                '</strong>' +
                (et.fecha ? '<small>' + esc(fecha(et.fecha)) + '</small>' : '') +
                mailTag +
                fechaInp +
                '<input class="seg-step-note" data-note="' +
                esc(et.key) +
                '" placeholder="Nota interna (no se envía al cliente)" value="' +
                esc(et.nota || '') +
                '" /></div><select data-etapa="' +
                esc(et.key) +
                '" aria-label="Estado de ' +
                esc(et.label) +
                '">' +
                ESTADOS.map(function (o) {
                  return '<option value="' + o[0] + '"' + (o[0] === et.estado ? ' selected' : '') + '>' + o[1] + '</option>';
                }).join('') +
                '</select></li>'
              );
            })
            .join('');

          var pagos = (e.pagos || []).length
            ? (e.pagos || [])
                .map(function (p) {
                  return (
                    '<tr><td>' +
                    esc(p.fecha) +
                    '</td><td>' +
                    esc(p.medio) +
                    (p.referencia ? '<br><small>' + esc(p.referencia) + '</small>' : '') +
                    '</td><td>' +
                    cop(p.monto) +
                    '</td><td>' +
                    (p.estado === 'verificado'
                      ? '<span class="oc-badge oc-badge--ok">Verificado</span>'
                      : '<button type="button" class="btn btn-secondary seg-mini" data-verificar="' + esc(p.id) + '">Marcar verificado</button>') +
                    '</td></tr>'
                  );
                })
                .join('')
            : '<tr><td colspan="4" class="notes-empty">Sin pagos registrados.</td></tr>';

          var porProv = Object.keys(r.proveedores || {})
            .map(function (p) {
              return (
                '<div class="prov-grupo"><span class="prov-chip' +
                (p === 'Por confirmar' ? ' prov-chip--pend' : '') +
                '">' +
                esc(p) +
                '</span><ul>' +
                r.proveedores[p]
                  .map(function (x) {
                    return '<li>' + esc(x) + '</li>';
                  })
                  .join('') +
                '</ul></div>'
              );
            })
            .join('');

          var items = (e.items || [])
            .map(function (it, i) {
              return (
                '<tr><td>' +
                esc(it.cantidad) +
                '</td><td>' +
                esc(it.nombre) +
                '</td><td><input class="seg-prov-input" data-item-prov="' +
                i +
                '" value="' +
                esc(it.proveedor) +
                '" aria-label="Proveedor" /></td><td><input class="seg-prov-input" type="number" min="0" data-item-costo="' +
                i +
                '" value="' +
                esc(it.costoUnit || '') +
                '" placeholder="Costo unit." aria-label="Costo unitario" /></td><td>' +
                cop(it.precioUnit * it.cantidad) +
                '</td></tr>'
              );
            })
            .join('');

          var correosLog = (e.correos || [])
            .slice(0, 10)
            .map(function (c) {
              return (
                '<li><time>' +
                esc(fecha(c.at)) +
                '</time> ' +
                (c.estado === 'enviado'
                  ? '<span class="oc-badge oc-badge--ok">Enviado</span> ' + esc(c.asunto)
                  : '<span class="oc-badge oc-badge--bad">No enviado</span> ' +
                    esc(c.etapa) +
                    ': ' +
                    esc(c.motivo) +
