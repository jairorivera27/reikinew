---
import SEO from '../../components/SEO.astro';
import FontAwesome from '../../components/FontAwesome.astro';
import pedidosMocks from '../../../data/admin-pedidos-mocks.json';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard pedidos | Reiki Admin</title>
    <FontAwesome />
    <SEO
      title="Dashboard pedidos | Reiki Admin"
      description="Gestión interna de pedidos web."
      canonical="/admin/pedidos"
      noindex={true}
      schemaType="WebPage"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['Montserrat', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
            colors: {
              reiki: { DEFAULT: '#0f6b4c', dark: '#12352c', mint: '#e7f6ef' },
            },
          },
        },
      };
    </script>
  </head>
  <body class="dash-body is-login">
    <div class="dash-bg" aria-hidden="true"></div>

    <!-- LOGIN -->
    <section id="view-login" class="login-wrap">
      <div class="login-card">
        <img src="/images/logo.png" alt="Reiki Energía Solar" class="login-logo" width="150" height="45" />
        <h1>Panel de pedidos</h1>
        <p class="login-sub">Acceso exclusivo para el equipo Reiki</p>
        <form id="login-form" class="login-form">
          <label>
            Usuario
            <input type="text" id="login-user" name="user" autocomplete="username" value="admin" required />
          </label>
          <label>
            Contraseña
            <input
              type="password"
              id="login-pass"
              name="password"
              autocomplete="current-password"
              required
            />
          </label>
          <button type="submit" class="btn btn-primary btn-block">Entrar al dashboard</button>
        </form>
        <button type="button" id="btn-demo" class="btn btn-ghost btn-block">Ver demo con datos de prueba</button>
        <p id="login-error" class="login-error" hidden></p>
      </div>
    </section>

    <!-- DASHBOARD -->
    <div id="view-dash" class="dash-wrap" hidden>
      <header class="dash-top">
        <div class="dash-brand">
          <img src="/images/logo.png" alt="Reiki" class="dash-logo" />
          <div>
            <p class="dash-eyebrow">Reiki Energía Solar · interno</p>
            <h1>Pedidos web</h1>
          </div>
        </div>
        <div class="dash-top-actions">
          <button type="button" id="btn-refresh" class="btn btn-ghost"><i class="fas fa-sync-alt"></i> Actualizar</button>
          <button type="button" id="btn-logout" class="btn btn-ghost">Salir</button>
        </div>
      </header>

      <section class="metrics" id="metrics" aria-label="Métricas"></section>

      <section class="toolbar">
        <div class="search-wrap">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input
            type="search"
            id="q-live"
            placeholder="Buscar por nombre, celular, cédula, pedido…"
            autocomplete="off"
          />
        </div>
        <div class="toolbar-filters">
          <select id="f-gateway" aria-label="Pasarela">
            <option value="">Todas las pasarelas</option>
            <option value="addi">Addi</option>
            <option value="wompi">Wompi</option>
          </select>
          <select id="f-dias" aria-label="Días">
            <option value="3">Últimos 3 días</option>
            <option value="7" selected>Últimos 7 días</option>
            <option value="15">Últimos 15 días</option>
            <option value="30">Últimos 30 días</option>
          </select>
          <div class="view-toggle" role="group" aria-label="Vista">
            <button type="button" class="view-btn is-active" data-view="kanban">Kanban</button>
            <button type="button" class="view-btn" data-view="lista">Lista</button>
          </div>
        </div>
      </section>

      <p id="dash-status" class="dash-status" aria-live="polite"></p>

      <section id="board-kanban" class="kanban"></section>
      <section id="board-lista" class="lista" hidden></section>
    </div>

    <!-- MODAL DETALLE -->
    <div id="modal" class="modal" hidden>
      <div class="modal-backdrop" data-close="1"></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button type="button" class="modal-x" data-close="1" aria-label="Cerrar">&times;</button>
        <div id="modal-body"></div>
      </div>
    </div>

    <script is:inline define:vars={{ MOCKS: pedidosMocks }}>
      (function () {
        var MOCKS_DATA = Array.isArray(MOCKS) ? MOCKS : [];

        var LS_SECRET = 'reiki_admin_orders_secret';
        var LS_USER = 'reiki_admin_orders_user';
        var LS_DEMO = 'reiki_admin_orders_demo';

        var state = {
          orders: [],
          view: 'kanban',
          query: '',
          gateway: '',
          selectedId: null,
          demo: false,
        };

        var el = {
          login: document.getElementById('view-login'),
          dash: document.getElementById('view-dash'),
          loginForm: document.getElementById('login-form'),
          loginErr: document.getElementById('login-error'),
          metrics: document.getElementById('metrics'),
          status: document.getElementById('dash-status'),
          kanban: document.getElementById('board-kanban'),
          lista: document.getElementById('board-lista'),
          modal: document.getElementById('modal'),
          modalBody: document.getElementById('modal-body'),
          q: document.getElementById('q-live'),
          gateway: document.getElementById('f-gateway'),
          dias: document.getElementById('f-dias'),
        };

        function getSecret() {
          try {
            return String(sessionStorage.getItem(LS_SECRET) || '').trim();
          } catch (_e) {
            return '';
          }
        }
        function getUser() {
          try {
            return String(sessionStorage.getItem(LS_USER) || 'admin').trim() || 'admin';
          } catch (_e) {
            return 'admin';
          }
        }
        function isDemo() {
          try {
            return sessionStorage.getItem(LS_DEMO) === '1';
          } catch (_e) {
            return false;
          }
        }
        function setSession(user, secret, demo) {
          try {
            if (demo) {
              sessionStorage.setItem(LS_DEMO, '1');
              sessionStorage.removeItem(LS_SECRET);
              sessionStorage.setItem(LS_USER, 'demo');
            } else {
              sessionStorage.removeItem(LS_DEMO);
              sessionStorage.setItem(LS_SECRET, secret);
              sessionStorage.setItem(LS_USER, user || 'admin');
            }
          } catch (_e) {}
        }
        function clearSession() {
          try {
            sessionStorage.removeItem(LS_SECRET);
            sessionStorage.removeItem(LS_USER);
            sessionStorage.removeItem(LS_DEMO);
          } catch (_e) {}
        }

        function authHeaders() {
          return {
            Authorization: 'Bearer ' + getSecret(),
            'X-Admin-User': getUser(),
            'Content-Type': 'application/json',
          };
        }

        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }
        function formatCop(n) {
          var v = Math.round(Number(n) || 0);
          return v ? '$ ' + v.toLocaleString('es-CO') : '—';
        }
        function formatWhen(iso) {
          if (!iso) return '—';
          try {
            return new Date(iso).toLocaleString('es-CO', {
              timeZone: 'America/Bogota',
              day: '2-digit',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
            });
          } catch (_e) {
            return String(iso);
          }
        }
        function todayBogota() {
          return new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
        }
        function isToday(iso) {
          if (!iso) return false;
          try {
            return (
              new Date(iso).toLocaleDateString('en-CA', { timeZone: 'America/Bogota' }) === todayBogota()
            );
          } catch (_e) {
            return false;
          }
        }
        function workflowOf(o) {
          return String(o.workflowStatus || 'nuevo').toLowerCase();
        }
        function waLink(phone) {
          var dig = String(phone || '').replace(/\D/g, '');
          if (dig.length === 10 && dig.charAt(0) === '3') dig = '57' + dig;
          return dig ? 'https://wa.me/' + dig : '';
        }
        function itemsSubtotal(items) {
          return (items || []).reduce(function (acc, it) {
            return acc + Math.round(Number(it.unitPrice || 0) * (Number(it.quantity) || 1));
          }, 0);
        }

        function filteredOrders() {
          var q = state.query.trim().toLowerCase();
          return state.orders.filter(function (o) {
            if (state.gateway && String(o.gateway || '').toLowerCase() !== state.gateway) return false;
            if (!q) return true;
            var hay = [
              o.orderId,
              o.client && o.client.fullName,
              o.client && o.client.phone,
              o.client && o.client.email,
              o.client && o.client.idNumber,
              o.shippingAddress && o.shippingAddress.city,
              (o.items || []).map(function (i) {
                return i.name || i.title;
              }).join(' '),
            ]
              .join(' ')
              .toLowerCase();
            return hay.indexOf(q) !== -1;
          });
        }

        function computeMetrics(orders) {
          var nuevos = 0;
          var revision = 0;
          var cerradoHoy = 0;
          var valorHoy = 0;
          orders.forEach(function (o) {
            var w = workflowOf(o);
            if (w === 'nuevo') nuevos += 1;
            if (w === 'en_revision') revision += 1;
            var when = o.paidAt || o.createdAt;
            if (isToday(when) && (String(o.status).toLowerCase() === 'approved' || w === 'cerrado')) {
              cerradoHoy += 1;
              valorHoy += Math.round(Number(o.totalAmount) || 0);
            } else if (isToday(when) && String(o.status).toLowerCase() === 'approved') {
              valorHoy += Math.round(Number(o.totalAmount) || 0);
            }
          });
          // Valor cerrado hoy: pedidos con paidAt hoy o workflow cerrado hoy
          valorHoy = 0;
          cerradoHoy = 0;
          orders.forEach(function (o) {
            var when = o.paidAt || o.updatedAt || o.createdAt;
            if (!isToday(when)) return;
            if (workflowOf(o) === 'cerrado' || String(o.status || '').toLowerCase() === 'approved') {
              valorHoy += Math.round(Number(o.totalAmount) || 0);
              if (workflowOf(o) === 'cerrado' || String(o.status || '').toLowerCase() === 'approved') {
                cerradoHoy += 1;
              }
            }
          });
          return { nuevos: nuevos, revision: revision, cerradoHoy: cerradoHoy, valorHoy: valorHoy, total: orders.length };
        }

        function renderMetrics() {
          var m = computeMetrics(filteredOrders());
          var card =
            'bg-white p-5 rounded-xl shadow-sm border border-gray-200 flex flex-col text-left';
          el.metrics.className = 'grid grid-cols-1 md:grid-cols-4 gap-4 mb-8';
          el.metrics.innerHTML =
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Nuevos</p><strong class="mt-1 block text-2xl font-extrabold text-gray-900">' +
            m.nuevos +
            '</strong></div>' +
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">En revisión</p><strong class="mt-1 block text-2xl font-extrabold text-gray-900">' +
            m.revision +
            '</strong></div>' +
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Cerrados / pagos hoy</p><strong class="mt-1 block text-2xl font-extrabold text-gray-900">' +
            m.cerradoHoy +
            '</strong></div>' +
            '<div class="' +
            card +
            '"><p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Valor hoy</p><strong class="mt-1 block text-xl font-extrabold text-emerald-600">' +
            (m.valorHoy ? formatCop(m.valorHoy) : '—') +
            '</strong></div>';
        }

        function formatCardDate(iso) {
          if (!iso) return '—';
          try {
            return new Date(iso).toLocaleDateString('es-CO', {
              timeZone: 'America/Bogota',
              day: 'numeric',
              month: 'short',
            });
          } catch (_e) {
            return String(iso);
          }
        }

        function statusBadge(o) {
          var s = String(o.status || '').toLowerCase();
          var gw = String(o.gateway || '').toUpperCase() || '—';
          var label = payLabel(o.status);
          var tone = 'oc-badge--amber';
          if (s === 'approved' || s === 'completed') tone = 'oc-badge--ok';
          else if (s.indexOf('reject') !== -1 || s.indexOf('declin') !== -1 || s === 'abandoned')
            tone = 'oc-badge--bad';
          return (
            '<span class="oc-badge ' +
            tone +
            '">' +
            esc(gw + ' · ' + label) +
            '</span>'
          );
        }

        function payLabel(st) {
          var s = String(st || '').toLowerCase();
          if (s === 'approved' || s === 'completed') return 'Aprobado';
          if (s === 'pending_verify') return 'Por verificar';
          if (s === 'pending') return 'Pendiente';
          if (s.indexOf('reject') !== -1 || s.indexOf('declin') !== -1) return 'Rechazado';
          if (s === 'abandoned') return 'Abandonado';
          return st || '—';
        }

        function cardHtml(o) {
          var phone = (o.client && o.client.phone) || '';
          var doc =
            (o.client &&
              (o.client.document || o.client.docNumber || o.client.cedula || o.client.idNumber)) ||
            '';
          var name = (o.client && o.client.fullName) || 'Cliente';
          var items = o.items || [];
          var preview = items
            .slice(0, 2)
            .map(function (it) {
              return (it.quantity || 1) + 'x ' + (it.name || it.title || 'Producto');
            })
            .join(' · ');
          var meta = [phone, doc].filter(Boolean).join(' · ') || 'Sin celular / cédula';
          var wa = waLink(phone);
          return (
            '<div class="order-card oc-card" data-id="' +
            esc(o.orderId) +
            '" role="button" tabindex="0">' +
            '<div class="oc-head">' +
            statusBadge(o) +
            '<span class="oc-date">' +
            esc(formatCardDate(o.paidAt || o.createdAt)) +
            '</span></div>' +
            '<div class="oc-body">' +
            '<h3 class="oc-name">' +
            esc(name) +
            '</h3>' +
            '<p class="oc-meta">' +
            esc(meta) +
            '</p>' +
            '<div class="oc-product">' +
            esc(preview || 'Sin equipos') +
            '</div></div>' +
            '<div class="oc-price">' +
            esc(formatCop(o.totalAmount)) +
            '</div>' +
            '<div class="oc-actions">' +
            (wa
              ? '<a href="' +
                wa +
                '" target="_blank" rel="noopener" data-stop="1" class="oc-btn oc-btn-wa"><i class="fab fa-whatsapp"></i> WhatsApp</a>'
              : '<span class="oc-btn oc-btn-disabled">Sin WhatsApp</span>') +
            '<button type="button" data-pdf="' +
            esc(o.orderId) +
            '" data-stop="1" class="oc-btn oc-btn-sec">PDF</button>' +
            '<button type="button" data-open="' +
            esc(o.orderId) +
            '" class="oc-btn oc-btn-sec">Detalle</button>' +
            '</div></div>'
          );
        }

        function renderKanban() {
          var cols = [
            { key: 'nuevo', title: 'Nuevo', hint: 'Por contactar' },
            { key: 'en_revision', title: 'En revisión', hint: 'En gestión' },
            { key: 'cerrado', title: 'Cerrado', hint: 'Listo / despachado' },
          ];
          var list = filteredOrders();
          el.kanban.className = 'grid grid-cols-1 md:grid-cols-3 gap-6 items-start';
          el.kanban.innerHTML = cols
            .map(function (col) {
              var items = list.filter(function (o) {
                return workflowOf(o) === col.key;
              });
              return (
                '<div class="bg-gray-100/50 p-4 rounded-xl min-h-[500px] flex flex-col gap-4" data-col="' +
                col.key +
                '">' +
                '<header class="shrink-0">' +
                '<h2 class="m-0 text-sm font-extrabold text-gray-800 flex items-center gap-2">' +
                esc(col.title) +
                ' <em class="not-italic text-xs font-bold bg-white text-emerald-700 border border-emerald-100 rounded-full px-2 py-0.5">' +
                items.length +
                '</em></h2>' +
                '<span class="text-xs font-medium text-gray-400">' +
                esc(col.hint) +
                '</span></header>' +
                '<div class="flex flex-col gap-4">' +
                (items.length
                  ? items.map(cardHtml).join('')
                  : '<p class="text-center text-sm text-gray-400 py-8">Sin pedidos</p>') +
                '</div></div>'
              );
            })
            .join('');
          bindCards(el.kanban);
        }

        function renderLista() {
          var list = filteredOrders();
          el.lista.className = '';
          if (!list.length) {
            el.lista.innerHTML = '<p class="text-center text-sm text-gray-400 py-8">Sin pedidos</p>';
            return;
          }
          el.lista.innerHTML =
            '<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">' +
            list.map(cardHtml).join('') +
            '</div>';
          bindCards(el.lista);
        }

        function bindCards(root) {
          root.querySelectorAll('.order-card').forEach(function (card) {
            card.addEventListener('click', function (e) {
              var t = e.target;
              if (t && t.closest && t.closest('[data-stop]')) return;
              openModal(card.getAttribute('data-id'));
            });
            card.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                openModal(card.getAttribute('data-id'));
              }
            });
          });
          root.querySelectorAll('[data-pdf]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              openPdf(btn.getAttribute('data-pdf'), btn);
            });
          });
          root.querySelectorAll('[data-open]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              openModal(btn.getAttribute('data-open'));
            });
          });
          root.querySelectorAll('a[data-stop]').forEach(function (a) {
            a.addEventListener('click', function (e) {
              e.stopPropagation();
            });
          });
        }

        function renderAll() {
          renderMetrics();
          if (state.view === 'kanban') {
            el.kanban.hidden = false;
            el.lista.hidden = true;
            renderKanban();
          } else {
            el.kanban.hidden = true;
            el.lista.hidden = false;
            renderLista();
          }
          el.status.textContent =
            filteredOrders().length +
            ' de ' +
            state.orders.length +
            ' pedidos' +
            (state.demo ? ' · modo demo' : '');
        }

        function findOrder(id) {
          return state.orders.find(function (o) {
            return o.orderId === id;
          });
        }

        function openModal(id) {
          var o = findOrder(id);
          if (!o) return;
          state.selectedId = id;
          var c = o.client || {};
          var ship = o.shippingAddress || {};
          var items = o.items || [];
          var sub = itemsSubtotal(items) || Number(o.totalAmount) || 0;
          var wa = waLink(c.phone);
          var wf = workflowOf(o);

          var itemsRows = items.length
            ? items
                .map(function (it) {
                  var line = Math.round(Number(it.unitPrice || 0) * (Number(it.quantity) || 1));
                  return (
                    '<tr><td>' +
                    esc(it.name || it.title || it.sku) +
                    '</td><td>' +
                    esc(it.quantity || 1) +
                    '</td><td>' +
                    esc(formatCop(it.unitPrice)) +
                    '</td><td>' +
                    esc(formatCop(line)) +
                    '</td></tr>'
                  );
                })
                .join('')
            : '<tr><td colspan="4">Sin detalle de equipos</td></tr>';

          el.modalBody.innerHTML =
            '<p class="modal-kicker">' +
            esc(String(o.gateway || '').toUpperCase()) +
            ' · ' +
            esc(o.status || '—') +
            '</p>' +
            '<h2 id="modal-title">' +
            esc(c.fullName || 'Pedido') +
            '</h2>' +
            '<p class="modal-when">' +
            esc(formatWhen(o.paidAt || o.createdAt)) +
            ' · ID <code>' +
            esc(o.orderId) +
            '</code></p>' +
            '<div class="modal-grid">' +
            '<section class="modal-block">' +
            '<h3>Datos del cliente</h3>' +
            '<dl>' +
            '<div><dt>Nombre</dt><dd>' +
            esc(c.fullName || '—') +
            '</dd></div>' +
            '<div><dt>Celular</dt><dd>' +
            esc(c.phone || '—') +
            '</dd></div>' +
            '<div><dt>Correo</dt><dd>' +
            esc(c.email || '—') +
            '</dd></div>' +
            '<div><dt>Documento</dt><dd>CC ' +
            esc(c.idNumber || '—') +
            '</dd></div>' +
            '<div><dt>Dirección</dt><dd>' +
            esc([ship.lineOne, ship.city, ship.department].filter(Boolean).join(', ') || '—') +
            '</dd></div>' +
            '</dl>' +
            '</section>' +
            '<section class="modal-block">' +
            '<h3>Cotización de la compra</h3>' +
            '<div class="table-wrap"><table><thead><tr><th>Equipo</th><th>Cant.</th><th>Unit.</th><th>Total</th></tr></thead><tbody>' +
            itemsRows +
            '</tbody></table></div>' +
            '<div class="totals">' +
            '<div><span>Subtotal equipos</span><strong>' +
            esc(formatCop(sub)) +
            '</strong></div>' +
            '<div><span>Total pedido</span><strong class="total-big">' +
            esc(formatCop(o.totalAmount || sub)) +
            '</strong></div>' +
            '</div>' +
            '</section>' +
            '</div>' +
            '<div class="modal-actions">' +
            (wa
              ? '<a class="btn btn-wa" href="' +
                wa +
                '" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> Contactar cliente</a>'
              : '') +
            '<button type="button" class="btn btn-ghost" data-pdf="' +
            esc(o.orderId) +
            '"><i class="fas fa-file-pdf"></i> Ver PDF</button>' +
            (wf !== 'en_revision'
              ? '<button type="button" class="btn btn-secondary" data-wf="en_revision">En revisión</button>'
              : '') +
            (wf !== 'cerrado'
              ? '<button type="button" class="btn btn-primary" data-wf="cerrado">Marcar cerrado</button>'
              : '') +
            (wf !== 'nuevo'
              ? '<button type="button" class="btn btn-ghost" data-wf="nuevo">Volver a nuevo</button>'
              : '') +
            '</div>';

          el.modal.hidden = false;
          document.body.style.overflow = 'hidden';

          el.modalBody.querySelectorAll('[data-wf]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              setWorkflow(o.orderId, btn.getAttribute('data-wf'));
            });
          });
          var pdfBtn = el.modalBody.querySelector('[data-pdf]');
          if (pdfBtn) {
            pdfBtn.addEventListener('click', function () {
              openPdf(o.orderId, pdfBtn);
            });
          }
        }

        function closeModal() {
          el.modal.hidden = true;
          document.body.style.overflow = '';
          state.selectedId = null;
        }

        async function setWorkflow(orderId, workflowStatus) {
          if (state.demo) {
            var o = findOrder(orderId);
            if (o) {
              o.workflowStatus = workflowStatus;
              o.workflowUpdatedAt = new Date().toISOString();
            }
            renderAll();
            openModal(orderId);
            return;
          }
          try {
            var res = await fetch('/api/order-status', {
              method: 'POST',
              headers: authHeaders(),
              body: JSON.stringify({ orderId: orderId, workflowStatus: workflowStatus }),
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (!res.ok || !json.ok) {
              alert(json.error || 'No se pudo actualizar el estado.');
              return;
            }
            var idx = state.orders.findIndex(function (x) {
              return x.orderId === orderId;
            });
            if (idx >= 0 && json.order) state.orders[idx] = json.order;
            else if (idx >= 0) state.orders[idx].workflowStatus = workflowStatus;
            renderAll();
            openModal(orderId);
          } catch (_e) {
            alert('Error de red al actualizar.');
          }
        }

        async function openPdf(orderId, btn) {
          if (state.demo) {
            alert('En modo demo el PDF real se genera solo con pedidos de producción.');
            return;
          }
          var prev = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando…';
          try {
            var res = await fetch('/api/order-pdf?orderId=' + encodeURIComponent(orderId), {
              headers: authHeaders(),
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (!res.ok || !json.pdfUrl) {
              alert(json.error || 'No se pudo generar el PDF.');
              return;
            }
            window.open(json.pdfUrl, '_blank', 'noopener');
          } catch (_e) {
            alert('Error de red al generar PDF.');
          } finally {
            btn.disabled = false;
            btn.innerHTML = prev;
          }
        }

        async function loadOrders() {
          state.demo = isDemo();
          if (state.demo) {
            state.orders = MOCKS_DATA.slice();
            renderAll();
            return;
          }
          el.status.textContent = 'Cargando pedidos…';
          try {
            var res = await fetch('/api/orders-search?dias=' + encodeURIComponent(el.dias.value || '7'), {
              headers: authHeaders(),
            });
            var json = await res.json().catch(function () {
              return {};
            });
            if (res.status === 401) {
              clearSession();
              showLogin(json.error || 'Sesión inválida. Vuelve a entrar.');
              return;
            }
            if (!res.ok || !json.ok) {
              el.status.textContent = json.error || 'Error al cargar.';
              return;
            }
            state.orders = (json.orders || []).map(function (o) {
              return Object.assign({}, o, {
                workflowStatus: o.workflowStatus || 'nuevo',
              });
            });
            renderAll();
          } catch (_e) {
            el.status.textContent = 'No se pudo contactar el servidor.';
          }
        }

        function setView(mode) {
          var isDash = mode === 'dash';
          document.body.classList.toggle('is-dashboard', isDash);
          document.body.classList.toggle('is-login', !isDash);
          el.login.hidden = isDash;
          el.dash.hidden = !isDash;
          el.login.setAttribute('aria-hidden', isDash ? 'true' : 'false');
          el.dash.setAttribute('aria-hidden', isDash ? 'false' : 'true');
          window.scrollTo(0, 0);
          if (isDash) {
            el.dash.classList.remove('view-enter');
            void el.dash.offsetWidth;
            el.dash.classList.add('view-enter');
          } else {
            el.login.classList.remove('view-enter');
            void el.login.offsetWidth;
            el.login.classList.add('view-enter');
          }
        }

        function showLogin(msg) {
          setView('login');
          closeModal();
          el.loginErr.hidden = !msg;
          el.loginErr.textContent = msg || '';
        }
        function showDash() {
          setView('dash');
          loadOrders();
        }

        el.loginForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var user = String(document.getElementById('login-user').value || '').trim() || 'admin';
          var pass = String(document.getElementById('login-pass').value || '').trim();
          if (!pass) return;
          var submitBtn = el.loginForm.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Entrando…';
          }
          setSession(user, pass, false);
          // Probar auth con una búsqueda corta
          fetch('/api/orders-search?dias=1', {
            headers: {
              Authorization: 'Bearer ' + pass,
              'X-Admin-User': user,
            },
          })
            .then(function (r) {
              return r.json().then(function (j) {
                return { r: r, j: j };
              });
            })
            .then(function (x) {
              if (x.r.status === 401) {
                clearSession();
                showLogin(x.j.error || 'Usuario o contraseña incorrectos.');
                return;
              }
              showDash();
            })
            .catch(function () {
              clearSession();
              showLogin('No se pudo validar el acceso.');
            })
            .finally(function () {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Entrar al dashboard';
              }
            });
        });

        document.getElementById('btn-demo').addEventListener('click', function () {
          setSession('demo', '', true);
          showDash();
        });
        document.getElementById('btn-logout').addEventListener('click', function () {
          clearSession();
          showLogin();
        });
        document.getElementById('btn-refresh').addEventListener('click', loadOrders);

        el.q.addEventListener('input', function () {
          state.query = el.q.value || '';
          renderAll();
        });
        el.gateway.addEventListener('change', function () {
          state.gateway = el.gateway.value || '';
          renderAll();
        });
        el.dias.addEventListener('change', function () {
          if (!state.demo) loadOrders();
        });

        document.querySelectorAll('.view-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            document.querySelectorAll('.view-btn').forEach(function (b) {
              b.classList.remove('is-active');
            });
            btn.classList.add('is-active');
            state.view = btn.getAttribute('data-view') || 'kanban';
            renderAll();
          });
        });

        el.modal.addEventListener('click', function (e) {
          if (e.target && e.target.getAttribute('data-close')) closeModal();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !el.modal.hidden) closeModal();
        });

        if (isDemo() || getSecret()) showDash();
        else showLogin();
      })();
    </script>

