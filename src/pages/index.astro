---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HomeTrustStrip from '../components/HomeTrustStrip.astro';
import Servicios from '../components/Servicios.astro';
import Productos from '../components/Productos.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Blog from '../components/Blog.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SEO from '../components/SEO.astro';
import HomeFaq from '../components/HomeFaq.astro';
import { buildHomeJsonLdGraph, ORG } from '../config/organization';

const homeSchema = buildHomeJsonLdGraph();
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>Energía Solar en Medellín y Colombia | Paneles Solares | Reiki Energía Solar</title>
    <SEO 
      title="Energía Solar en Medellín y Colombia | Paneles Solares | Reiki Energía Solar"
      description="Reiki Energía Solar: empresa de paneles solares e instalación fotovoltaica en Medellín y Colombia. Proyectos llave en mano y tienda de inversores, baterías y equipos con precio publicado. Cotiza hoy."
      canonical="/"
      ogImage="/images/og-default.png"
      keywords="energía solar Medellín, paneles solares Medellín, energía solar Colombia, instalación paneles solares Medellín, empresa solar Medellín, sistemas fotovoltaicos Colombia, comprar paneles solares Colombia, inversores solares, baterías solares"
      schemaType="LocalBusiness"
      schemaData={homeSchema}
    />
  </head>
  <body>
    <Header />
    
    <main>
      <Hero />
      <HomeTrustStrip />

      <section class="home-seo-intro" aria-labelledby="home-seo-heading">
        <div class="home-seo-inner">
          <p class="home-entity-line">
            <strong>{ORG.name}</strong> ({ORG.legalName}) es una empresa de energía solar en {ORG.addressLocality}, Colombia:
            instalación de paneles solares, sistemas fotovoltaicos llave en mano y venta de equipos para todo el país.
          </p>
          <h2 id="home-seo-heading">La empresa solar que te vende el equipo y te entrega el proyecto</h2>
          <p>
            Reiki Energía Solar es una empresa colombiana de energía fotovoltaica: diseñamos, suministramos e instalamos
            sistemas para hogar, industria y comercio en Medellín, Antioquia y el resto del país. Si ya tienes instalador,
            compra en nuestra tienda con precio publicado; si quieres ir de cero a generar, cotizamos tu sistema llave en mano
            bajo Ley 1715 y CREG 174 — con asesoría comercial clara, marcas reconocidas y un solo interlocutor hasta la puesta en marcha.
          </p>
        </div>
      </section>

      <section aria-labelledby="proyectos-llave-en-mano">
        <h2 id="proyectos-llave-en-mano" class="section-heading">Proyectos llave en mano</h2>
        <Servicios />
      </section>
      <section aria-labelledby="tienda-productos-solares">
        <h2 id="tienda-productos-solares" class="section-heading section-heading-on-purple">Tienda de productos solares</h2>
        <Productos />
      </section>
      <GoogleReviews />
      <HomeFaq />
      <Blog />
    </main>
    
    <Footer />
    <WhatsAppFloat />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    width: 100%;
    position: relative;
    background: #ffffff;
    line-height: 1.6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  img, video {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a, button {
    -webkit-tap-highlight-color: rgba(107, 33, 129, 0.2);
    touch-action: manipulation;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  .home-seo-intro {
    background: #fff;
    padding: 2.5rem 1.25rem 1.5rem;
  }

  .home-seo-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .home-entity-line {
    margin: 0 auto 1.15rem;
    max-width: 46rem;
    padding: 0.85rem 1rem;
    background: #f7f4f8;
    border-left: 3px solid #6b2181;
    border-radius: 0 10px 10px 0;
    color: #1f2937;
    font-size: 1.02rem;
    line-height: 1.55;
    text-align: left;
  }

  .home-seo-intro h2 {
    margin: 0 0 0.85rem;
    color: #6b2181;
    font-size: clamp(1.4rem, 2.6vw, 1.95rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .home-seo-intro p {
    margin: 0 auto;
    max-width: 46rem;
    color: #374151;
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .section-heading {
    max-width: 1200px;
    margin: 2rem auto 0;
    padding: 0 1.25rem;
    font-size: clamp(1.45rem, 2.8vw, 2rem);
    color: #6b2181;
    text-align: center;
  }

  .section-heading-on-purple {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  h1, h2, h3, h4, h5, h6,
  a, button, input, textarea, select {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  @media (max-width: 768px) {
    html {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    html {
      font-size: 15px;
    }
  }
</style>
