---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SEO from '../components/SEO.astro';
import FontAwesome from '../components/FontAwesome.astro';

function strEnv(v: string | undefined): string {
  return typeof v === 'string' ? v.replace(/^['"]|['"]$/g, '').trim() : '';
}

const rawEmailjsKey = import.meta.env.PUBLIC_EMAILJS_KEY;
let emailjsPublicKey = strEnv(rawEmailjsKey);
if (!emailjsPublicKey || emailjsPublicKey === 'undefined') {
  emailjsPublicKey = '';
}

/** IDs por defecto; puedes sobreescribir con PUBLIC_EMAILJS_SERVICE_ID / PUBLIC_EMAILJS_TEMPLATE_ID en Vercel. */
const emailjsServiceId =
  strEnv(import.meta.env.PUBLIC_EMAILJS_SERVICE_ID) || 'service_9q2y8pe';
const emailjsTemplateId =
  strEnv(import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID) || 'template_f6qba2h';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Estado de tu pago | Reiki Energía Solar</title>
    <FontAwesome />
    <SEO
      title="Estado de tu pago | Reiki Energía Solar"
      description="Consulta el estado de tu pago en Reiki Energía Solar."
      canonical="/respuesta-pago"
      schemaType="WebPage"
    />
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" is:inline></script>
    {emailjsPublicKey ? (
      <meta name="reiki-emailjs-public-key" content={emailjsPublicKey} />
    ) : null}
  </head>
  <body
    class="pay-response-body"
    data-emailjs-public-key={emailjsPublicKey}
    data-emailjs-service-id={emailjsServiceId}
    data-emailjs-template-id={emailjsTemplateId}
  >
    <Header />

    <main class="pay-response-main">
      <section class="pay-response-card" aria-live="polite">
        <div id="pay-status-icon" class="pay-status-icon pay-status-icon--loading" aria-hidden="true">
          <span class="pay-spinner"></span>
        </div>
        <h1 id="pay-status-title">Verificando tu pago…</h1>
        <p id="pay-status-message">
          Estamos confirmando el resultado con Wompi. Esto suele tardar unos segundos.
        </p>
        <p id="pay-status-reference" class="pay-status-reference" hidden></p>
        <p id="pay-status-id" class="pay-status-id" hidden></p>
        <div id="pay-status-actions" class="pay-status-actions"></div>
      </section>
    </main>

    <Footer />
    <WhatsAppFloat />

    <!-- Pruebas locales: /respuesta-pago?mock=approved (ver comentario dentro del script) -->
    <script is:inline>
      (function () {
        var titleEl = document.getElementById('pay-status-title');
        var messageEl = document.getElementById('pay-status-message');
        var refEl = document.getElementById('pay-status-reference');
        var iconEl = document.getElementById('pay-status-icon');
        var actionsEl = document.getElementById('pay-status-actions');

        var idEl = document.getElementById('pay-status-id');

        function setStatus(type, title, message, referenceText, transactionIdText) {
          if (titleEl) titleEl.textContent = title;
          if (messageEl) messageEl.textContent = message;

          if (refEl) {
            if (referenceText) {
              refEl.textContent = referenceText;
              refEl.hidden = false;
            } else {
              refEl.hidden = true;
              refEl.textContent = '';
            }
          }

          if (idEl) {
            if (transactionIdText) {
              idEl.textContent = transactionIdText;
              idEl.hidden = false;
            } else {
              idEl.hidden = true;
              idEl.textContent = '';
            }
          }

          if (iconEl) {
            iconEl.className = 'pay-status-icon';
            if (type === 'success') {
              iconEl.classList.add('pay-status-icon--success');
              iconEl.innerHTML = '<span>✓</span>';
            } else if (type === 'error') {
              iconEl.classList.add('pay-status-icon--error');
              iconEl.innerHTML = '<span>✕</span>';
            } else if (type === 'pending') {
              iconEl.classList.add('pay-status-icon--pending');
              iconEl.innerHTML = '<span>⏳</span>';
            } else {
              iconEl.classList.add('pay-status-icon--loading');
              iconEl.innerHTML = '<span class="pay-spinner"></span>';
            }
          }
        }

        function setActions(html) {
          if (actionsEl) actionsEl.innerHTML = html || '';
        }

        function actionButton(href, text, extraClass) {
          return '<a class="pay-action-btn ' + (extraClass || '') + '" href="' + href + '">' + text + '</a>';
        }

        var LS_CART_KEY = 'reiki_cart';
        var LS_CUSTOMER_KEY = 'reiki_checkout_customer';
        var LS_REFERENCE_KEY = 'reiki_checkout_reference';
        /** Referencia amigable que mostramos en UI y enviamos a EmailJS. */
        var numeroOrdenActual = '';

        function resolveEmailJsServiceId() {
          var b = document.body;
          if (!(b instanceof HTMLElement)) return '';
          var ds = b.dataset.emailjsServiceId ? String(b.dataset.emailjsServiceId).trim() : '';
          var at = (b.getAttribute('data-emailjs-service-id') || '').trim();
          return ds || at;
        }

        function resolveEmailJsTemplateId() {
          var b = document.body;
          if (!(b instanceof HTMLElement)) return '';
          var ds = b.dataset.emailjsTemplateId ? String(b.dataset.emailjsTemplateId).trim() : '';
          var at = (b.getAttribute('data-emailjs-template-id') || '').trim();
          return ds || at;
        }

        function loadLocalJson(key) {
          try {
            var raw = localStorage.getItem(key);
            return raw ? JSON.parse(raw) : null;
          } catch (_e) {
            return null;
          }
        }

        function clearCheckoutStorage() {
          try {
            localStorage.removeItem(LS_CART_KEY);
            localStorage.removeItem(LS_CUSTOMER_KEY);
            localStorage.removeItem(LS_REFERENCE_KEY);
          } catch (_e) {}
        }

        function loadCheckoutReferenceFromLs() {
          try {
            return String(localStorage.getItem(LS_REFERENCE_KEY) || '').trim();
          } catch (_e) {
            return '';
          }
        }

        /** Nunca pasar null/undefined a EmailJS. */
        function strSafeEmailParam(v) {
          if (v == null || v === undefined) return '';
          var s = String(v);
          return s === 'null' || s === 'undefined' ? '' : s;
        }

        /** referencia_pedido: referencia guardada al abrir Wompi, luego reference de API, último recurso 4 dígitos. */
        function resolveReferenciaPedido(wompiTx, refFromLs) {
          var fromLs = strSafeEmailParam(refFromLs).trim();
          if (fromLs) return fromLs;
          var t =
            wompiTx && typeof wompiTx === 'object' && !Array.isArray(wompiTx)
              ? wompiTx
              : {};
          var refApi = strSafeEmailParam(t.reference).trim();
          if (refApi) return refApi;
          return String(Math.floor(1000 + Math.random() * 9000));
        }

        function generateNumeroCorto() {
          return String(Math.floor(1000 + Math.random() * 9000));
        }

        function getEmailJsPublicKeyFromDom() {
          var b = document.body;
          if (!(b instanceof HTMLElement)) return '';
          var fromDataset =
            b.dataset && b.dataset.emailjsPublicKey ? String(b.dataset.emailjsPublicKey) : '';
          var fromAttr = (b.getAttribute('data-emailjs-public-key') || '').trim();
          var pub = (fromDataset || fromAttr).trim();
          if (pub) return pub;
          var meta = document.querySelector('meta[name="reiki-emailjs-public-key"]');
          if (meta instanceof HTMLMetaElement) return (meta.getAttribute('content') || '').trim();
          return '';
        }

        function isLikelyEmailJsPublicKey(pk) {
          var v = String(pk || '').trim();
          if (!v || v === 'undefined') return false;
          // Evita usar accidentalmente service_*/template_* como "public key".
          if (/^(service_|template_)/i.test(v)) return false;
          return true;
        }

        var emailJsLibraryInitialized = false;

        function ensureEmailJsInit(publicKey) {
          if (!publicKey || typeof emailjs === 'undefined') return false;
          if (!emailJsLibraryInitialized) {
            emailjs.init({ publicKey: publicKey });
            emailJsLibraryInitialized = true;
          }
          return true;
        }

        function extractPriceCop(priceString) {
          var cleaned = String(priceString || '').replace(/[^0-9]/g, '');
          return parseInt(cleaned, 10) || 0;
        }

        function formatLineTotalCopForEmail(lineTotalCop) {
          var n = Math.max(0, Math.floor(Number(lineTotalCop) || 0));
          return '$' + n.toLocaleString('es-CO');
        }

        /** Lista en texto para plantilla EmailJS (\n entre líneas). */
        function buildResumenPedidoFormateado(cart) {
          if (!Array.isArray(cart) || cart.length === 0) {
            return '(Sin productos registrados.)';
          }
          return cart
            .map(function (item) {
              var qty = parseInt(item.quantity, 10) || 1;
              var unitCop = extractPriceCop(item.price);
              var lineTotal = unitCop * qty;
              return (
                '- [' +
                qty +
                ']x ' +
                String(item.title || 'Producto').trim() +
                ' (' +
                formatLineTotalCopForEmail(lineTotal) +
                ')'
              );
            })
            .join('\n');
        }

        function formatDireccionEnvio(customer) {
          var c = customer && typeof customer === 'object' ? customer : {};
          var parts = [
            c.addressLine,
            [c.city, c.department].filter(Boolean).join(', '),
            c.zip ? 'Código postal: ' + c.zip : '',
            'Colombia',
          ].filter(function (x) {
            return x && String(x).trim();
          });
          return parts.join(' — ');
        }

        function normalizeCustomerEmail(raw) {
          var v = String(raw == null ? '' : raw).trim();
          if (!v || v === 'undefined' || v === 'null') return '';
          return v;
        }

        /** Intenta obtener un correo con forma mínima de email (contiene '@'). */
        function pickBuyerEmail(custSnap, wompiTx) {
          var cust =
            custSnap && typeof custSnap === 'object' && !Array.isArray(custSnap) ? custSnap : {};
          var fromLs = normalizeCustomerEmail(cust.email);
          if (fromLs.indexOf('@') !== -1) return fromLs;

          var t = wompiTx && typeof wompiTx === 'object' && !Array.isArray(wompiTx) ? wompiTx : {};
          var c = t.customer && typeof t.customer === 'object' ? t.customer : null;
          var cd = t.customer_data && typeof t.customer_data === 'object' ? t.customer_data : null;
          var ps = t.payment_source && typeof t.payment_source === 'object' ? t.payment_source : null;
          var psEx = ps && ps.extra && typeof ps.extra === 'object' ? ps.extra : null;
          var pm = t.payment_method && typeof t.payment_method === 'object' ? t.payment_method : null;
          var pmEx = pm && pm.extra && typeof pm.extra === 'object' ? pm.extra : null;
          var candidates = [
            t.customer_email,
            t.customerEmail,
            t.email,
            t.billing_email,
            t.buyer_email,
            c ? c.email : undefined,
            cd ? cd.email : undefined,
            ps ? ps.customer_email || ps.customerEmail : undefined,
            psEx ? psEx.customer_email || psEx.email || psEx.payer_email : undefined,
            pmEx ? pmEx.email || pmEx.customer_email || pmEx.payer_email : undefined,
          ];

          for (var i = 0; i < candidates.length; i++) {
            var e = normalizeCustomerEmail(String(candidates[i] == null ? '' : candidates[i]));
            if (e.indexOf('@') !== -1) return e;
          }
          return '';
        }

        /**
         * Notificación de venta (no bloquea la UI si EmailJS falla).
         * @returns {Promise<boolean>} true solo si EmailJS confirmó envío OK (para poder limpiar carrito después).
         */
        async function sendEmailSaleApproved(templateParamsSubset) {
          try {
            var emailClienteNorm = normalizeCustomerEmail(templateParamsSubset && templateParamsSubset.email_cliente);
            if (!emailClienteNorm || emailClienteNorm.indexOf('@') === -1) {
              console.warn(
                '[respuesta-pago][EmailJS] Sin email_cliente válido para el comprador; no se envía el correo hasta tener un correo (localStorage o transacción Wompi).'
              );
              return false;
            }

            var pub = getEmailJsPublicKeyFromDom();
            if (!pub) {
              console.warn(
                '[respuesta-pago][EmailJS] Falta PUBLIC_EMAILJS_KEY en el build del sitio (Vercel → Environment Variables → PUBLIC_EMAILJS_KEY y redeploy). Sin eso no se puede enviar el correo.'
              );
              return false;
            }
            if (!isLikelyEmailJsPublicKey(pub)) {
              console.warn(
                '[respuesta-pago][EmailJS] PUBLIC_EMAILJS_KEY inválida: parece service/template id. Debe ser la Public Key real de EmailJS (Account → API keys).'
              );
              return false;
            }
            if (!ensureEmailJsInit(pub)) {
              console.warn('[respuesta-pago][EmailJS] No se cargó emailjs desde el CDN o init falló.');
              return false;
            }

            var serviceId = resolveEmailJsServiceId();
            var templateId = resolveEmailJsTemplateId();
            if (!serviceId || !templateId) {
              console.warn('[respuesta-pago][EmailJS] Faltan data-emailjs-service-id o template-id en <body>.');
              return false;
            }

            var payload = {};
            payload.referencia_pedido = strSafeEmailParam(templateParamsSubset.referencia_pedido);
            payload.nombre_cliente = strSafeEmailParam(templateParamsSubset.nombre_cliente);
            payload.email_cliente = emailClienteNorm;
            payload.telefono_cliente = strSafeEmailParam(templateParamsSubset.telefono_cliente);
            payload.direccion_envio = strSafeEmailParam(templateParamsSubset.direccion_envio);
            payload.resumen_pedido = strSafeEmailParam(templateParamsSubset.resumen_pedido);

            var res = await emailjs.send(serviceId, templateId, payload);
            if (typeof res !== 'undefined' && res && typeof console !== 'undefined' && console.info) {
              console.info('[respuesta-pago][EmailJS] Envío solicitado:', res.status, res.text);
            }
            return true;
          } catch (e) {
            console.error('[respuesta-pago][EmailJS] Fallo al enviar:', e);
            return false;
          }
        }

        async function finalizeApprovedSale(wompiTxnId, custSnapshot, cartSnapshot, wompiTx, numeroCortoOverride) {
          try {
            var cust = custSnapshot && typeof custSnapshot === 'object' ? custSnapshot : {};
            var correoRecuperado = pickBuyerEmail(custSnapshot, wompiTx);
            var refGuardadaLs = loadCheckoutReferenceFromLs();
            var referencia_pedido = strSafeEmailParam(numeroCortoOverride).trim();
            if (!referencia_pedido) {
              referencia_pedido = resolveReferenciaPedido(wompiTx, refGuardadaLs);
            }
            numeroOrdenActual = referencia_pedido;
            var resumen_pedido_formateado = buildResumenPedidoFormateado(
              Array.isArray(cartSnapshot) ? cartSnapshot : []
            );

            /** Completamos nombre/tel desde Wompi si faltaran en localStorage (mejor contenido del recibo). */
            var custFromTx =
              wompiTx && typeof wompiTx === 'object'
                ? wompiTx.customer_data && typeof wompiTx.customer_data === 'object'
                  ? wompiTx.customer_data
                  : wompiTx.customer && typeof wompiTx.customer === 'object'
                    ? wompiTx.customer
                    : {}
                : {};
            var nombreLs = String(cust.fullName || '').trim();
            var nombre =
              nombreLs ||
              String((custFromTx.full_name || custFromTx.fullName || custFromTx.name) || '').trim();
            var tel =
              String(cust.phone || '').trim() ||
              String((custFromTx.phone_number || custFromTx.phone || custFromTx.phoneNumber) || '').trim();

            /** Coincidencia estricta con plantilla EmailJS — solo strings (ni null ni undefined). */
            var datosCliente = {
              nombre: strSafeEmailParam(nombre),
              email: strSafeEmailParam(correoRecuperado),
              telefono: strSafeEmailParam(tel),
              direccion: strSafeEmailParam(formatDireccionEnvio(cust)),
            };

            var templateParams = {
              referencia_pedido: referencia_pedido,
              nombre_cliente: datosCliente.nombre,
              email_cliente: datosCliente.email,
              telefono_cliente: datosCliente.telefono,
              direccion_envio: datosCliente.direccion,
              resumen_pedido: strSafeEmailParam(resumen_pedido_formateado),
            };

            var enviadoOk = await sendEmailSaleApproved(templateParams);
            if (enviadoOk) {
              clearCheckoutStorage();
            } else {
              console.warn(
                '[respuesta-pago][EmailJS] No se limpió el carrito: el correo no se envió (revisa configuración EmailJS / email_cliente o consola anterior). Referencia/transacción: ' +
                  String(wompiTxnId || referencia_pedido || '')
              );
            }
          } catch (e) {
            console.error('[respuesta-pago][finalizeApprovedSale]', e);
          }
        }

        /**
         * Simulación de UI solo en localhost (no corre en dominio producción).
         * Valores mock: approved, pending, declined, error, voided, unknown, noid, fetch_error
         * Ej.: /respuesta-pago?mock=approved&id=demo
         */
        function tryLocalMock(params) {
          var mock = (params.get('mock') || '').toLowerCase().trim();
          if (!mock) return false;
          var host = window.location.hostname || '';
          var isLocal =
            host === 'localhost' || host === '127.0.0.1' || host === '[::1]' || host.endsWith('.local');
          if (!isLocal) return false;

          if (mock === 'noid') {
            setStatus(
              'error',
              'No pudimos identificar tu pago',
              'Wompi suele redirigir con un enlace que incluye ?id=… al final. Si abriste esta página directamente, ve al carrito e inicia el pago otra vez.'
            );
            setActions(actionButton('/carrito', 'Ir al carrito', 'pay-action-btn--error'));
            return true;
          }

          if (mock === 'fetch_error') {
            setStatus(
              'error',
              'No pudimos consultar el resultado ahora',
              'Puede ser un fallo temporal de red. Tu pago pudo haberse completado igual: revisa el correo de Wompi o el extracto de tu banco. Si necesitas ayuda, escríbenos con la hora aproximada y el monto.',
              '',
              'ID en la URL (Wompi): ' + (params.get('id') || '(simulado)')
            );
            setActions(
              actionButton('/carrito', 'Volver al carrito', 'pay-action-btn--error') +
                actionButton('https://wa.me/573245737413', 'Hablar con soporte', 'pay-action-btn--ghost')
            );
            return true;
          }

          var fakeId = params.get('id') || '01-mock-local-wompi';
          var fakeRef = 'REIKI-MOCK-' + Date.now().toString(36);

          if (mock === 'approved') {
            var mockCust = loadLocalJson(LS_CUSTOMER_KEY);
            var mockCart = loadLocalJson(LS_CART_KEY);
            var numeroCortoMock = generateNumeroCorto();
            numeroOrdenActual = numeroCortoMock;
            setStatus(
              'success',
              '¡Pago aprobado!',
              'Gracias por tu compra. Confirmaremos tu pedido y enviaremos la factura electrónica al correo con el que pagaste. Para envío o detalle del pedido puedes escribirnos por WhatsApp.',
              'Número de Orden: #' + numeroCortoMock,
              ''
            );
            setActions(
              actionButton('/tienda', 'Seguir comprando') +
                actionButton(
                  'https://wa.me/573245737413?text=' +
                    encodeURIComponent('Hola, acabo de pagar. Orden #' + numeroCortoMock),
                  'Consultar mi pedido',
                  'pay-action-btn--ghost'
                )
            );
            void finalizeApprovedSale(fakeId, mockCust, mockCart, null, numeroCortoMock);
            return true;
          }

          if (mock === 'pending') {
            setStatus(
              'pending',
              'Pago en validación',
              'Tu banco o método de pago aún está procesando el cobro. Suele resolverse en minutos. Conserva esta pantalla o el correo de Wompi; te avisaremos si hace falta algún dato.',
              'Referencia: ' + fakeRef,
              'ID de transacción (Wompi): ' + fakeId
            );
            setActions(
              actionButton('/', 'Ir al inicio') + actionButton('/tienda', 'Volver a la tienda', 'pay-action-btn--ghost')
            );
            return true;
          }

          if (mock === 'declined') {
            setStatus(
              'error',
              'No se completó el pago',
              'El banco o la entidad rechazó la operación. No se hizo ningún cobro. Puedes intentar con otra tarjeta, PSE u otro medio disponible en Wompi.',
              'Referencia: ' + fakeRef,
              'ID de transacción (Wompi): ' + fakeId
            );
            setActions(actionButton('/carrito', 'Volver al carrito e intentar', 'pay-action-btn--error'));
            return true;
          }

          if (mock === 'error') {
            setStatus(
              'error',
              'No se completó el pago',
              'Ocurrió un error al procesar el pago. Inténtalo de nuevo; si el problema continúa, escríbenos con el ID de transacción.',
              'Referencia: ' + fakeRef,
              'ID de transacción (Wompi): ' + fakeId
            );
            setActions(actionButton('/carrito', 'Volver al carrito e intentar', 'pay-action-btn--error'));
            return true;
          }

          if (mock === 'voided') {
            setStatus(
              'error',
              'Este pago fue anulado',
              'La transacción quedó anulada. Si ves un cargo pendiente, espera la reversión según tu banco o contáctanos.',
              'Referencia: ' + fakeRef,
              'ID de transacción (Wompi): ' + fakeId
            );
            setActions(actionButton('/carrito', 'Volver al carrito e intentar', 'pay-action-btn--error'));
            return true;
          }

          if (mock === 'unknown') {
            setStatus(
              'pending',
              'Estado en revisión',
              'Recibimos tu intento de pago (estado: WEIRD_STATUS). Espera un momento o vuelve más tarde; si el cargo aparece en tu cuenta y el pedido no avanza, envíanos el ID de transacción.',
              'Referencia: ' + fakeRef,
              'ID de transacción (Wompi): ' + fakeId
            );
            setActions(
              actionButton('/', 'Ir al inicio') + actionButton('/carrito', 'Volver al carrito', 'pay-action-btn--ghost')
            );
            return true;
          }

          return false;
        }

        function resolveTransactionIdFromUrl(searchParams) {
          var keys = ['id', 'transactionId', 'transaction_id'];
          for (var k = 0; k < keys.length; k++) {
            var raw = searchParams.get(keys[k]);
            if (raw && String(raw).trim()) return String(raw).trim();
          }
          var h = window.location.hash || '';
          if (h.indexOf('id=') !== -1) {
            try {
              var qh = new URLSearchParams(h.replace(/^#/, '').replace(/^\?/, ''));
              var idh = qh.get('id');
              if (idh && String(idh).trim()) return String(idh).trim();
            } catch (_he) {}
            var mh = /(?:^|[?&#])id=([^&]+)/.exec(h);
            if (mh && mh[1]) {
              try {
                return decodeURIComponent(mh[1].replace(/\+/g, ' ')).trim();
              } catch (_dec) {
                return mh[1].trim();
              }
            }
          }
          return '';
        }

        async function fetchWompiTransactionJson(txId, isSandbox) {
          var base = isSandbox
            ? 'https://sandbox.wompi.co/v1/transactions/'
            : 'https://production.wompi.co/v1/transactions/';
          try {
            var directRes = await fetch(base + encodeURIComponent(txId), { method: 'GET' });
            if (directRes.ok) return await directRes.json();
          } catch (_directErr) {
            /* CORS/red: intentamos proxy serverless */
          }
          try {
            var qs = '?id=' + encodeURIComponent(txId);
            if (isSandbox) qs += '&env=sandbox';
            var proxyRes = await fetch('/api/wompi-transaction' + qs, { method: 'GET' });
            var pj = await proxyRes.json().catch(function () {
              return null;
            });
            if (proxyRes.ok && pj) return pj;
          } catch (_proxyErr) {}
          throw new Error('No fue posible consultar la transacción en Wompi');
        }

        async function run() {
          var params = new URLSearchParams(window.location.search);
          if (tryLocalMock(params)) return;

          var txId = resolveTransactionIdFromUrl(params);

          if (!txId) {
            setStatus(
              'error',
              'No pudimos identificar tu pago',
              'Tras pagar, Wompi redirige a esta página con ?id=… en la dirección (misma raíz que en astro.config del sitio: sin cambiar dominio entre carrito y regreso). Si la barra ya no muestra ese parámetro, puede ser un redirect del hosting; en Wompi el comercio debe tener permitida esta URL exacta. Abre esta página desde el enlace tras el cobro o vuelve al carrito.'
            );
            setActions(actionButton('/carrito', 'Ir al carrito', 'pay-action-btn--error'));
            return;
          }

          var isSandbox =
            /^(localhost|127\.0\.0\.1|\[::1\])$/i.test(window.location.hostname || '') ||
            params.get('env') === 'sandbox';

          try {
            var json = await fetchWompiTransactionJson(txId, isSandbox);
            var tx = json && json.data ? json.data : null;
            var status = tx && tx.status ? String(tx.status).toUpperCase() : 'ERROR';
            var reference = tx && tx.reference ? tx.reference : '';
            var wompiTxnId = tx && tx.id ? String(tx.id) : String(txId);
            var idNote = wompiTxnId ? 'ID de transacción (Wompi): ' + wompiTxnId : '';

            if (status === 'APPROVED') {
              var custSnap = loadLocalJson(LS_CUSTOMER_KEY);
              var cartSnap = loadLocalJson(LS_CART_KEY);
              var numeroCorto = generateNumeroCorto();
              numeroOrdenActual = numeroCorto;

              setStatus(
                'success',
                '¡Pago aprobado!',
                'Gracias por tu compra. Confirmaremos tu pedido y enviaremos la factura electrónica al correo con el que pagaste. Para envío o detalle del pedido puedes escribirnos por WhatsApp.',
                'Número de Orden: #' + numeroCorto,
                ''
              );
              setActions(
                actionButton('/tienda', 'Seguir comprando') +
                  actionButton(
                    'https://wa.me/573245737413?text=' + encodeURIComponent('Hola, acabo de pagar. Orden #' + numeroCorto),
                    'Consultar mi pedido',
                    'pay-action-btn--ghost'
                  )
              );

              await finalizeApprovedSale(wompiTxnId, custSnap, cartSnap, tx, numeroCorto);
              return;
            }

            if (status === 'PENDING') {
              setStatus(
                'pending',
                'Pago en validación',
                'Tu banco o método de pago aún está procesando el cobro. Suele resolverse en minutos. Conserva esta pantalla o el correo de Wompi; te avisaremos si hace falta algún dato.',
                reference ? 'Referencia: ' + reference : '',
                idNote
              );
              setActions(
                actionButton('/', 'Ir al inicio') + actionButton('/tienda', 'Volver a la tienda', 'pay-action-btn--ghost')
              );
              return;
            }

            if (status === 'DECLINED' || status === 'ERROR' || status === 'VOIDED' || status === 'VOID') {
              var errTitle =
                status === 'VOIDED' || status === 'VOID' ? 'Este pago fue anulado' : 'No se completó el pago';
              var errBody =
                status === 'DECLINED'
                  ? 'El banco o la entidad rechazó la operación. No se hizo ningún cobro. Puedes intentar con otra tarjeta, PSE u otro medio disponible en Wompi.'
                  : status === 'VOIDED' || status === 'VOID'
                    ? 'La transacción quedó anulada. Si ves un cargo pendiente, espera la reversión según tu banco o contáctanos.'
                    : 'Ocurrió un error al procesar el pago. Inténtalo de nuevo; si el problema continúa, escríbenos con el ID de transacción.';
              setStatus('error', errTitle, errBody, reference ? 'Referencia: ' + reference : '', idNote);
              setActions(actionButton('/carrito', 'Volver al carrito e intentar', 'pay-action-btn--error'));
              return;
            }

            setStatus(
              'pending',
              'Estado en revisión',
              'Recibimos tu intento de pago (estado: ' + status + '). Espera un momento o vuelve más tarde; si el cargo aparece en tu cuenta y el pedido no avanza, envíanos el ID de transacción.',
              reference ? 'Referencia: ' + reference : '',
              idNote
            );
            setActions(
              actionButton('/', 'Ir al inicio') + actionButton('/carrito', 'Volver al carrito', 'pay-action-btn--ghost')
            );
          } catch (err) {
            console.error('[respuesta-pago]', err);
            setStatus(
              'error',
              'No pudimos consultar el resultado ahora',
              'Puede ser un fallo temporal de red. Tu pago pudo haberse completado igual: revisa el correo de Wompi o el extracto de tu banco. Si necesitas ayuda, escríbenos con la hora aproximada y el monto.',
              '',
              txId ? 'ID en la URL (Wompi): ' + txId : ''
            );
            setActions(
              actionButton('/carrito', 'Volver al carrito', 'pay-action-btn--error') +
                actionButton('https://wa.me/573245737413', 'Hablar con soporte', 'pay-action-btn--ghost')
            );
          }
        }

        run();
      })();
    </script>
  </body>
</html>

