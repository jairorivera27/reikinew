---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { urlProducto } from '../config/categorias-tienda';
import { calcularValor, type ResultadoValor } from '../utils/calidadPrecio';
import { estaRebajado } from '../utils/descuentos';
import Icon from './Icon.astro';

const MAX_CAROUSEL = 8;
/** Cupos reservados para liquidaciones; el resto va a mejor calidad-precio. */
const MAX_PROMOS = 4;
/**
 * Los cupos de calidad-precio se reparten entre los equipos que definen un sistema solar.
 * Accesorios como breakers o fusibles ganan por precio unitario pero no representan la tienda.
 */
const CATEGORIAS_PRINCIPALES = ['paneles', 'inversores', 'baterias', 'controladores', 'bombeo'];
const productos = await getCollection('productos', ({ data }) => data.draft !== true);

/**
 * Puntaje y distintivo de calidad-precio por producto (comparación dentro de cada categoría).
 */
const valores = new Map<string, ResultadoValor>();
for (const categoria of new Set(productos.map((p) => p.data.category))) {
  const porCat = calcularValor(
    productos.filter((p) => p.data.category === categoria).map((p) => ({ slug: p.slug, ...p.data }))
  );
  for (const [slug, valor] of porCat) valores.set(slug, valor);
}

/**
 * Carrusel del inicio: primero equipos en promoción, luego los de mejor
 * relación calidad-precio (con variedad de categorías). `homeCarouselOrder`
 * solo desempata dentro de cada grupo.
 */
function pickCarouselProductos(entries: CollectionEntry<'productos'>[]): CollectionEntry<'productos'>[] {
  const orderPin = (p: CollectionEntry<'productos'>) => p.data.homeCarouselOrder ?? 99;
  const byScore = (a: CollectionEntry<'productos'>, b: CollectionEntry<'productos'>) =>
    (valores.get(b.slug)?.puntaje ?? 0) - (valores.get(a.slug)?.puntaje ?? 0) ||
    orderPin(a) - orderPin(b);

  const rebajados = entries
    .filter((p) => estaRebajado(p.data) && p.data.stock !== 'agotado')
    .sort(
      (a, b) =>
        (b.data.descuentoPct ?? 0) - (a.data.descuentoPct ?? 0) || orderPin(a) - orderPin(b)
    );

  const disponible = (p: CollectionEntry<'productos'>) =>
    p.data.stock !== 'agotado' && !estaRebajado(p.data);

  const calidad = entries
    .filter(
      (p) =>
        valores.get(p.slug)?.destacado === true &&
        disponible(p) &&
        CATEGORIAS_PRINCIPALES.includes(p.data.category)
    )
    .sort(byScore);

  const resto = entries
    .filter((p) => disponible(p) && CATEGORIAS_PRINCIPALES.includes(p.data.category))
    .sort(byScore);

  const out: CollectionEntry<'productos'>[] = [];
  const ids = new Set<string>();
  const usosPorCategoria = new Map<string, number>();

  const push = (p: CollectionEntry<'productos'>, maxPorCategoria = Infinity) => {
    if (out.length >= MAX_CAROUSEL || ids.has(p.id)) return;
    if ((usosPorCategoria.get(p.data.category) ?? 0) >= maxPorCategoria) return;
    out.push(p);
    ids.add(p.id);
    usosPorCategoria.set(p.data.category, (usosPorCategoria.get(p.data.category) ?? 0) + 1);
  };

  for (const p of rebajados) {
    if (out.length >= MAX_PROMOS) break;
    push(p, 2);
  }

  // Un solo equipo por categoría para que el carrusel muestre variedad de sistema.
  for (const p of calidad) push(p, 1);
  for (const p of resto) push(p, 1);
  for (const p of resto) push(p, 2);
  for (const p of entries.filter((x) => disponible(x)).sort(byScore)) push(p);

  return out;
}

const productosMasVendidos = pickCarouselProductos(productos);

function cardMeta(producto: CollectionEntry<'productos'>) {
  const valor = valores.get(producto.slug);
  const enPromo = estaRebajado(producto.data);
  return { valor, enPromo, href: urlProducto(producto.slug) };
}
---

<section id="productos" class="productos-section">
  <div class="container">
    <div class="productos-header">
      <h2 class="productos-title">Equipos destacados</h2>
      <p class="productos-subtitle">Promociones activas y la mejor relación calidad-precio de nuestra tienda</p>
    </div>

    <div class="productos-carousel-wrapper">
      <button class="carousel-btn prev-btn" aria-label="Anterior">
        <Icon name="chevron-left" />
      </button>
      <button class="carousel-btn next-btn" aria-label="Siguiente">
        <Icon name="chevron-right" />
      </button>
      <div class="productos-carousel">
        <div class="productos-track">
          {[...productosMasVendidos, ...productosMasVendidos].map((producto) => {
            const { valor, enPromo, href } = cardMeta(producto);
            const d = producto.data;
            return (
              <a href={href} class="producto-card" data-astro-prefetch>
                <div class="producto-image">
                  <img src={d.image} alt={d.title} loading="lazy">
                  {enPromo && (
                    <div class="producto-badge-descuento">-{d.descuentoPct}%</div>
                  )}
                  {valor?.destacado && !enPromo && (
                    <div class="producto-badge-valor" title="Mejor relación calidad-precio de su categoría">
                      Mejor calidad-precio
                    </div>
                  )}
                  {d.stock === 'disponible' && (
                    <div class="producto-badge">Disponible</div>
                  )}
                  {d.stock === 'agotado' && (
                    <div class="producto-badge agotado">Agotado</div>
                  )}
                  {d.stock === 'pre-orden' && (
                    <div class="producto-badge pre-orden">Pre-orden</div>
                  )}
                </div>
                <div class="producto-content">
                  <h3 class="producto-name">{d.title}</h3>
                  <p class="producto-description">{d.description}</p>
                  <div class="producto-price">
                    {d.price}
                    {enPromo && <span class="producto-price-anterior">{d.precioAnterior}</span>}
                  </div>
                  <div class="producto-btn">Ver Detalles</div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="productos-actions">
      <a class="productos-tienda-cta" href="/tienda" data-astro-prefetch>Ver toda la tienda</a>
      <a class="productos-descuentos-cta" href="/tienda/descuentos" data-astro-prefetch>Ver descuentos</a>
    </div>
  </div>
</section>

<style>
  .productos-section {
    padding: 5rem 0;
    background: #6b2181;
    position: relative;
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .productos-header {
    text-align: center;
    margin-bottom: 3rem;
    width: 100%;
  }

  .productos-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .productos-tienda-cta,
  .productos-descuentos-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .productos-tienda-cta {
    background: linear-gradient(135deg, #ffd700, #ffa500);
    color: #1f2937;
    box-shadow: 0 6px 18px rgba(255, 165, 0, 0.35);
  }

  .productos-tienda-cta:hover {
    transform: translateY(-2px);
  }

  .productos-descuentos-cta {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
  }

  .productos-descuentos-cta:hover {
    background: rgba(255, 255, 255, 0.24);
    transform: translateY(-2px);
  }

  .productos-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-align: center;
  }

  .productos-subtitle {
    font-size: 1.2rem;
    color: #e5e7eb;
    text-align: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .productos-carousel-wrapper {
    position: relative;
    overflow: hidden;
    padding: 2rem 0;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #f3f4f6;
    border: 2px solid #6b2181;
    color: #6b2181;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    font-size: 1.2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-btn :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: #6b2181;
  }

  .carousel-btn:hover:not(:disabled) :global(svg) {
    color: #ffffff;
  }

  .carousel-btn:hover {
    background: #6b2181;
    color: white;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 20px rgba(107, 33, 129, 0.4);
  }

  .carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .prev-btn {
    left: 1rem;
  }

  .next-btn {
    right: 1rem;
  }

  @media (max-width: 768px) {
    .carousel-btn {
      width: 45px;
      height: 45px;
      font-size: 1rem;
    }

    .prev-btn {
      left: 0.5rem;
    }

    .next-btn {
      right: 0.5rem;
    }
  }

  .productos-carousel {
    width: 100%;
    overflow: hidden;
  }

  .productos-track {
    display: flex;
    gap: 2rem;
    transition: transform 0.5s linear;
    will-change: transform;
  }

  .producto-card {
    flex: 0 0 320px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .producto-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .producto-image {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
    background: #f3f4f6;
  }

  .producto-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .producto-card:hover .producto-image img {
    transform: scale(1.1);
  }

  .producto-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, #6b2181, #8b2a9b);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    box-shadow: 0 4px 15px rgba(107, 33, 129, 0.4);
  }

  .producto-badge.agotado {
    background: linear-gradient(135deg, #ef4444, #dc2626);
  }

  .producto-badge.pre-orden {
    background: linear-gradient(135deg, #f59e0b, #d97706);
  }

  .producto-badge-descuento {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.4rem 0.75rem;
    border-radius: 20px;
    background: #dc2626;
    color: white;
    font-size: 0.85rem;
    font-weight: 800;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    box-shadow: 0 3px 10px rgba(220, 38, 38, 0.38);
  }

  .producto-badge-valor {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 20px;
    background: linear-gradient(135deg, #047857, #10b981);
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    box-shadow: 0 3px 10px rgba(4, 120, 87, 0.35);
  }

  .producto-content {
    padding: 1.5rem;
  }

  .producto-name {
    font-size: 1.3rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 0.75rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .producto-description {
    font-size: 0.95rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .producto-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: #6b2181;
    margin-bottom: 1rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
  }

  .producto-price-anterior {
    font-size: 0.95rem;
    font-weight: 500;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .producto-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: linear-gradient(135deg, #FFD700, #FFA500);
    color: #1f2937;
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
    pointer-events: none;
  }

  .producto-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 215, 0, 0.6);
    background: linear-gradient(135deg, #FFA500, #FFD700);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .producto-card {
      flex: 0 0 280px;
    }
  }

  @media (max-width: 768px) {
    .productos-section {
      padding: 3rem 0;
    }

    .productos-title {
      font-size: 2rem;
    }

    .productos-subtitle {
      font-size: 1rem;
    }

    .producto-card {
      flex: 0 0 260px;
    }

    .producto-image {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .productos-title {
      font-size: 1.75rem;
    }

    .producto-card {
      flex: 0 0 240px;
    }

    .producto-image {
      height: 180px;
    }

    .producto-content {
      padding: 1.25rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.querySelector('.productos-track') as HTMLElement;
    if (!track) return;

    const cards = track.querySelectorAll('.producto-card') as NodeListOf<HTMLElement>;
    if (cards.length === 0) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const half = Math.floor(cards.length / 2);
      cards.forEach((card, i) => {
        if (i >= half) card.style.display = 'none';
      });
      track.style.transform = 'none';
      return;
    }

    const gap = 32;
    let currentPosition = 0;
    let speed = window.innerWidth <= 768 ? 0.3 : 0.5;
    let animationId: number;
    let isPaused = false;

    function getCardWidth(): number {
      if (window.innerWidth <= 480) return 240;
      if (window.innerWidth <= 768) return 260;
      if (window.innerWidth <= 1024) return 280;
      return 320;
    }

    function getTotalWidth(): number {
      return (cards.length / 2) * (getCardWidth() + gap);
    }

    function animate() {
      if (!isPaused) {
        currentPosition -= speed;
        const totalWidth = getTotalWidth();
        if (Math.abs(currentPosition) >= totalWidth) currentPosition = 0;
        track.style.transform = `translateX(${currentPosition}px)`;
      }
      animationId = requestAnimationFrame(animate);
    }

    const carouselWrapper = document.querySelector('.productos-carousel-wrapper') as HTMLElement | null;
    carouselWrapper?.addEventListener('mouseenter', () => { isPaused = true; });
    carouselWrapper?.addEventListener('mouseleave', () => { isPaused = false; });
    carouselWrapper?.addEventListener('focusin', () => { isPaused = true; });
    carouselWrapper?.addEventListener('focusout', () => { isPaused = false; });

    const prevBtn = document.querySelector('.productos-section .prev-btn') as HTMLElement | null;
    const nextBtn = document.querySelector('.productos-section .next-btn') as HTMLElement | null;

    function moveCarousel(direction: 'prev' | 'next') {
      if (!carouselWrapper) return;
      const cardWidth = getCardWidth();
      const cardTotalWidth = cardWidth + gap;
      const containerCenter = carouselWrapper.offsetWidth / 2;
      const match = track.style.transform.match(/translateX\((-?\d+(?:\.\d+)?)px\)/);
      const actualPosition = match ? parseFloat(match[1]) : currentPosition;
      let targetCardIndex = Math.round(Math.abs(actualPosition) / cardTotalWidth);
      targetCardIndex = direction === 'next' ? targetCardIndex + 1 : Math.max(0, targetCardIndex - 1);
      currentPosition = -targetCardIndex * cardTotalWidth + (containerCenter - cardWidth / 2);
      const totalWidth = getTotalWidth();
      if (Math.abs(currentPosition) >= totalWidth) currentPosition = 0;
      else if (currentPosition > 0) currentPosition = -totalWidth + cardTotalWidth;
      track.style.transition = 'transform 0.5s ease';
      track.style.transform = `translateX(${currentPosition}px)`;
      setTimeout(() => { track.style.transition = 'transform 0.5s linear'; }, 500);
    }

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      isPaused = true;
      moveCarousel('prev');
      setTimeout(() => { isPaused = false; }, 500);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      isPaused = true;
      moveCarousel('next');
      setTimeout(() => { isPaused = false; }, 500);
    });

    window.addEventListener('resize', () => {
      speed = window.innerWidth <= 768 ? 0.3 : 0.5;
      if (Math.abs(currentPosition) >= getTotalWidth()) currentPosition = 0;
    });

    animate();
    window.addEventListener('beforeunload', () => {
      if (animationId) cancelAnimationFrame(animationId);
    });
  });
</script>

