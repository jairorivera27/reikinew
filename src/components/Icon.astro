---
/**
 * Iconos SVG inline para la home (evita cargar Font Awesome completo).
 */
interface Props {
  name:
    | 'chevron-left'
    | 'chevron-right'
    | 'arrow-right'
    | 'whatsapp'
    | 'facebook'
    | 'instagram'
    | 'linkedin'
    | 'phone'
    | 'envelope'
    | 'map-marker'
    | 'clock';
  class?: string;
}

const { name, class: className = 'icon-svg' } = Astro.props;

const paths: Record<Props['name'], string> = {
  'chevron-left':
    'M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z',
  'chevron-right':
    'M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z',
  'arrow-right':
    'M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z',
  whatsapp:
    'M16 3A13 13 0 0 0 5.26 23.25L4 28l4.89-1.3A13 13 0 1 0 16 3zm0 2a11 11 0 0 1 8.78 17.65l-.23.3a11 11 0 0 1-13.42 2.55l-.32-.18-.35.09-2.94.78.79-2.93.09-.36-.19-.33A11 11 0 0 1 16 5zm-3 5.5a1 1 0 0 0-.94.56 7.65 7.65 0 0 0 .39 7.2c1.53 2.51 4.02 4.3 6.55 4.68a1 1 0 0 0 .82-.22l1.32-1.12a1 1 0 0 0 .11-1.4l-1.12-1.32a1 1 0 0 0-1.4-.1l-.9.77a6.21 6.21 0 0 1-2.92-2.08 6.05 6.05 0 0 1-1.12-2.88l1.05-.76a1 1 0 0 0 .1-1.5l-1.24-1.14a1 1 0 0 0-.7-.29z',
  facebook:
    'M22 12a10 10 0 1 0-11.5 9.9v-7H8v-3h2.5V9.5c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12H17l-.4 3h-2.7v7A10 10 0 0 0 22 12z',
  instagram:
    'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm11 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zM12 7.5A4.5 4.5 0 1 1 12 16.5 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 12 14.5 2.5 2.5 0 0 0 12 9.5z',
  linkedin:
    'M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V23h-4V8.5zM8.5 8.5h3.8v2h.1c.5-1 1.8-2.1 3.7-2.1 4 0 4.7 2.6 4.7 6V23h-4v-5.8c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V23h-4V8.5z',
  phone:
    'M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2.2 2.2z',
  envelope:
    'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z',
  'map-marker':
    'M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z',
  clock:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 11h-4V7h2v4h2v2z',
};

const viewBox = name === 'whatsapp' ? '0 0 32 32' : name === 'linkedin' ? '0 0 24 24' : '0 0 24 24';
---

<svg
  class={className}
  viewBox={viewBox}
  width="1em"
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

<style>
  .icon-svg {
    display: inline-block;
    vertical-align: -0.125em;
    flex-shrink: 0;
  }
</style>
