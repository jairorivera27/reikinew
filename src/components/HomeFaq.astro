---
import { HOME_FAQS } from '../config/organization';
---

<section class="home-faq" aria-labelledby="home-faq-title" id="preguntas-energia-solar-medellin">
  <div class="home-faq-inner">
    <header class="home-faq-header">
      <h2 id="home-faq-title">Preguntas frecuentes sobre energía solar en Medellín y Colombia</h2>
      <p class="home-faq-lead">
        Respuestas claras para quien busca instalación, cotización o compra de equipos solares con Reiki Energía Solar.
      </p>
    </header>

    <div class="home-faq-list">
      {HOME_FAQS.map((faq) => (
        <details class="home-faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .home-faq {
    background: #fff;
    padding: 3.25rem 1.25rem 4rem;
    border-top: 1px solid #ebe4ef;
  }

  .home-faq-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .home-faq-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .home-faq-header h2 {
    margin: 0 0 0.65rem;
    color: #6b2181;
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .home-faq-lead {
    margin: 0 auto;
    max-width: 40rem;
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.55;
  }

  .home-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .home-faq-item {
    background: #f7f4f8;
    border: 1px solid #ebe4ef;
    border-radius: 12px;
    padding: 0.15rem 1rem 0.15rem;
  }

  .home-faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 0.95rem 0;
    font-weight: 700;
    color: #1f2937;
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .home-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .home-faq-item summary::after {
    content: '+';
    float: right;
    color: #6b2181;
    font-weight: 800;
  }

  .home-faq-item[open] summary::after {
    content: '–';
  }

  .home-faq-item p {
    margin: 0 0 1rem;
    color: #374151;
    font-size: 0.98rem;
    line-height: 1.65;
  }
</style>
