---
/**
 * Franja de confianza de pago.
 * - inline: ficha/modal (Paga con / Mediante)
 * - section: carrusel "Medios de pago" (inicio / tienda)
 */
interface Props {
  class?: string;
  variant?: 'inline' | 'section';
}

const { class: className = '', variant = 'inline' } = Astro.props;
const isSection = variant === 'section';

type LogoItem = {
  src: string;
  alt: string;
  shape?: 'rect' | 'round' | 'square';
};

const filaTarjetas: LogoItem[] = [
  { src: '/checkout-trust/visa.svg', alt: 'Visa' },
  { src: '/checkout-trust/mastercard.svg', alt: 'Mastercard' },
  { src: '/checkout-trust/amex.svg', alt: 'American Express' },
];

const filaMedios: LogoItem[] = [
  { src: '/checkout-trust/pse.png', alt: 'PSE', shape: 'round' },
  { src: '/checkout-trust/nequi.png', alt: 'Nequi' },
  { src: '/checkout-trust/bancolombia.png', alt: 'Bancolombia' },
];

const filaPlataformas: LogoItem[] = [
  { src: '/checkout-trust/wompi.png', alt: 'Wompi' },
  { src: '/checkout-trust/addi.png', alt: 'Addi' },
  { src: '/checkout-trust/sumas.png', alt: 'SUMAS', shape: 'square' },
];

/** Carrusel sección: todas las marcas, celdas simétricas */
const logosCarrusel: LogoItem[] = [
  ...filaTarjetas,
  ...filaMedios,
  ...filaPlataformas,
];
const logosCarruselLoop = [...logosCarrusel, ...logosCarrusel];

const size = 34;
---

{
  isSection ? (
    <section class:list={['medios-pago-section', className]} aria-labelledby="medios-pago-heading">
      <div class="medios-pago-inner">
        <h2 id="medios-pago-heading" class="medios-pago-heading">Medios de pago</h2>
        <div class="medios-pago-carousel" aria-label="Logos de medios de pago">
          <div class="medios-pago-track">
            {logosCarruselLoop.map((logo, i) => (
              <div class="medios-pago-item" aria-hidden={i >= logosCarrusel.length ? 'true' : undefined}>
                <div class="medios-pago-cell">
                  <img
                    src={logo.src}
                    alt={i < logosCarrusel.length ? logo.alt : ''}
                    class:list={[
                      'medios-pago-logo',
                      logo.shape === 'round' && 'medios-pago-logo--round',
                      logo.shape === 'square' && 'medios-pago-logo--square',
                    ]}
                    loading="lazy"
                    decoding="async"
                    height="56"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <div class:list={['pago-confianza', className]} role="note">
      <div class="pago-confianza-fila">
        <span class="pago-confianza-label">Paga con:</span>
        <div class="pago-confianza-logos">
          {filaTarjetas.map((m) => (
            <span class="pago-confianza-chip">
              <img src={m.src} alt={m.alt} class="pago-confianza-logo" width={size * 1.7} height={size} loading="lazy" decoding="async" />
            </span>
          ))}
        </div>
      </div>
      <div class="pago-confianza-fila">
        <span class="pago-confianza-label pago-confianza-label--spacer" aria-hidden="true"></span>
        <div class="pago-confianza-logos">
          {filaMedios.map((m) => (
            <span class:list={['pago-confianza-chip', m.shape === 'round' && 'pago-confianza-chip--round']}>
              <img
                src={m.src}
                alt={m.alt}
                class:list={['pago-confianza-logo', m.shape === 'round' && 'pago-confianza-logo--round']}
                width={size}
                height={size}
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
      </div>
      <div class="pago-confianza-fila">
        <span class="pago-confianza-label">Mediante:</span>
        <div class="pago-confianza-logos">
          {filaPlataformas.map((p) => (
            <span class:list={['pago-confianza-chip', p.shape === 'square' && 'pago-confianza-chip--square']}>
              <img
                src={p.src}
                alt={p.alt}
                class:list={['pago-confianza-logo', p.shape === 'square' && 'pago-confianza-logo--square']}
                width={p.shape === 'square' ? size : size * 1.6}
                height={size}
                loading="lazy"
                decoding="async"
              />
            </span>
          ))}
        </div>
      </div>
    </div>
  )
}

<style is:global>
  /* ——— Ficha / modal (sin cambios de layout) ——— */
  .pago-confianza {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0.85rem 0 0;
    padding: 0.85rem 0.9rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #e8eaef;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .pago-confianza-fila {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    min-width: 0;
  }

  .pago-confianza-label {
    flex: 0 0 auto;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #344054;
    white-space: nowrap;
    min-width: 5.4rem;
  }

  .pago-confianza-label--spacer {
    visibility: hidden;
  }

  .pago-confianza-logos {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }

  .pago-confianza-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    height: 42px;
    min-width: 64px;
    padding: 0 0.55rem;
    border-radius: 10px;
    background: #f9fafb;
    border: 1px solid #eaecf0;
    box-sizing: border-box;
  }

  .pago-confianza-chip--round,
  .pago-confianza-chip--square {
    min-width: 42px;
    width: 42px;
    padding: 0.2rem;
  }

  .pago-confianza-logo {
    display: block;
    height: 26px;
    width: auto;
    max-width: 86px;
    object-fit: contain;
  }

  .pago-confianza-logo--round {
    height: 34px;
    width: 34px;
    max-width: 34px;
    border-radius: 50%;
  }

  .pago-confianza-logo--square {
    height: 32px;
    width: 32px;
    max-width: 32px;
    border-radius: 6px;
    object-fit: cover;
  }

  .pago-confianza--modal {
    margin-top: 0.75rem;
  }

  /* ——— Carrusel inicio / tienda ——— */
  .medios-pago-section {
    width: 100%;
    padding: 1.75rem 0 1.9rem;
    background: #f7f4f8;
    border-top: 1px solid #ebe4ef;
    border-bottom: 1px solid #ebe4ef;
  }

  .medios-pago-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .medios-pago-heading {
    margin: 0 0 0.85rem;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b7280;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .medios-pago-carousel {
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #ebe4ef;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .medios-pago-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    padding: 1rem 0.85rem;
    animation: medios-pago-scroll 32s linear infinite;
  }

  .medios-pago-carousel:hover .medios-pago-track {
    animation-play-state: paused;
  }

  @keyframes medios-pago-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .medios-pago-item {
    flex: 0 0 auto;
  }

  .medios-pago-cell {
    width: 126px;
    height: 94px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 0.8rem;
    border-radius: 14px;
    background: #fafafa;
    border: 1px solid #f0f1f3;
    box-sizing: border-box;
  }

  .medios-pago-logo {
    display: block;
    width: auto;
    height: auto;
    max-width: 100px;
    max-height: 56px;
    object-fit: contain;
  }

  .medios-pago-logo--round {
    max-width: 60px;
    max-height: 60px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
  }

  .medios-pago-logo--square {
    max-width: 54px;
    max-height: 54px;
    width: 54px;
    height: 54px;
    border-radius: 10px;
    object-fit: cover;
  }

  /* Sobre fondo morado de tienda */
  .pago-confianza-section--tienda.medios-pago-section,
  .medios-pago-section.pago-confianza-section--tienda {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 16px;
    border: none;
    margin: 0 auto 2rem;
    max-width: 1100px;
    width: calc(100% - 2rem);
    box-shadow: 0 10px 30px rgba(40, 10, 55, 0.18);
    padding: 1.65rem 1rem 1.75rem;
  }

  .pago-confianza-section--tienda .medios-pago-carousel,
  .medios-pago-section.pago-confianza-section--tienda .medios-pago-carousel {
    border-color: #ebe4ef;
  }

  .pago-confianza-section--tienda .medios-pago-cell,
  .medios-pago-section.pago-confianza-section--tienda .medios-pago-cell {
    width: 132px;
    height: 98px;
  }

  .pago-confianza-section--tienda .medios-pago-logo,
  .medios-pago-section.pago-confianza-section--tienda .medios-pago-logo {
    max-width: 104px;
    max-height: 58px;
  }

  .pago-confianza-section--tienda .medios-pago-logo--round,
  .medios-pago-section.pago-confianza-section--tienda .medios-pago-logo--round {
    width: 62px;
    height: 62px;
    max-width: 62px;
    max-height: 62px;
  }

  .pago-confianza-section--tienda .medios-pago-logo--square,
  .medios-pago-section.pago-confianza-section--tienda .medios-pago-logo--square {
    width: 56px;
    height: 56px;
    max-width: 56px;
    max-height: 56px;
  }

  .pago-confianza-section--tienda .medios-pago-heading,
  .medios-pago-section.pago-confianza-section--tienda .medios-pago-heading {
    color: #6b2181;
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .medios-pago-cell {
      width: 100px;
      height: 78px;
      padding: 0.5rem;
    }

    .medios-pago-logo {
      max-width: 78px;
      max-height: 44px;
    }

    .medios-pago-logo--round {
      width: 46px;
      height: 46px;
      max-width: 46px;
      max-height: 46px;
    }

    .medios-pago-logo--square {
      width: 44px;
      height: 44px;
      max-width: 44px;
      max-height: 44px;
    }

    .pago-confianza-label {
      min-width: 4.6rem;
      font-size: 0.74rem;
    }

    .pago-confianza-chip {
      height: 38px;
      min-width: 56px;
    }

    .pago-confianza-logo {
      height: 22px;
      max-width: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .medios-pago-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }
  }
</style>
