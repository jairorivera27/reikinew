    border-radius: 6px;
    border: 1px solid #e5e7eb;
    flex-shrink: 0;
  }

  .product-details {
    flex: 1;
    min-width: 0;
  }

  .product-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.4;
    margin-bottom: 0.25rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
