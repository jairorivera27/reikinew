    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .cart-col-qty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .qty-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .qty-btn-small {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    width: 32px;
    height: 32px;
    border-radius: 6px;
