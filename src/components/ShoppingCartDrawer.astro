  .product-brand {
    font-size: 0.85rem;
    color: #6b7280;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .cart-col-price,
  .cart-col-subtotal {
    display: flex;
    justify-content: center;
