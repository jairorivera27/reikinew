---
import { getCollection } from 'astro:content';

const productos = await getCollection('productos');
const productosOrdenados = productos.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const productosJSON = JSON.stringify(
  productosOrdenados.map((p) => ({
    id: p.slug,
    title: p.data.title,
    description: p.data.description,
    price: p.data.price,
    image: p.data.image,
    brand: p.data.brand || '',
    model: p.data.model || '',
    stock: p.data.stock || 'disponible',
    specifications: p.data.specifications || [],
  }))
);
---

<div id="cart-sidebar-backdrop" class="cart-sidebar-backdrop" aria-hidden="true"></div>

<!-- Carrito lateral (único drawer: localStorage 'reiki_cart') -->
<div id="cart-sidebar" class="cart-sidebar">
  <div class="cart-header">
    <h2 class="cart-title">
      <i class="fas fa-shopping-cart"></i>
      Carrito de Compras
    </h2>
    <button type="button" class="cart-close" id="cart-close" aria-label="Cerrar carrito">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <div class="cart-content">
    <div class="order-details-section">
      <div class="section-header">
        <div class="section-number cart-icon">🛒</div>
        <h3 class="section-title">Detalles del pedido</h3>
      </div>

      <div id="cart-items" class="cart-items-table">
        <div class="cart-empty">
          <i class="fas fa-shopping-cart"></i>
          <p>Tu carrito está vacío</p>
        </div>
      </div>
    </div>

    <div class="order-summary" id="order-summary" style="display: none;">
      <div class="summary-row">
        <span>Subtotal gravado:</span>
        <span id="cart-subtotal-gravado">$0</span>
      </div>
      <div class="summary-row">
        <span>Subtotal exento:</span>
        <span id="cart-subtotal-exento">$0</span>
      </div>
      <div class="summary-row">
        <span>IVA:</span>
        <span id="cart-iva">$0</span>
      </div>
      <div class="summary-row total-row">
        <span>Total:</span>
        <span id="cart-total" class="cart-total">$0</span>
      </div>
    </div>
  </div>

  <div class="cart-footer">
    <button type="button" class="cart-checkout-btn" id="checkout-btn" disabled>
      <i class="fas fa-lock" aria-hidden="true"></i>
      Finalizar Compra Segura
    </button>
    <div class="cart-footer-hint">
      <a href="/tienda">Seguir navegando en la tienda</a>
    </div>
  </div>
</div>

<div id="cart-toast" class="cart-toast" role="status" aria-live="polite" aria-atomic="true" aria-hidden="true"></div>

<script define:vars={{ productosJSON }}>
  const CART_STORAGE_KEY = 'reiki_cart';

  let cart = [];
  const productos = JSON.parse(productosJSON);

  function dispatchCartBadge() {
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { totalItems } }));
  }

  function saveCartToStorage() {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
    dispatchCartBadge();
  }

  function loadCartFromStorage() {
    const savedCart = localStorage.getItem(CART_STORAGE_KEY);
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (_e) {
        cart = [];
      }
    }
  }

  function extractPrice(priceString) {
    const cleaned = priceString.replace(/[^0-9]/g, '');
    return parseInt(cleaned, 10) || 0;
  }

  function formatPrice(price) {
    return new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      minimumFractionDigits: 0,
    }).format(price);
  }

  function escHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  }

  function showCartToast(productName) {
    const safeName = typeof productName === 'string' && productName.trim() ? productName.trim() : 'Producto';
    const msg = `\u2705 ${safeName} agregado al carrito`;

    const el = document.getElementById('cart-toast');
    if (!(el instanceof HTMLElement)) return;

    el.textContent = msg;
    el.classList.add('cart-toast-visible');
    el.setAttribute('aria-hidden', 'false');

    window.clearTimeout(/** @type {unknown} */ (showCartToast)._t);
    /** @type {{ _t?: number }} */ (showCartToast)._t = window.setTimeout(() => {
      el.classList.remove('cart-toast-visible');
      el.setAttribute('aria-hidden', 'true');
    }, 3600);
  }

  function openCartSidebar() {
    const sidebar = document.getElementById('cart-sidebar');
    const bd = document.getElementById('cart-sidebar-backdrop');
    if (sidebar instanceof HTMLElement) sidebar.classList.add('open');
    if (bd instanceof HTMLElement) {
      bd.classList.add('is-visible');
      bd.setAttribute('aria-hidden', 'false');
    }
    document.documentElement.classList.add('cart-drawer-open');
  }

  function closeCartSidebar() {
    const sidebar = document.getElementById('cart-sidebar');
    const bd = document.getElementById('cart-sidebar-backdrop');
    if (sidebar instanceof HTMLElement) sidebar.classList.remove('open');
    if (bd instanceof HTMLElement) {
      bd.classList.remove('is-visible');
      bd.setAttribute('aria-hidden', 'true');
    }
    document.documentElement.classList.remove('cart-drawer-open');
  }

  /** Exponer para el botón flotante si hace falta */
  window.openReikiShoppingCartDrawer = openCartSidebar;
  window.closeReikiShoppingCartDrawer = closeCartSidebar;

  function updateCartUI() {
    const cartItems = document.getElementById('cart-items');
    const cartTotalEl = document.getElementById('cart-total');
    const checkoutBtn = document.getElementById('checkout-btn');

    if (!cartItems || !checkoutBtn) return;

    dispatchCartBadge();

    if (cart.length === 0) {
      cartItems.innerHTML = `
        <div class="cart-empty">
          <i class="fas fa-shopping-cart"></i>
          <p>Tu carrito está vacío</p>
        </div>
      `;
      checkoutBtn.disabled = true;
      const os = document.getElementById('order-summary');
      if (os) os.style.display = 'none';
    } else {
      const osEl = document.getElementById('order-summary');
      if (osEl) osEl.style.display = 'block';

      cartItems.innerHTML = `
        <div class="cart-table-header">
          <div class="cart-col-product">Nombre del producto</div>
          <div class="cart-col-price">Precio</div>
          <div class="cart-col-qty">Cantidad</div>
          <div class="cart-col-subtotal">Subtotal</div>
        </div>
        ${cart
          .map((item, index) => {
            const itemTotal = extractPrice(item.price) * item.quantity;
            return `
            <div class="cart-table-row">
              <div class="cart-col-product">
                <div class="product-info">
                  <img src="${String(item.image).replace(/"/g, '&quot;')}" alt="${escHtml(item.title)}" class="product-image-small">
                  <div class="product-details">
                    <div class="product-name">${escHtml(item.title)}</div>
                    ${item.brand ? `<div class="product-brand">${escHtml(item.brand)}</div>` : ''}
                  </div>
                </div>
              </div>
              <div class="cart-col-price">
                <div class="price-box">${item.price}</div>
              </div>
              <div class="cart-col-qty">
                <div class="qty-controls">
                  <button type="button" onclick="window.updateCartQuantity(${index}, -1)" class="qty-btn-small">-</button>
                  <input type="number" value="${item.quantity}" min="1" readonly class="qty-input-small">
                  <button type="button" onclick="window.updateCartQuantity(${index}, 1)" class="qty-btn-small">+</button>
                </div>
                <button type="button" class="remove-item-btn" onclick="window.removeFromCart(${index})" title="Eliminar">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="cart-col-subtotal">
                <div class="subtotal-box">${formatPrice(itemTotal)}</div>
              </div>
            </div>
          `;
          })
          .join('')}
      `;
      checkoutBtn.disabled = false;
    }

    const subtotal = cart.reduce((sum, item) => {
      return sum + extractPrice(item.price) * item.quantity;
    }, 0);

    const subtotalGravado = subtotal / 1.19;
    const iva = subtotalGravado * 0.19;
    const subtotalExento = 0;
    const total = subtotal;

    const gravadoEl = document.getElementById('cart-subtotal-gravado');
    const exentoEl = document.getElementById('cart-subtotal-exento');
    const ivaEl = document.getElementById('cart-iva');
    if (gravadoEl) gravadoEl.textContent = formatPrice(subtotalGravado);
    if (exentoEl) exentoEl.textContent = formatPrice(subtotalExento);
    if (ivaEl) ivaEl.textContent = formatPrice(iva);
    if (cartTotalEl) cartTotalEl.textContent = formatPrice(total);
  }

  function addToCart(productId, quantity = 1, showToastFlag = true) {
    const producto = productos.find((p) => p.id === productId);
    if (!producto) return;

    const existingItem = cart.find((item) => item.id === productId);
    if (existingItem) {
      existingItem.quantity += quantity;
    } else {
      cart.push({
        id: producto.id,
        title: producto.title,
        description: producto.description || '',
        price: producto.price,
        image: producto.image,
        brand: producto.brand,
        model: producto.model,
        quantity,
      });
    }

    saveCartToStorage();
    updateCartUI();
    if (showToastFlag !== false && producto.title) {
      showCartToast(producto.title);
    }
  }

  window.updateCartQuantity = function (index, change) {
    if (!cart[index]) return;
    cart[index].quantity += change;
    if (cart[index].quantity <= 0) {
      cart.splice(index, 1);
    }
    saveCartToStorage();
    updateCartUI();
  };

  window.removeFromCart = function (index) {
    cart.splice(index, 1);
    saveCartToStorage();
    updateCartUI();
  };

  /** Misma pestaña: /carrito u otros pantallas pueden actualizar localStorage sin evento storage */
  window.addEventListener('reiki-cart-storage-changed', () => {
    loadCartFromStorage();
    updateCartUI();
  });

  document.addEventListener('DOMContentLoaded', () => {
    loadCartFromStorage();
    updateCartUI();

    const closeBtn = document.getElementById('cart-close');
    const backdrop = document.getElementById('cart-sidebar-backdrop');
    const checkoutBtn = document.getElementById('checkout-btn');

    if (closeBtn) closeBtn.addEventListener('click', closeCartSidebar);
    if (backdrop instanceof HTMLElement) {
      backdrop.addEventListener('click', closeCartSidebar);
    }

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      const sidebar = document.getElementById('cart-sidebar');
      if (sidebar && sidebar.classList.contains('open')) {
        closeCartSidebar();
      }
    });

    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function () {
        if (checkoutBtn.disabled) return;
        window.location.assign('/carrito');
      });
    }
  });

  document.addEventListener('reiki-cart-open', () => openCartSidebar());

  document.addEventListener('click', function (e) {
    const btn = e.target instanceof Element ? e.target.closest('.add-to-cart') : null;
    if (!(btn instanceof HTMLElement)) return;
    if (!btn.dataset.productId) return;

    let controls = btn.closest('.producto-actions');
    if (!controls) controls = btn.parentElement?.closest('.product-card') || null;

    let qtyWrap = controls ? controls.querySelector('.quantity-controls') : null;
    if (!qtyWrap) qtyWrap = document.getElementById('producto-modal-quantity');

    let qty = 1;
    const qi = qtyWrap && qtyWrap.querySelector('.qty-input');
    if (qi instanceof HTMLInputElement) qty = parseInt(qi.value, 10) || 1;

    addToCart(btn.dataset.productId, qty, true);

    const resetQi = qtyWrap?.querySelector('.qty-input');
    if (resetQi instanceof HTMLInputElement) resetQi.value = '1';
  });
</script>

<style is:global>
  html.cart-drawer-open {
    overflow: hidden;
  }

  .cart-sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
