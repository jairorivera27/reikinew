---
/**
 * Puente editorial home: entidad SEO + dos caminos de conversión.
 */
import { ORG } from '../config/organization';
---

<section class="home-bridge" aria-labelledby="home-bridge-heading">
  <div class="home-bridge-glow" aria-hidden="true"></div>
  <div class="home-bridge-inner">
    <div class="home-bridge-copy">
      <p class="home-bridge-eyebrow">
        <span class="home-bridge-eyebrow-dot" aria-hidden="true"></span>
        Energía solar en {ORG.addressLocality} y Colombia
      </p>
      <h2 id="home-bridge-heading">
        Elige cómo avanzar:<br class="home-bridge-break" />
        tienda o proyecto completo
      </h2>
      <p class="home-bridge-lead">
        En <strong>{ORG.name}</strong> trabajamos de dos maneras. Si ya tienes instalador, compras paneles,
        inversores y baterías con precio publicado. Si necesitas el sistema de punta a punta, diseñamos,
        suministramos e instalamos tu proyecto fotovoltaico en Medellín, Antioquia y el resto del país.
      </p>
      <ul class="home-bridge-chips" aria-label="Datos de la empresa">
        <li>{ORG.legalName}</li>
        <li>Sede en {ORG.addressLocality}</li>
        <li>Cobertura nacional</li>
      </ul>
    </div>

    <div class="home-bridge-paths" role="list">
      <a class="home-bridge-path" href="/tienda" role="listitem">
        <span class="home-bridge-path-top">
          <span class="home-bridge-path-icon" aria-hidden="true">
            <i class="fas fa-store"></i>
          </span>
          <span class="home-bridge-path-num">01</span>
        </span>
        <span class="home-bridge-path-kicker">Ya tienes instalador</span>
        <span class="home-bridge-path-title">Compra en la tienda</span>
        <span class="home-bridge-path-text">
          Equipos solares con tarifa publicada y envío a todo el país.
        </span>
        <span class="home-bridge-path-cta">
          Ver equipos
          <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </span>
      </a>

      <a class="home-bridge-path home-bridge-path--accent" href="/contacto" role="listitem">
        <span class="home-bridge-path-top">
          <span class="home-bridge-path-icon" aria-hidden="true">
            <i class="fas fa-solar-panel"></i>
          </span>
          <span class="home-bridge-path-num">02</span>
        </span>
        <span class="home-bridge-path-kicker">Necesitas el sistema completo</span>
        <span class="home-bridge-path-title">Proyecto llave en mano</span>
        <span class="home-bridge-path-text">
          Diseño, suministro, instalación y puesta en marcha con un solo equipo.
        </span>
        <span class="home-bridge-path-cta">
          Solicitar cotización
          <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-bridge {
    position: relative;
    isolation: isolate;
    padding: 3.25rem 1.25rem 3.5rem;
    background:
      linear-gradient(180deg, #f4eef7 0%, #faf8fb 38%, #ffffff 100%);
    border-bottom: 1px solid #ebe4ef;
    overflow: hidden;
  }

  .home-bridge-glow {
    position: absolute;
    top: -18%;
    right: -8%;
    width: min(420px, 48vw);
    height: min(420px, 48vw);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 40%, rgba(139, 42, 155, 0.16), transparent 52%),
      radial-gradient(circle at 70% 70%, rgba(107, 33, 129, 0.1), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .home-bridge-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 2.5rem 3.25rem;
    align-items: start;
  }

  .home-bridge-copy {
    position: relative;
    padding-left: 1.15rem;
  }

  .home-bridge-copy::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15rem;
    bottom: 0.15rem;
    width: 3px;
    border-radius: 999px;
    background: linear-gradient(180deg, #8b2a9b 0%, #6b2181 55%, rgba(107, 33, 129, 0.25) 100%);
  }

  .home-bridge-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #8b2a9b;
  }

  .home-bridge-eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8b2a9b;
    box-shadow: 0 0 0 4px rgba(139, 42, 155, 0.16);
  }

  .home-bridge-copy h2 {
    margin: 0 0 1rem;
    color: #2a0a36;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .home-bridge-break {
    display: none;
  }

  @media (min-width: 520px) {
    .home-bridge-break {
      display: block;
    }
  }

  .home-bridge-lead {
    margin: 0 0 1.15rem;
    color: #3f4653;
    font-size: 1.06rem;
    line-height: 1.65;
    max-width: 36rem;
  }

  .home-bridge-lead strong {
    color: #2a0a36;
  }

  .home-bridge-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .home-bridge-chips li {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid #e5dceb;
    color: #4b5563;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .home-bridge-paths {
    display: grid;
    gap: 0.95rem;
  }

  .home-bridge-path {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 1.25rem 1.3rem 1.3rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid #e8e0ee;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 10px 28px rgba(59, 15, 74, 0.07);
    text-decoration: none;
    color: inherit;
    backdrop-filter: blur(6px);
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }

  .home-bridge-path:hover,
  .home-bridge-path:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(107, 33, 129, 0.38);
    box-shadow: 0 18px 40px rgba(59, 15, 74, 0.14);
    outline: none;
  }

  .home-bridge-path--accent {
    background: linear-gradient(145deg, #5a1a6e 0%, #6b2181 42%, #8b2a9b 100%);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 14px 34px rgba(107, 33, 129, 0.32);
  }

  .home-bridge-path--accent:hover,
  .home-bridge-path--accent:focus-visible {
    box-shadow: 0 20px 44px rgba(107, 33, 129, 0.42);
  }

  .home-bridge-path-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 0.55rem;
  }

  .home-bridge-path-icon {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f4eef7;
    color: #6b2181;
    font-size: 0.95rem;
  }

  .home-bridge-path--accent .home-bridge-path-icon {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .home-bridge-path-num {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #c4b5cf;
  }

  .home-bridge-path--accent .home-bridge-path-num {
    color: rgba(255, 255, 255, 0.45);
  }

  .home-bridge-path-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8b2a9b;
  }

  .home-bridge-path--accent .home-bridge-path-kicker {
    color: rgba(255, 255, 255, 0.78);
  }

  .home-bridge-path-title {
    font-size: 1.22rem;
    font-weight: 800;
    color: #2a0a36;
    letter-spacing: -0.02em;
  }

  .home-bridge-path--accent .home-bridge-path-title {
    color: #fff;
  }

  .home-bridge-path-text {
    font-size: 0.93rem;
    line-height: 1.5;
    color: #4b5563;
  }

  .home-bridge-path--accent .home-bridge-path-text {
    color: rgba(255, 255, 255, 0.88);
  }

  .home-bridge-path-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.55rem;
    padding: 0.45rem 0.85rem 0.45rem 0.95rem;
    border-radius: 999px;
    background: #f4eef7;
    font-size: 0.88rem;
    font-weight: 700;
    color: #6b2181;
  }

  .home-bridge-path--accent .home-bridge-path-cta {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .home-bridge-path-cta i {
    font-size: 0.75rem;
    transition: transform 0.2s ease;
  }

  .home-bridge-path:hover .home-bridge-path-cta i,
  .home-bridge-path:focus-visible .home-bridge-path-cta i {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-bridge-path,
    .home-bridge-path-cta i {
      transition: none;
    }

    .home-bridge-path:hover,
    .home-bridge-path:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .home-bridge-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .home-bridge {
      padding: 2.5rem 1.1rem 2.75rem;
    }

    .home-bridge-glow {
      top: auto;
      bottom: -20%;
      right: -18%;
      width: min(280px, 70vw);
      height: min(280px, 70vw);
      opacity: 0.65;
    }
  }
</style>
