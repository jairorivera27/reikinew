---
import { getCollection } from 'astro:content';
import ProductoCardCompact from './tienda/ProductoCardCompact.astro';
import { buildDifferentiator, buildSeoKeywords } from '../utils/productSeo';

// Obtener todos los productos ordenados
const productos = await getCollection('productos');
const productosOrdenados = productos.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Filtrar por categoría
const paneles = productosOrdenados.filter(p => p.data.category === 'paneles');
const inversores = productosOrdenados.filter(p => p.data.category === 'inversores');
const baterias = productosOrdenados.filter(p => p.data.category === 'baterias');
const reflectores = productosOrdenados.filter(p => p.data.category === 'reflectores');
const controladores = productosOrdenados.filter(p => p.data.category === 'controladores');
const protecciones = productosOrdenados.filter(p => p.data.category === 'protecciones');
const cargadores = productosOrdenados.filter(p => p.data.category === 'cargadores');

// Convertir productos a JSON para JavaScript
const productosJSON = JSON.stringify(productosOrdenados.map(p => ({
  id: p.slug,
  category: p.data.category,
  title: p.data.title,
  description: p.data.description,
  price: p.data.price,
  image: p.data.image,
  brand: p.data.brand || '',
  model: p.data.model || '',
  stock: p.data.stock || 'disponible',
  specifications: p.data.specifications || [],
  seoKeywords:
    p.data.seoKeywords && p.data.seoKeywords.length > 0
      ? p.data.seoKeywords
      : buildSeoKeywords({
          title: p.data.title,
          brand: p.data.brand,
          model: p.data.model,
          category: p.data.category,
          specifications: p.data.specifications,
        }),
  seoDifferentiator:
    p.data.seoDifferentiator ||
    buildDifferentiator({
      title: p.data.title,
      brand: p.data.brand,
      model: p.data.model,
      category: p.data.category,
      specifications: p.data.specifications,
    }),
})));

