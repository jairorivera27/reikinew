---
const MARCAS = [
  { nombre: 'LONGi', src: '/images/marcas/longi.png' },
  { nombre: 'JA Solar', src: '/images/marcas/ja-solar.png' },
  { nombre: 'Jinko', src: '/images/marcas/jinko.png' },
  { nombre: 'Astroenergy', src: '/images/marcas/astroenergy.png' },
  { nombre: 'Huawei', src: '/images/marcas/huawei.png' },
  { nombre: 'Victron', src: '/images/marcas/victron.png' },
  { nombre: 'Growatt', src: '/images/marcas/growatt.png' },
  { nombre: 'GoodWe', src: '/images/marcas/goodwe.png' },
  { nombre: 'Deye', src: '/images/marcas/deye.png' },
  { nombre: 'Fronius', src: '/images/marcas/fronius.png' },
  { nombre: 'Solis', src: '/images/marcas/solis.png' },
  { nombre: 'Hoymiles', src: '/images/marcas/hoymiles.png' },
  { nombre: 'Pylontech', src: '/images/marcas/pylontech.png' },
  { nombre: 'Suntree', src: '/images/marcas/suntree.png' },
  { nombre: 'Tensite', src: '/images/marcas/tensite.png' },
  { nombre: 'Connera', src: '/images/marcas/connera.png' },
];

const marcasLoop = [...MARCAS, ...MARCAS];

const trustItems = [
  {
    label: 'Llave en mano real',
    detail: 'Diseño, suministro, instalación y legalización: un solo equipo responsable de tu proyecto.',
  },
  {
    label: 'Precio transparente',
    detail: 'Tienda mayorista con tarifas publicadas en paneles, inversores, baterías y protecciones.',
  },
  {
    label: 'Marcas que sí rinden',
    detail: 'Huawei, Victron, Growatt, LONGi, Jinko y más: equipos de marca con soporte comercial.',
  },
  {
    label: 'Normativa y cobertura',
    detail: 'Proyectos alineados a Ley 1715 y CREG 174, con operación desde Medellín hacia toda Colombia.',
  },
];
---

<section class="home-trust" aria-label="Marcas y confianza">
  <div class="home-trust-inner">
    <ul class="trust-row">
      {trustItems.map((item) => (
        <li class="trust-item">
          <span class="trust-label">{item.label}</span>
          <span class="trust-detail">{item.detail}</span>
        </li>
      ))}
    </ul>

    <div class="marcas-strip" aria-label="Marcas que distribuimos">
      <p class="marcas-strip-label">Nuestras marcas Aliadas</p>
      <div class="marcas-strip-wrap">
        <div class="marcas-strip-track">
          {marcasLoop.map((marca, i) => (
            <div class="marcas-strip-item">
              <div class="marcas-strip-cell">
                <img
                  src={marca.src}
                  alt={i < MARCAS.length ? `Logo ${marca.nombre}` : ''}
                  loading="lazy"
                  decoding="async"
                  class="marcas-strip-logo"
                />
              </div>
              <span class="marcas-strip-name">{marca.nombre}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-trust {
    background: #f7f4f8;
    border-bottom: 1px solid #ebe4ef;
    padding: 1.5rem 0 1.75rem;
    overflow-x: clip;
  }

  .home-trust-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .trust-row {
    list-style: none;
    margin: 0 0 1.35rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .trust-item {
    background: #fff;
    border: 1px solid #ebe4ef;
    border-radius: 12px;
    padding: 1rem 1.05rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 100%;
  }

  .trust-label {
    font-size: 0.98rem;
    font-weight: 800;
    color: #6b2181;
    letter-spacing: -0.01em;
  }

  .trust-detail {
    font-size: 0.84rem;
    color: #4b5563;
    line-height: 1.45;
  }

  .marcas-strip-label {
    margin: 0 0 0.65rem;
    text-align: center;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b2181;
  }

  .marcas-strip-wrap {
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    border-radius: 14px;
    background: #fff;
    border: 1px solid #ebe4ef;
    contain: paint;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marcas-strip-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    padding: 0.9rem;
    animation: home-marcas-scroll 42s linear infinite;
  }

  .marcas-strip-wrap:hover .marcas-strip-track {
    animation-play-state: paused;
  }

  @keyframes home-marcas-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .marcas-strip-item {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: 128px;
  }

  .marcas-strip-cell {
    width: 128px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.75rem;
    border-radius: 12px;
    background: #fafafa;
    border: 1px solid #f0f1f3;
    box-sizing: border-box;
  }

  .marcas-strip-logo {
    height: auto;
    width: auto;
    max-width: 108px;
    max-height: 52px;
    object-fit: contain;
  }

  .marcas-strip-name {
    font-size: 0.7rem;
    font-weight: 600;
    color: #4b5563;
  }

  @media (max-width: 900px) {
    .trust-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .trust-row {
      grid-template-columns: 1fr;
    }

    .marcas-strip-item,
    .marcas-strip-cell {
      width: 112px;
    }

    .marcas-strip-cell {
      height: 76px;
    }

    .marcas-strip-logo {
      max-width: 92px;
      max-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marcas-strip-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }
  }
</style>
